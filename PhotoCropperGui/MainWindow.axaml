<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		WindowState="Maximized"
        x:Class="PhotoCropperGui.MainWindow"
		KeyDown="Window_KeyDown"
		Background="Gray"
        Title="PhotoCropperGui">
	<StackPanel Orientation="Vertical">
		<StackPanel Orientation="Horizontal" Margin="5" Spacing="10">
			<Button x:Name="btnOpenFiles" Click="BtnOpenFiles_Click" Content="OpenFile"></Button>
			<Button x:Name="btnSave" Content="SaveImages" Click="BtnSaveImages_Click"></Button>
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
				<TextBlock Text="Detection Sensitivity:" VerticalAlignment="Center"/>
				<Slider x:Name="sldSensitivity" Minimum="0" Maximum="100" Value="50" Width="150" 
						PointerReleased="SldSensitivity_PointerReleased"/>
				<TextBlock Text="{Binding #sldSensitivity.Value, StringFormat='{}{0:0}%'}" VerticalAlignment="Center"/>
			</StackPanel>
		</StackPanel>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*"/>
				<ColumnDefinition Width="3*"/>
			</Grid.ColumnDefinitions>
			<Image x:Name="img" Grid.Column="0" Stretch="Uniform" Margin="10"/>
			<Panel Grid.Column="1" Height="600">
				<Carousel x:Name="slides" >
					<Carousel.PageTransition >
						<CompositePageTransition>
							<PageSlide Orientation="Horizontal" />
						</CompositePageTransition>
					</Carousel.PageTransition>
					<Carousel.ItemTemplate>
						<DataTemplate>
							<Image  Stretch="Uniform" Margin="2,2,2,2" Source="{Binding}"/>
						</DataTemplate>
					</Carousel.ItemTemplate>
				</Carousel>
				<Panel>
					<Button Background="White" Click="BtnPreviousCroppedImage_Click" Content="&lt;" />
					<Button Background="White" Click="BtnNextCroppedImage_Click"
							HorizontalAlignment="Right" Content="&gt;"/>
				</Panel>
			</Panel>
		</Grid>
	</StackPanel>

</Window>
