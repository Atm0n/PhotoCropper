<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Emgu.CV" Version="5.0.0.6584" />
    <PackageVersion Include="Emgu.CV.Bitmap" Version="5.0.0.6584" />
    <PackageVersion Include="Emgu.CV.runtime.ubuntu-24.04-x64" Version="5.0.0.6584" />
    <PackageVersion Include="Emgu.CV.runtime.windows" Version="5.0.0.6584" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="NAPS2.Sdk" Version="1.6.1" />
    <PackageVersion Include="NAPS2.Images.ImageSharp" Version="1.6.1" />
    <!-- Pin SixLabors.ImageSharp to 4.1.3 to remediate transitive CVEs in 3.1.11 pulled by NAPS2.Images.ImageSharp. Remove this pin once NAPS2 releases an update with a patched ImageSharp dependency. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageVersion Include="System.Drawing.Common" Version="11.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>