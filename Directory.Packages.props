<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Code coverage for the Microsoft Testing Platform runner (the coverage option of dotnet test) -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="OpenCvSharp5" Version="5.1.0.20261125" />
    <PackageVersion Include="OpenCvSharp5.runtime.win" Version="5.1.0.20261125" />
    <!-- Portable Linux build (glibc 2.28+): only libc/libstdc++ from the system; "headless" keeps dnn (YuNet) but no GTK. -->
    <PackageVersion Include="OpenCvSharp5.official.runtime.linux-x64.headless" Version="5.1.0.20261125" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.156.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageVersion Include="NAPS2.Sdk" Version="1.6.1" />
    <PackageVersion Include="NAPS2.Images.Skia" Version="1.6.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>