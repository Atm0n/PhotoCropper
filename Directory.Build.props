<Project>
  <PropertyGroup>
    <Version>3.3.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-All</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA2007;CA1305;CA1707;CA1031;NETSDK1206</NoWarn>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- Publish size. Libraries' own translations are kept only for the app's languages (Assets/i18n: add new ones here too),
       and a single-file exe is compressed (it was ~3x bigger without it). -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en;es;ca</SatelliteResourceLanguages>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- OpenCV's ffmpeg plugin (~40 MB) only serves VideoCapture/VideoWriter, which the app never uses;
       OpenCV loads it lazily, so image reading and the dnn face model work without it. -->
  <Target Name="DropUnusedNativeLibrariesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveSymbolsAndDocFromPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_PublishSymbolsToDelete Include="$(PublishDir)**\*.pdb" />
      <_PublishSymbolsToDelete Include="$(PublishDir)**\*.xml" />
      <_PublishSymbolsToDelete Include="$(PublishDir)**\*.dbg" />
    </ItemGroup>
    <Delete Files="@(_PublishSymbolsToDelete)" TreatErrorsAsWarnings="true" />
  </Target>
</Project>
