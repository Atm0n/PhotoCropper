	<sys:String x:Key="TipTokenDate">Insert formatted date {date}</sys:String>
	<sys:String x:Key="TipTokenTotal">Insert total photo count {total}</sys:String>
	<sys:String x:Key="HelpNamingTitle">File Naming Helper</sys:String>
	<sys:String x:Key="HelpNamingDesc">Customize output names using tokens like {original}, {index:02}, {year}, and {total} with live dynamic previews.</sys:String>
	<sys:String x:Key="HelpMetadataTitle">Vintage Photo Metadata (EXIF)</sys:String>
	<sys:String x:Key="HelpMetadataDesc">Tag scans with approximate capture year and notes; embeds standard EXIF tags so photo managers index them chronologically.</sys:String>
	<sys:String x:Key="TitleExportSettings">Save &amp; Export Settings</sys:String>
	<sys:String x:Key="DescExportSettings">Configure output format, file naming, destination folder, and metadata before saving.</sys:String>
	<sys:String x:Key="TipSaveSettings">Configure export folder, format, naming pattern and metadata</sys:String>
