	<sys:String x:Key="LblWarmth">Warmth</sys:String>
	<sys:String x:Key="LblTint">Tint</sys:String>
	<sys:String x:Key="LblSaturation">Saturation</sys:String>
	<sys:String x:Key="BtnRepairBrush">🖌 Repair brush</sys:String>
	<sys:String x:Key="TipRepairBrush">Paint over scratches, creases, tears or stains: they are filled in from their surroundings</sys:String>
	<sys:String x:Key="LblBrushSize">Size</sys:String>
	<sys:String x:Key="BtnUndoStroke">Undo stroke</sys:String>
	<sys:String x:Key="BtnClearRepairs">Clear repairs</sys:String>
	<sys:String x:Key="LblRepairHint">Paint over the damage</sys:String>
	<sys:String x:Key="MsgRepairsOutdated">This photo's repairs were painted on an earlier crop of a different size, so they are not applied. Painting a new stroke replaces them; Clear repairs removes them.</sys:String>
	<sys:String x:Key="LblFillMethod">Fill:</sys:String>
	<sys:String x:Key="OptQuickFill">Quick</sys:String>
	<sys:String x:Key="TipQuickFill">Blends the surroundings into the painted area. Instant; best for scratches, creases and small stains.</sys:String>
	<sys:String x:Key="OptAiFill">AI</sys:String>
	<sys:String x:Key="TipAiFill">Generates new content that continues the surroundings (edges, walls, sky, grass). A few seconds per area; best for large damage and torn corners. Not suited to faces or text: it invents details. Runs on this computer.</sys:String>
	<sys:String x:Key="LblAiLoading">Loading the AI model…</sys:String>
	<sys:String x:Key="MsgAiDownload">AI fill needs a one-time download of the LaMa model (208 MB). It runs on this computer: your photos are never uploaded.</sys:String>
	<sys:String x:Key="BtnDownloadAiModel">Download (208 MB)</sys:String>
	<sys:String x:Key="BtnCancelDownload">Cancel</sys:String>
	<sys:String x:Key="BtnBackToGrid">◀ All photos</sys:String>
	<sys:String x:Key="TipBackToGrid">Back to all photos (Esc)</sys:String>
	<sys:String x:Key="TipPreviousPhoto">Previous photo (←)</sys:String>
	<sys:String x:Key="TipNextPhoto">Next photo (→)</sys:String>
	<sys:String x:Key="BtnZoomFit">Fit</sys:String>
	<sys:String x:Key="TipViewerControls">Mouse wheel: zoom · drag: move the photo · drag the divider: compare before and after · hold Space: show the original · F: fit · B: repair brush</sys:String>
	<sys:String x:Key="MsgReprocessing">Reprocessing scan with new settings...</sys:String>
	<sys:String x:Key="MsgDetectingPhotos">Detecting photos...</sys:String>
