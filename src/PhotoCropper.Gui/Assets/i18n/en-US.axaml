	<sys:String x:Key="BtnCopySettingsToAll">Copy settings to all</sys:String>
	<sys:String x:Key="LblBorder">Border</sys:String>
	<sys:String x:Key="LblTrimBorders">Trim white border</sys:String>
	<sys:String x:Key="TipTrimBorders">Leaves out the print's white or cream border in the final photo, keeping only the picture. The preview shades what will be cut. Photos without a clear border are left as they are; the cropped photo always keeps the whole print.</sys:String>
	<sys:String x:Key="BtnAdjustTrim">Adjust</sys:String>
	<sys:String x:Key="TipAdjustTrim">Drag the edges of the frame on the photo (a corner moves two at once) to set exactly what the final photo keeps. Zoom in for precision; a magnifier shows the edge while you drag.</sys:String>
	<sys:String x:Key="BtnAutoTrim">Automatic</sys:String>
	<sys:String x:Key="TipAutoTrim">Forget the frame set by hand and find the border automatically again.</sys:String>
	<sys:String x:Key="TipBulkToggle">Ticked: every selected photo has it. Dash: only some do. Click to turn it on for all of them, or off when all have it.</sys:String>
	<sys:String x:Key="LblStyleAll">All</sys:String>
	<sys:String x:Key="StyleBlackAndWhite">Black &amp; white</sys:String>
	<sys:String x:Key="StyleSepia">Sepia</sys:String>
	<sys:String x:Key="StyleFadedColor">Faded colour</sys:String>
	<sys:String x:Key="StyleColor">Colour</sys:String>
	<sys:String x:Key="BtnSuggestedPresets">Suggested by type</sys:String>
	<sys:String x:Key="TipSuggestedPresets">Gives each selected photo the preset that suits its kind of print: Black &amp; white for black-and-white prints, Sepia for sepia ones, Faded colour print for faded colour, and Only clean dust for colour photos in good shape.</sys:String>
	<sys:String x:Key="TipStyleFilter">Show only the photos of one type. Black and white, sepia, faded colour (one colour cast dominates) and colour are told apart from the photos themselves; check them before applying a preset.</sys:String>
	<sys:String x:Key="LblSortingStyles">Sorting photos by type...</sys:String>
	<sys:String x:Key="BtnExportMarked">Export selected</sys:String>
	<sys:String x:Key="LblMarkedCount">{0} selected</sys:String>
	<sys:String x:Key="TipMarkPhoto">Select this photo for the bulk actions (or Ctrl+click it; Shift+click selects a range)</sys:String>
	<sys:String x:Key="TipMarkAll">Select every photo for the bulk actions</sys:String>
	<sys:String x:Key="BtnCopySettingsToMarked">Copy settings to selected</sys:String>
	<sys:String x:Key="TipCopySettingsToMarked">Gives the selected photos this photo's settings (repairs are not copied)</sys:String>
	<sys:String x:Key="TipFinishGrid">Click a photo to edit it; Ctrl+click or Shift+click to select several and change them together</sys:String>
	<sys:String x:Key="TipCopySettingsToAll">Give every photo the restoration settings of the selected photo</sys:String>
