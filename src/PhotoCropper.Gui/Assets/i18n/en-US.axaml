<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<sys:String x:Key="BtnOpenScans">Open</sys:String>
	<sys:String x:Key="BtnSaveResults">Save</sys:String>
	<sys:String x:Key="LblDetectionSensitivity">Sensitivity</sys:String>
	<sys:String x:Key="LblZoom">Zoom</sys:String>
	<sys:String x:Key="BtnAdvanced">Advanced</sys:String>
	<sys:String x:Key="LblMinPhotoSize">Min Photo Size</sys:String>
	<sys:String x:Key="LblMaxPhotoSize">Max Photo Size</sys:String>
	<sys:String x:Key="LblEdgeThreshold">Edge Threshold</sys:String>
	<sys:String x:Key="LblAutoOrient">Auto-Orient (AI / Landscape)</sys:String>
	<sys:String x:Key="TipAutoOrient">Automatically straightens and orients photos upright using AI face detection and outdoor landscape/water scene cues.</sys:String>
	<sys:String x:Key="LblRestoreColors">Restore Vintage Colors</sys:String>
	<sys:String x:Key="TipRestoreColors">Neutralizes aging yellow casts, recovers shadow/highlight contrast via LAB CLAHE, and revives faded photo pigments.</sys:String>
	<sys:String x:Key="LblRemoveDust">Remove Dust &amp; Scratches</sys:String>
	<sys:String x:Key="TipRemoveDust">Automated inpainting of hairline scratches, dust specks, and fibers.</sys:String>
	<sys:String x:Key="TxtNoFiles">No files loaded</sys:String>
	<sys:String x:Key="HeaderOriginal">ORIGINAL SCAN (CLICK &amp; DRAG TO MANUALLY CROP)</sys:String>
	<sys:String x:Key="HeaderDetected">DETECTED PHOTOS</sys:String>
	<sys:String x:Key="ViewCarousel">Single</sys:String>
	<sys:String x:Key="ViewGrid">Grid</sys:String>
	<sys:String x:Key="TipViewCarousel">Single photo inspection view (Shortcut: 1)</sys:String>
	<sys:String x:Key="TipViewGrid">Grid gallery overview of all detected photos (Shortcut: 2)</sys:String>
	<sys:String x:Key="BtnDelete">Delete</sys:String>
	<sys:String x:Key="BtnRotate">Rotate 90°</sys:String>
	<sys:String x:Key="BtnRefine">Refine Edges</sys:String>
	<sys:String x:Key="BtnAccept">Accept (Enter)</sys:String>
	<sys:String x:Key="BtnReject">Reject (Backspace)</sys:String>
	<sys:String x:Key="StatusReady">Ready</sys:String>
	<sys:String x:Key="StatusShortcuts">Shortcuts: [↑/↓] Switch Scan | [←/→] Navigate Photos | [T] Auto-Tune | [R] Rotate | [Space] Compare Original | [Ctrl+Z/Y] Undo/Redo</sys:String>
	<sys:String x:Key="MsgUndo">Undid {0}.</sys:String>
	<sys:String x:Key="MsgRedo">Redid {0}.</sys:String>
	<sys:String x:Key="PhotoCounter">PHOTO {0} OF {1}</sys:String>
	<sys:String x:Key="ScanCounter">Scan {0} of {1}</sys:String>
	<sys:String x:Key="ProcessingScan">Processing Scan...</sys:String>
	<sys:String x:Key="MsgSavingProgress">Exporting photo {0} of {1}...</sys:String>
	<sys:String x:Key="MsgSaved">Successfully saved {0} photos to 'cropped' folders.</sys:String>
	<sys:String x:Key="MsgReprocessing">Reprocessing scan with new settings...</sys:String>
	<sys:String x:Key="MsgDetectionComplete">Detection complete. Found {0} photos.</sys:String>
	<sys:String x:Key="MsgPhotoDeleted">Photo deleted.</sys:String>
	<sys:String x:Key="MsgRotating">Rotating photo...</sys:String>
	<sys:String x:Key="MsgPhotoRotated">Photo rotated.</sys:String>
	<sys:String x:Key="MsgExtractingCrop">Extracting manual crop...</sys:String>
	<sys:String x:Key="MsgManualCropAdded">Manual crop added.</sys:String>
	<sys:String x:Key="MsgRefineModeHelp">Refinement mode: Draw to manual crop, Enter to Accept, Backspace to Reject.</sys:String>
	<sys:String x:Key="MsgApplyingRefine">Applying refinement...</sys:String>
	<sys:String x:Key="MsgRefineSuccess">Crop refined successfully.</sys:String>
	<sys:String x:Key="MsgRefineCancelled">Refinement cancelled.</sys:String>
	<sys:String x:Key="MenuLanguage">Language</sys:String>
	<sys:String x:Key="BtnHelp">Help</sys:String>
	<sys:String x:Key="BtnClose">Close</sys:String>
	<sys:String x:Key="HeaderHelp">Controls &amp; Shortcuts</sys:String>
	<sys:String x:Key="HelpOpenScans">Load multiple images or scans at once from your computer.</sys:String>
	<sys:String x:Key="HelpSaveResults">Saves all currently detected and refined photos into a 'cropped' subfolder next to each original scan.</sys:String>
	<sys:String x:Key="HelpSensitivity">Adjust how aggressively the engine looks for photo boundaries. Higher values find more faint borders but may include noise.</sys:String>
	<sys:String x:Key="HelpManualCrop">Click and drag on the original scan (left) to manually define a photo area if it wasn't detected automatically.</sys:String>
	<sys:String x:Key="HelpRefine">Enter a specialized mode to fine-tune a photo's edges. Ideal for removing white scanner margins or correcting slight misalignments.</sys:String>
	<sys:String x:Key="HelpDragDropTitle">Drag &amp; Drop</sys:String>
	<sys:String x:Key="HelpDragDrop">Drag image files or whole folders anywhere onto the window to automatically queue and process scans.</sys:String>
	<sys:String x:Key="HelpDpiTitle">DPI Preservation</sys:String>
	<sys:String x:Key="HelpDpi">Original scanner resolution metadata (e.g. 300/600 DPI) is automatically detected and preserved on export for 1:1 physical printing scale.</sys:String>
	<sys:String x:Key="HelpAutoOrientTitle">AI &amp; Landscape Orientation</sys:String>
	<sys:String x:Key="HelpAutoOrientDesc">Uses an embedded neural network (YuNet) to detect facial orientation, backed by landscape/water scene analysis, to orient extracted photos upright.</sys:String>
	<sys:String x:Key="HelpRestoreColorsTitle">Vintage Color Restoration</sys:String>
	<sys:String x:Key="HelpRestoreColorsDesc">Corrects aged yellowing/sepia casts via damped gray-world balancing, recovers contrast with LAB CLAHE, and enhances faded pigments.</sys:String>
	<sys:String x:Key="HelpRemoveDustTitle">Dust &amp; Scratch Inpainting</sys:String>
	<sys:String x:Key="HelpRemoveDustDesc">Detects scanner dust specks, lint fibers, and hairline scratches using morphological filters and repairs them using OpenCV inpainting.</sys:String>
	<sys:String x:Key="HelpAutoTuneTitle">⚡ Detection Auto-Tune</sys:String>
	<sys:String x:Key="HelpAutoTuneDesc">Automatically sweeps background tolerance, edge thresholds, and size parameters to discover difficult or faint photos without touching sliders.</sys:String>
	<sys:String x:Key="HelpShortcutsTitle">Keyboard Shortcuts</sys:String>
	<sys:String x:Key="HelpShortcutScan">[F5] Scan from flatbed</sys:String>
	<sys:String x:Key="HelpShortcutAutoTune">[T] Auto-tune active scan</sys:String>
	<sys:String x:Key="HelpShortcutRotate">[R] Rotate photo 90°</sys:String>
	<sys:String x:Key="HelpShortcutDelete">[X] or [Delete] Discard photo</sys:String>
	<sys:String x:Key="HelpShortcutNextScan">[PageUp / PageDown] or [↑ / ↓] Switch scans</sys:String>
	<sys:String x:Key="HelpShortcutNextPhoto">[Left / Right] Navigate photos</sys:String>
	<sys:String x:Key="HelpShortcutCompare">[Space] Hold to compare raw scan</sys:String>
	<sys:String x:Key="HelpShortcutRefine">[N] or [Ñ] Refine edges</sys:String>
	<sys:String x:Key="HelpShortcutToggleView">[1 / 2] Switch Single / Grid View</sys:String>
	<sys:String x:Key="HelpShortcutUndo">[Ctrl+Z] Undo last edit</sys:String>
	<sys:String x:Key="HelpShortcutRedo">[Ctrl+Y] Redo edit</sys:String>
	<sys:String x:Key="HelpShortcutSave">[Ctrl+S] Save all results</sys:String>
	<sys:String x:Key="HelpShortcutClose">[ESC] Close overlay</sys:String>
	<sys:String x:Key="TipRefine">Shortcut: N</sys:String>
	<sys:String x:Key="HelpAboutTitle">About PhotoCropper</sys:String>
	<sys:String x:Key="HelpAboutDescription">High-performance intelligent photo extractor. Designed for fast and precise digitization of old photo albums.</sys:String>
	<sys:String x:Key="HelpVersion">Version 2.1.0</sys:String>
	<sys:String x:Key="HelpAuthor">Developed by Nil Riera</sys:String>
	<sys:String x:Key="HelpPoweredBy">Powered by Emgu.CV (OpenCV wrapper)</sys:String>
	<sys:String x:Key="HelpModelLicense">AI Face Detection: YuNet by Shiqi Yu / OpenCV Zoo (Apache 2.0)</sys:String>
	<sys:String x:Key="HelpCopyright">© 2026 Nil Riera. Licensed under GPLv3.</sys:String>
	<sys:String x:Key="BtnReset">Reset Defaults</sys:String>
	<sys:String x:Key="LblFormat">Output Format</sys:String>
	<sys:String x:Key="LblQuality">JPEG Quality</sys:String>
	<sys:String x:Key="LblOutputDir">Export Folder</sys:String>
	<sys:String x:Key="WatermarkSameDir">Same as original folder (cropped/)</sys:String>
	<sys:String x:Key="TipClearDir">Reset to original folder</sys:String>
	<sys:String x:Key="BtnSampleBackground">Sample Background</sys:String>
	<sys:String x:Key="BtnResetBackground">Auto Background</sys:String>
	<sys:String x:Key="MsgClickToSample">Click anywhere on the background of the scan to sample its color...</sys:String>
	<sys:String x:Key="BtnAutoTune">Auto-Tune</sys:String>
	<sys:String x:Key="TipAutoTune">Automatically search for optimal detection parameters for this scan. (Shortcut: T)</sys:String>
	<sys:String x:Key="MsgAutoTuning">Auto-tuning detection parameters...</sys:String>
	<sys:String x:Key="MsgAutoTuneSuccess">Auto-tuned: found {0} photos (Tolerance: {1:0}, Edge: {2:0}).</sys:String>
	<sys:String x:Key="MsgAutoTuneFailed">Auto-tune did not find additional photos.</sys:String>
	<sys:String x:Key="BtnScan">Scan</sys:String>
	<sys:String x:Key="TipScan">Acquire scan from flatbed scanner (Shortcut: F5)</sys:String>
	<sys:String x:Key="BtnWorkDir">Folder</sys:String>
	<sys:String x:Key="TipWorkDir">Select a work directory for automatic raw scan staging and session recovery</sys:String>
	<sys:String x:Key="MsgScanning">Scanning image from {0}...</sys:String>
	<sys:String x:Key="MsgScanSuccess">Scan acquired and saved to workspace: {0}</sys:String>
	<sys:String x:Key="MsgNoScannerFound">No scanner detected. Please make sure your scanner is turned on and connected.</sys:String>
	<sys:String x:Key="MsgScanFailed">Scanning failed: {0}</sys:String>
	<sys:String x:Key="MsgResumeSession">A previous scanning session was detected in this folder ({0} scans). Would you like to resume it?</sys:String>
	<sys:String x:Key="TitleResumeSession">Resume Scanning Session</sys:String>
	<sys:String x:Key="LblWorkDirStatus">Work Folder: {0}</sys:String>
	<sys:String x:Key="LblNoWorkDir">No Work Folder</sys:String>
	<sys:String x:Key="BtnDeleteScan">Delete Scan</sys:String>
	<sys:String x:Key="TipDeleteScan">Delete this entire scan from workspace and disk (Shortcut: Shift+Delete)</sys:String>
	<sys:String x:Key="MsgScanDeleted">Scan '{0}' deleted.</sys:String>
	<sys:String x:Key="HelpShortcutDeleteScan">[Shift+Delete] Delete entire scan</sys:String>
	<sys:String x:Key="BtnCancel">Cancel</sys:String>
	<sys:String x:Key="BtnOk">OK</sys:String>
	<sys:String x:Key="BtnRefreshScanners">Refresh Scanners</sys:String>
	<sys:String x:Key="TitleNoScanner">No Scanner Detected</sys:String>
	<sys:String x:Key="MsgNoScannerDetails">No scanner was detected on your system.&#x0a;&#x0a;• Check that your scanner is plugged in and powered on.&#x0a;• Verify the USB cable or Wi-Fi network connection.&#x0a;• Ensure scanner drivers (WIA, TWAIN, or SANE) are installed.&#x0a;• Click 'Refresh Scanners' to detect connected hardware.</sys:String>
	<sys:String x:Key="TitleScannerNotFound">Scanner Not Found</sys:String>
	<sys:String x:Key="MsgScannerNotFoundDetails">{0}&#x0a;&#x0a;• Verify your scanner is powered on and connected.&#x0a;• Make sure no other application is using the scanner.&#x0a;• Reconnect the scanner and click 'Refresh Scanners'.</sys:String>
	<sys:String x:Key="TitleScannerError">Scanner Communication Error</sys:String>
	<sys:String x:Key="MsgScannerErrorDetails">Failed to communicate with scanner '{0}':&#x0a;&#x0a;{1}&#x0a;&#x0a;Troubleshooting:&#x0a;• Check scanner power and USB/network cables.&#x0a;• Verify scanner driver status in your operating system.&#x0a;• Restart the scanner and click 'Refresh Scanners'.</sys:String>
	<sys:String x:Key="MsgScanCancelled">Scanning was cancelled or timed out.</sys:String>
	<sys:String x:Key="LblNetworkScanners">Search Network (Wi-Fi / eSCL)</sys:String>
	<sys:String x:Key="TipNetworkScanners">Probes the local network for wireless scanners via Apple AirScan / eSCL (may prompt Windows Firewall permission).</sys:String>
	<sys:String x:Key="LblNoProject">No Project</sys:String>
	<sys:String x:Key="LblProjectFormat">Project: {0}</sys:String>
	<sys:String x:Key="TipActiveProject">Active Project: {0}&#x0a;Path: {1}&#x0a;&#x0a;Click to switch project or work directory.</sys:String>
</ResourceDictionary>
