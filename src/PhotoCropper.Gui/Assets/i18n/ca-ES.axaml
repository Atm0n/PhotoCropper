<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<sys:String x:Key="BtnOpenScans">Obrir</sys:String>
	<sys:String x:Key="BtnSaveResults">Desar</sys:String>
	<sys:String x:Key="LblDetectionSensitivity">Sensibilitat</sys:String>
	<sys:String x:Key="LblZoom">Zoom</sys:String>
	<sys:String x:Key="BtnAdvanced">Avançat</sys:String>
	<sys:String x:Key="LblMinPhotoSize">Mida Mínima</sys:String>
	<sys:String x:Key="LblMaxPhotoSize">Mida Màxima</sys:String>
	<sys:String x:Key="LblEdgeThreshold">Llindar de Vores</sys:String>
	<sys:String x:Key="LblAutoOrient">Auto-Orientar (IA / Paisatge)</sys:String>
	<sys:String x:Key="TipAutoOrient">Endreça i orienta automàticament les fotos usant detecció facial per IA i anàlisi de paisatges/aigua.</sys:String>
	<sys:String x:Key="LblRestoreColors">Restaurar Color i Contrast</sys:String>
	<sys:String x:Key="TipRestoreColors">Neutralitza el grogueig per envelliment, recupera ombres i llums amb LAB CLAHE i reviu colors descolorits.</sys:String>
	<sys:String x:Key="LblRemoveDust">Eliminar Pols i Ratllades</sys:String>
	<sys:String x:Key="TipRemoveDust">Inpainting automàtic de ratllades fines, borrissol i partícules de pols de l'escàner.</sys:String>
	<sys:String x:Key="TxtNoFiles">Sense fitxers</sys:String>
	<sys:String x:Key="HeaderOriginal">ESCANEIG ORIGINAL (CLIC I ARROSSEGAR PER RETALLAR)</sys:String>
	<sys:String x:Key="HeaderDetected">FOTOS DETECTADES</sys:String>
	<sys:String x:Key="ViewCarousel">Individual</sys:String>
	<sys:String x:Key="ViewGrid">Graella</sys:String>
	<sys:String x:Key="TipViewCarousel">Vista individual de fotos (Drecera: 1)</sys:String>
	<sys:String x:Key="TipViewGrid">Vista en graella de totes les fotos (Drecera: 2)</sys:String>
	<sys:String x:Key="BtnDelete">Eliminar</sys:String>
	<sys:String x:Key="BtnRotate">Girar 90°</sys:String>
	<sys:String x:Key="BtnRefine">Ajustar Vores</sys:String>
	<sys:String x:Key="BtnAccept">Acceptar (Enter)</sys:String>
	<sys:String x:Key="BtnReject">Rebutjar (Retrocés)</sys:String>
	<sys:String x:Key="StatusReady">Llest</sys:String>
	<sys:String x:Key="StatusShortcuts">Dreceres: [↑/↓] Canviar Escaneig | [←/→] Navegar Fotos | [T] Auto-Ajustar | [R] Girar | [Espai] Comparar Original | [Ctrl+Z/Y] Desfer/Refer</sys:String>
	<sys:String x:Key="MsgUndo">Desfet: {0}.</sys:String>
	<sys:String x:Key="MsgRedo">Refet: {0}.</sys:String>
	<sys:String x:Key="PhotoCounter">FOTO {0} DE {1}</sys:String>
	<sys:String x:Key="ScanCounter">Escaneig {0} de {1}</sys:String>
	<sys:String x:Key="ProcessingScan">Processant...</sys:String>
	<sys:String x:Key="MsgSavingProgress">Exportant foto {0} de {1}...</sys:String>
	<sys:String x:Key="MsgSaved">S'han guardat {0} fotos correctament.</sys:String>
	<sys:String x:Key="MsgAllScansAlreadySaved">Tots els {0} escanejos ja estan guardats a 'Cropped'. No hi ha canvis per exportar.</sys:String>
	<sys:String x:Key="MsgReprocessing">Reprocessant amb nous ajustos...</sys:String>
	<sys:String x:Key="MsgDetectionComplete">Detecció finalitzada. Trobades {0} fotos.</sys:String>
	<sys:String x:Key="MsgPhotoDeleted">Foto esborrada.</sys:String>
	<sys:String x:Key="MsgRotating">Girant foto...</sys:String>
	<sys:String x:Key="MsgPhotoRotated">Foto girada.</sys:String>
	<sys:String x:Key="MsgExtractingCrop">Extraient retall manual...</sys:String>
	<sys:String x:Key="MsgManualCropAdded">Retall manual afegit.</sys:String>
	<sys:String x:Key="MsgRefineModeHelp">Modo ajust: Dibuixa per retallar, Enter per Acceptar, Retrocés per Cancel·lar.</sys:String>
	<sys:String x:Key="MsgApplyingRefine">Aplicant ajust...</sys:String>
	<sys:String x:Key="MsgRefineSuccess">Retall ajustat correctament.</sys:String>
	<sys:String x:Key="MsgRefineCancelled">Ajust cancel·lat.</sys:String>
	<sys:String x:Key="MenuLanguage">Idioma</sys:String>
	<sys:String x:Key="BtnHelp">Ajuda</sys:String>
	<sys:String x:Key="BtnClose">Tancar</sys:String>
	<sys:String x:Key="HeaderHelp">Controls i Dreceres</sys:String>
	<sys:String x:Key="HelpOpenScans">Carrega múltiples imatges o escanejos a la vegada des del teu ordinador.</sys:String>
	<sys:String x:Key="HelpSaveResults">Guarda totes les fotos detectades i ajustades en una subcarpeta 'cropped' al costat de cada escaneig original.</sys:String>
	<sys:String x:Key="HelpSensitivity">Ajusta l'agressivitat amb què el motor busca les vores de les fotos. Valors alts troben vores tènues però poden incloure soroll.</sys:String>
	<sys:String x:Key="HelpManualCrop">Fes clic i arrossega sobre l'escaneig original (esquerra) per definir manualment l'àrea d'una foto si no ha estat detectada.</sys:String>
	<sys:String x:Key="HelpRefine">Entra en un mode especialitzat per ajustar les vores d'una foto. Ideal per eliminar marges blancs de l'escàner.</sys:String>
	<sys:String x:Key="HelpDragDropTitle">Arrossegar i Deixar anar</sys:String>
	<sys:String x:Key="HelpDragDrop">Arrossega fitxers d'imatge o carpetes senceres a la finestra per posar a la cua i processar escanejos automàticament.</sys:String>
	<sys:String x:Key="HelpDpiTitle">Preservació de DPI</sys:String>
	<sys:String x:Key="HelpDpi">La resolució original de l'escàner (ex. 300/600 DPI) es detecta i preserva en exportar per mantenir l'escala física d'impressió 1:1.</sys:String>
	<sys:String x:Key="HelpAutoOrientTitle">Orientació IA i Paisatges</sys:String>
	<sys:String x:Key="HelpAutoOrientDesc">Utilitza una xarxa neuronal integrada (YuNet) per detectar l'orientació de cares i anàlisi de paisatges/aigua per redreçar fotos en vertical.</sys:String>
	<sys:String x:Key="HelpRestoreColorsTitle">Restauració de Color Vintage</sys:String>
	<sys:String x:Key="HelpRestoreColorsDesc">Corregeix el to groguenc/sèpia per envelliment, recupera contrast amb LAB CLAHE i realça pigments descolorits.</sys:String>
	<sys:String x:Key="HelpRemoveDustTitle">Eliminació de Pols i Ratllades</sys:String>
	<sys:String x:Key="HelpRemoveDustDesc">Detecta borrissol, pols i ratllades fines amb filtres morfològics i les repara amb inpainting d'OpenCV.</sys:String>
	<sys:String x:Key="HelpAutoTuneTitle">⚡ Auto-Ajust de Detecció</sys:String>
	<sys:String x:Key="HelpAutoTuneDesc">Realitza un escombrat automàtic de toleràncies, llindars de vora i mides mínimes per descobrir fotos difícils sense tocar els controls.</sys:String>
	<sys:String x:Key="HelpShortcutsTitle">Dreceres de Teclat</sys:String>
	<sys:String x:Key="HelpShortcutScan">[F5] Escanejar des de l'escàner</sys:String>
	<sys:String x:Key="HelpShortcutAutoTune">[T] Auto-ajustar escaneig actiu</sys:String>
	<sys:String x:Key="HelpShortcutRotate">[R] Girar foto 90°</sys:String>
	<sys:String x:Key="HelpShortcutDelete">[X] o [Supr] Descartar foto</sys:String>
	<sys:String x:Key="HelpShortcutNextScan">[Re Pàg / Av Pàg] o [↑ / ↓] Canviar escaneig</sys:String>
	<sys:String x:Key="HelpShortcutNextPhoto">[Esquerra / Dreta] Navegar fotos</sys:String>
	<sys:String x:Key="HelpShortcutCompare">[Espai] Mantenir per comparar original</sys:String>
	<sys:String x:Key="HelpShortcutRefine">[N] o [Ñ] Ajustar vores</sys:String>
	<sys:String x:Key="HelpShortcutToggleView">[1 / 2] Canviar Individual / Graella</sys:String>
	<sys:String x:Key="HelpShortcutUndo">[Ctrl+Z] Desfer últim canvi</sys:String>
	<sys:String x:Key="HelpShortcutRedo">[Ctrl+Y] Refer canvi</sys:String>
	<sys:String x:Key="HelpShortcutSave">[Ctrl+S] Guardar tots els resultats</sys:String>
	<sys:String x:Key="HelpShortcutClose">[ESC] Tancar finestra</sys:String>
	<sys:String x:Key="TipRefine">Drecera: N o Ñ</sys:String>
	<sys:String x:Key="HelpAboutTitle">Quant a PhotoCropper</sys:String>
	<sys:String x:Key="HelpAboutDescription">Extractor intel·ligent de fotos d'alt rendiment. Dissenyat per a una digitalització ràpida i precisa d'àlbums antics.</sys:String>
	<sys:String x:Key="HelpVersion">Versió 2.1.0</sys:String>
	<sys:String x:Key="HelpAuthor">Desenvolupat per Nil Riera</sys:String>
	<sys:String x:Key="HelpPoweredBy">Basat en Emgu.CV (wrapper d'OpenCV)</sys:String>
	<sys:String x:Key="HelpModelLicense">Detecció facial IA: YuNet per Shiqi Yu / OpenCV Zoo (Apache 2.0)</sys:String>
	<sys:String x:Key="HelpCopyright">© 2026 Nil Riera. Llicència GPLv3.</sys:String>
	<sys:String x:Key="BtnReset">Restablir valors</sys:String>
	<sys:String x:Key="LblFormat">Format de sortida</sys:String>
	<sys:String x:Key="LblQuality">Qualitat JPEG</sys:String>
	<sys:String x:Key="LblOutputDir">Carpeta de sortida</sys:String>
	<sys:String x:Key="WatermarkSameDir">El mateix que l'original (cropped/)</sys:String>
	<sys:String x:Key="TipClearDir">Restablir a la carpeta original</sys:String>
	<sys:String x:Key="BtnSampleBackground">Mostrejar Fons</sys:String>
	<sys:String x:Key="BtnResetBackground">Fons Automàtic</sys:String>
	<sys:String x:Key="MsgClickToSample">Faci clic a qualsevol part del fons de l'escaneig per mostrejar-ne el color...</sys:String>
	<sys:String x:Key="BtnAutoTune">Auto-Ajustar</sys:String>
	<sys:String x:Key="TipAutoTune">Cerca automàticament els paràmetres de detecció òptims per a aquest escaneig. (Drecera: T)</sys:String>
	<sys:String x:Key="MsgAutoTuning">Auto-ajustant paràmetres de detecció...</sys:String>
	<sys:String x:Key="MsgAutoTuneSuccess">Auto-ajustat: s'han trobat {0} fotos (Tolerància: {1:0}, Vora: {2:0}).</sys:String>
	<sys:String x:Key="MsgAutoTuneFailed">L'auto-ajust no ha trobat fotos addicionals.</sys:String>
	<sys:String x:Key="BtnScan">Escanejar</sys:String>
	<sys:String x:Key="TipScan">Adquirir escaneig des de l'escàner pla (Drecera: F5)</sys:String>
	<sys:String x:Key="BtnWorkDir">Carpeta</sys:String>
	<sys:String x:Key="TipWorkDir">Seleccionar una carpeta de treball per a emmagatzematge automàtic i recuperació de sessió</sys:String>
	<sys:String x:Key="MsgScanning">Escanejant imatge des de {0}...</sys:String>
	<sys:String x:Key="MsgScanSuccess">Escaneig adquirit i desat a l'espai de treball: {0}</sys:String>
	<sys:String x:Key="MsgNoScannerFound">No s'ha detectat cap escàner. Asseguri's que estigui encès i connectat.</sys:String>
	<sys:String x:Key="MsgScanFailed">Error en escanejar: {0}</sys:String>
	<sys:String x:Key="MsgResumeSession">S'ha detectat una sessió anterior en aquesta carpeta ({0} escanejos). Vol reprendre-la?</sys:String>
	<sys:String x:Key="TitleResumeSession">Reprendre Sessió d'Escaneig</sys:String>
	<sys:String x:Key="LblWorkDirStatus">Carpeta: {0}</sys:String>
	<sys:String x:Key="LblNoWorkDir">Sense Carpeta de Treball</sys:String>
	<sys:String x:Key="BtnDeleteScan">Eliminar Escaneig</sys:String>
	<sys:String x:Key="TipDeleteScan">Eliminar aquest escaneig sencer de l'espai de treball i disc (Drecera: Shift+Supr)</sys:String>
	<sys:String x:Key="MsgScanDeleted">Escaneig '{0}' eliminat.</sys:String>
	<sys:String x:Key="HelpShortcutDeleteScan">[Shift+Supr] Eliminar escaneig sencer</sys:String>
	<sys:String x:Key="BtnCancel">Cancel·lar</sys:String>
	<sys:String x:Key="BtnOk">D'acord</sys:String>
	<sys:String x:Key="BtnRefreshScanners">Actualitzar Escàners</sys:String>
	<sys:String x:Key="TitleNoScanner">No S'ha Detectat Cap Escàner</sys:String>
	<sys:String x:Key="MsgNoScannerDetails">No s'ha detectat cap escàner al vostre sistema.&#x0a;&#x0a;• Comproveu que l'escàner estigui encès i endollat.&#x0a;• Verifiqueu la connexió per cable USB o Wi-Fi.&#x0a;• Assegureu-vos de tenir instal·lats els controladors (WIA, TWAIN o SANE).&#x0a;• Feu clic a 'Actualitzar Escàners' per tornar a detectar.</sys:String>
	<sys:String x:Key="TitleScannerNotFound">Escàner No Trobat</sys:String>
	<sys:String x:Key="MsgScannerNotFoundDetails">{0}&#x0a;&#x0a;• Verifiqueu que l'escàner estigui encès i els cables ben connectats.&#x0a;• Assegureu-vos que cap altre programa estigui utilitzant l'escàner.&#x0a;• Reconnecteu l'escàner i feu clic a 'Actualitzar Escàners'.</sys:String>
	<sys:String x:Key="TitleScannerError">Error de Comunicació amb l'Escàner</sys:String>
	<sys:String x:Key="MsgScannerErrorDetails">Error al comunicar-se amb l'escàner '{0}':&#x0a;&#x0a;{1}&#x0a;&#x0a;Solució de problemes:&#x0a;• Comproveu l'alimentació i cables de l'escàner.&#x0a;• Verifiqueu l'estat del controlador al vostre sistema operatiu.&#x0a;• Reinicieu l'escàner i feu clic a 'Actualitzar Escàners'.</sys:String>
	<sys:String x:Key="MsgScanCancelled">L'escaneig s'ha cancel·lat o s'ha esgotat el temps d'espera.</sys:String>
	<sys:String x:Key="LblNetworkScanners">Cercar a la xarxa (Wi-Fi / eSCL)</sys:String>
	<sys:String x:Key="TipNetworkScanners">Cerca escàners sense fil a la xarxa local mitjançant Apple AirScan / eSCL (pot demanar permís del tallafoc).</sys:String>
	<sys:String x:Key="LblNoProject">Sense Projecte</sys:String>
	<sys:String x:Key="LblProjectFormat">Projecte: {0}</sys:String>
	<sys:String x:Key="TipActiveProject">Projecte actiu: {0}&#x0a;Ruta: {1}&#x0a;&#x0a;Feu clic per canviar de projecte o carpeta de treball.</sys:String>
	<sys:String x:Key="BtnNewProject">Nou Lot</sys:String>
	<sys:String x:Key="TipNewProject">Començar un nou projecte / lot de fotos en una carpeta separada</sys:String>
	<sys:String x:Key="MsgNewProjectReady">Projecte '{0}' a punt. Feu clic a Escanejar o Obrir Fitxers per començar.</sys:String>
