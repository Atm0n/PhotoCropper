<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<sys:String x:Key="BtnOpenScans">Obrir</sys:String>
	<sys:String x:Key="LblDetectionSensitivity">Sensibilitat</sys:String>
	<sys:String x:Key="LblZoom">Zoom</sys:String>
	<sys:String x:Key="LblMinPhotoSize">Mida Mínima</sys:String>
	<sys:String x:Key="LblMaxPhotoSize">Mida Màxima</sys:String>
	<sys:String x:Key="LblEdgeThreshold">Llindar de Vores</sys:String>
	<sys:String x:Key="LblAutoOrient">Auto-Orientar (IA / Paisatge)</sys:String>
	<sys:String x:Key="TipAutoOrient">Endreça i orienta automàticament les fotos usant detecció facial per IA i anàlisi de paisatges/aigua.</sys:String>
	<sys:String x:Key="LblRemoveDust">Eliminar Pols i Ratllades</sys:String>
	<sys:String x:Key="LblAutoTuneOnPass">Auto-Ajustar en canviar d'imatge</sys:String>
	<sys:String x:Key="TipAutoTuneOnPass">Executa automàticament l'Auto-Ajust de detecció cada vegada que canvia o carrega una imatge.</sys:String>
	<sys:String x:Key="LblAiDetection">Detecció amb IA (experimental)</sys:String>
	<sys:String x:Key="TipAiDetection">Cerca les fotos amb una xarxa entrenada en lloc de per color. Prem F5 per tornar a detectar una imatge amb ella; les imatges amb requadres desats els conserven fins aleshores.</sys:String>
	<sys:String x:Key="LblAutoAdjustOnLowCoverage">Auto-Ajustar si la detecció és &lt; 50%</sys:String>
	<sys:String x:Key="TipAutoAdjustOnLowCoverage">Executa automàticament l'Auto-Ajust si l'àrea de foto detectada cobreix menys del 50% del límit de l'escaneig.</sys:String>
	<sys:String x:Key="LblCoveragePercent">Cobertura: {0}%</sys:String>
	<sys:String x:Key="LblLookaheadPreloaded">⚡ Precarregat</sys:String>
	<sys:String x:Key="LblShowNotifications">Notificacions de Finalització</sys:String>
	<sys:String x:Key="TipShowNotifications">Mostra una notificació emergent a l'aplicació quan finalitza l'exportació de fotos.</sys:String>
	<sys:String x:Key="LblFlashTaskbar">Parpellejar Barra de Tasques</sys:String>
	<sys:String x:Key="TipFlashTaskbar">Fa parpellejar la icona de la barra de tasques a Windows en finalitzar l'exportació en segon pla.</sys:String>
	<sys:String x:Key="TxtNoFiles">Sense fitxers</sys:String>
	<sys:String x:Key="HeaderOriginal">ESCANEIG ORIGINAL (CLIC EN UNA FOTO PER TROBAR-LA, ARROSSEGA PER DIBUIXAR UN REQUADRE)</sys:String>
	<sys:String x:Key="HeaderDetected">FOTOS DETECTADES</sys:String>
	<sys:String x:Key="BtnDelete">Eliminar</sys:String>
	<sys:String x:Key="BtnRotate">Girar 90°</sys:String>
	<sys:String x:Key="BtnRefine">Ajustar Vores</sys:String>
	<sys:String x:Key="BtnReviewPhotos">Revisar Fotos</sys:String>
	<sys:String x:Key="TipReviewPhotos">Recorre totes les fotos a mida completa per girar-les o eliminar-les</sys:String>
	<sys:String x:Key="TitleReviewMode">Revisió i Gir Ràpid de Fotos</sys:String>
	<sys:String x:Key="MsgReviewEmpty">No hi ha fotos detectades per revisar a cap escaneig.</sys:String>
	<sys:String x:Key="ReviewSentinelTitle">Has donat la volta completa!</sys:String>
	<sys:String x:Key="ReviewSentinelSubtitle">Totes les fotos revisades — continua o tanca la revisió.</sys:String>
	<sys:String x:Key="ReviewSentinelStats">{0} fotos · {1} escaneigs · {2} girades · {3} eliminades</sys:String>
	<sys:String x:Key="BtnReviewGoToStart">↩ Torna a la Primera Foto</sys:String>
	<sys:String x:Key="TipToggleRightPanel">Alternar Panell de Fotos</sys:String>
	<sys:String x:Key="BtnAccept">Acceptar (Enter)</sys:String>
	<sys:String x:Key="BtnReject">Cancel·la (Esc)</sys:String>
	<sys:String x:Key="StatusReady">Llest</sys:String>
	<sys:String x:Key="MsgUndo">Desfet: {0}.</sys:String>
	<sys:String x:Key="MsgRedo">Refet: {0}.</sys:String>
	<sys:String x:Key="PhotoCounter">FOTO {0} DE {1}</sys:String>
	<sys:String x:Key="ScanCounter">Escaneig {0} de {1}</sys:String>
	<sys:String x:Key="ProcessingScan">Processant...</sys:String>
	<sys:String x:Key="TitleExportFailed">No s'han pogut exportar alguns escanejos</sys:String>
	<sys:String x:Key="MsgExportFailedStatus">S'han guardat {0} fotos; {1} no s'han pogut exportar.</sys:String>
	<sys:String x:Key="TitleUnexpectedError">Error inesperat</sys:String>
	<sys:String x:Key="MsgUnexpectedError">Alguna cosa ha fallat: {0}&#x0a;&#x0a;La teva feina continua oberta; et recomanem desar-la ara.&#x0a;S'ha desat un informe de l'error a:&#x0a;{1}</sys:String>
	<sys:String x:Key="StageScan">1  Escanejar</sys:String>
	<sys:String x:Key="StageCrops">2  Retalls</sys:String>
	<sys:String x:Key="StageFinish">3  Acabat</sys:String>
	<sys:String x:Key="StageScanStatus">{0} escanejos</sys:String>
	<sys:String x:Key="StageCropsStatus">{0} de {1} escanejos revisats</sys:String>
	<sys:String x:Key="StageFinishStatus">{0} fotos · {1} per exportar</sys:String>
	<sys:String x:Key="StageNeedsProject">Cal un projecte</sys:String>
	<sys:String x:Key="StartSubtitle">Digitalitza àlbums de fotos: escaneja, retalla i restaura</sys:String>
	<sys:String x:Key="BtnNewProject">Projecte nou</sys:String>
	<sys:String x:Key="TipNewProject">Comença un àlbum: escaneja pàgines, retalla les fotos i restaura-les.</sys:String>
	<sys:String x:Key="BtnOpenProject">Obre un projecte</sys:String>
	<sys:String x:Key="TipOpenProject">Continua una carpeta de projecte d'un altre lloc.</sys:String>
	<sys:String x:Key="BtnRestoreOnly">Només restaurar fotos</sys:String>
	<sys:String x:Key="TipRestoreOnly">Importa fotos que ja estan retallades i restaura-les, sense escanejar.</sys:String>
	<sys:String x:Key="LblProjectName">Nom</sys:String>
	<sys:String x:Key="LblProjectLocation">Ubicació</sys:String>
	<sys:String x:Key="BtnChangeLocation">Canvia…</sys:String>
	<sys:String x:Key="BtnCreateProject">Crea</sys:String>
	<sys:String x:Key="LblRecentProjects">Projectes recents</sys:String>
	<sys:String x:Key="LblNoRecentProjects">Encara no hi ha projectes recents.</sys:String>
	<sys:String x:Key="TipRemoveRecent">Treu-lo d'aquesta llista (la carpeta no s'esborra)</sys:String>
	<sys:String x:Key="BtnBackToProject">Torna a {0}</sys:String>
	<sys:String x:Key="LblProjectMissing">No s'ha trobat la carpeta</sys:String>
	<sys:String x:Key="LblRecentProjectDetails">{0} escanejos · {1} fotos acabades</sys:String>
	<sys:String x:Key="DefaultProjectName">Àlbum {0}</sys:String>
	<sys:String x:Key="MsgProjectNameInvalid">El nom d'un projecte no pot contenir \ / : * ? " &lt; &gt; |</sys:String>
	<sys:String x:Key="MsgProjectExists">Ja hi ha una carpeta anomenada '{0}' en aquesta ubicació. Tria un altre nom o fes servir Obre un projecte.</sys:String>
	<sys:String x:Key="MsgProjectCreateFailed">No s'ha pogut crear la carpeta del projecte: {0}</sys:String>
	<sys:String x:Key="MsgProjectInUse">'{0}' ja és obert en una altra finestra de PhotoCropper. Ves a aquella finestra o tanca-la abans: dues finestres desant el mateix projecte perdrien la feina de l'altra.</sys:String>
	<sys:String x:Key="BtnScanStage">🖨  Escanejar</sys:String>
	<sys:String x:Key="BtnImportScans">Importar escanejos…</sys:String>
	<sys:String x:Key="ScanStageEmpty">Encara no hi ha escanejos. Escaneja amb l'escàner o importa fitxers per començar.&#x0a;Fes doble clic en un escaneig per ajustar-ne els retalls.</sys:String>
	<sys:String x:Key="ScanStatusNotChecked">Sense revisar</sys:String>
	<sys:String x:Key="ScanPreviewDetecting">Cercant fotos…</sys:String>
	<sys:String x:Key="TipScanPreview">Fes doble clic per ajustar els retalls d'aquest escaneig</sys:String>
	<sys:String x:Key="ScanStatusNoPhotos">No s'han trobat fotos</sys:String>
	<sys:String x:Key="ScanStatusPhotos">{0} fotos</sys:String>
	<sys:String x:Key="BtnExportFinal">Exportar a Final</sys:String>
	<sys:String x:Key="BtnImportPhotos">Importar fotos…</sys:String>
	<sys:String x:Key="BtnOpenFinalFolder">Obrir la carpeta Final</sys:String>
	<sys:String x:Key="FinishNoProject">Obre o crea un projecte (directori de treball) per acabar les fotos.&#x0a;L'etapa d'acabat treballa amb les fotos de Cropped i les desa a Final.</sys:String>
	<sys:String x:Key="FinishEmpty">Encara no hi ha fotos retallades. Ajusta els retalls al pas 2 o importa fotos ja retallades.</sys:String>
	<sys:String x:Key="FinishSourceImported">Importada</sys:String>
	<sys:String x:Key="FinishStatusNew">Encara no exportada</sys:String>
	<sys:String x:Key="FinishStatusStale">Canviada des de l'exportació</sys:String>
	<sys:String x:Key="FinishStatusExported">Exportada</sys:String>
	<sys:String x:Key="MsgSavingCrops">Desant retalls ({0} de {1})...</sys:String>
	<sys:String x:Key="MsgCropsSaved">Retalls desats de {0} escanejos.</sys:String>
	<sys:String x:Key="MsgAutosaveFailed">No s'han pogut desar els canvis: {0}</sys:String>
	<sys:String x:Key="MsgExportingFinal">Exportant {0} fotos...</sys:String>
	<sys:String x:Key="MsgFinalExported">S'han exportat {0} fotos a Final.</sys:String>
	<sys:String x:Key="MsgImportingPhotos">Important {0} fotos...</sys:String>
	<sys:String x:Key="BtnAdjustCrops">Ajustar retalls</sys:String>
	<sys:String x:Key="BtnRescan">↻ Tornar a escanejar</sys:String>
	<sys:String x:Key="TipRescan">Escanejar aquesta pàgina de nou i substituir aquest escaneig pel nou</sys:String>
	<sys:String x:Key="BtnDiscardScan">Descartar</sys:String>
	<sys:String x:Key="BtnConfirmDiscard">Confirma el descart</sys:String>
	<sys:String x:Key="TipDiscardScan">Eliminar aquest escaneig i les seves fotos del projecte</sys:String>
	<sys:String x:Key="MsgScanReplaced">S'ha substituït '{0}' per un escaneig nou.</sys:String>
	<sys:String x:Key="LblBefore">Abans</sys:String>
	<sys:String x:Key="LblAfter">Després (tal com s'exportarà)</sys:String>
	<sys:String x:Key="LblUpdatingPreview">actualitzant…</sys:String>
	<sys:String x:Key="BtnCopySettingsToAll">Copiar els ajustos a totes</sys:String>
	<sys:String x:Key="LblBorder">Vora</sys:String>
	<sys:String x:Key="LblTrimBorders">Retallar la vora blanca</sys:String>
	<sys:String x:Key="TipTrimBorders">Deixa fora la vora blanca o crema de la còpia a la foto final i conserva només la imatge. La previsualització enfosqueix el que es retallarà. Les fotos sense una vora clara no canvien; la foto retallada sempre conserva la còpia sencera.</sys:String>
	<sys:String x:Key="BtnAdjustTrim">Ajustar</sys:String>
	<sys:String x:Key="TipAdjustTrim">Arrossega les vores del marc sobre la foto (una cantonada en mou dues alhora) per fixar exactament el que conserva la foto final. Amplia per a més precisió; una lupa mostra la vora mentre arrossegues.</sys:String>
	<sys:String x:Key="BtnAutoTrim">Automàtic</sys:String>
	<sys:String x:Key="TipAutoTrim">Oblida el marc fixat a mà i torna a buscar la vora automàticament.</sys:String>
	<sys:String x:Key="TipBulkToggle">Marcat: totes les fotos seleccionades ho tenen. Guionet: només algunes. Fes clic per activar-ho a totes, o desactivar-ho si ja ho tenen totes.</sys:String>
	<sys:String x:Key="LblStyleAll">Totes</sys:String>
	<sys:String x:Key="StyleBlackAndWhite">Blanc i negre</sys:String>
	<sys:String x:Key="StyleSepia">Sèpia</sys:String>
	<sys:String x:Key="StyleFadedColor">Color descolorit</sys:String>
	<sys:String x:Key="StyleColor">Color</sys:String>
	<sys:String x:Key="BtnSuggestedPresets">Suggerit per tipus</sys:String>
	<sys:String x:Key="TipSuggestedPresets">Dona a cada foto seleccionada l'ajust que millor li va: Blanc i negre per a còpies en blanc i negre, Sèpia per a les sèpia, Còpia en color descolorida per al color descolorit i Només netejar la pols per a fotos en color en bon estat.</sys:String>
	<sys:String x:Key="TipStyleFilter">Mostra només les fotos d'un tipus. Blanc i negre, sèpia, color descolorit (domina un to) i color es distingeixen a partir de les mateixes fotos; revisa-les abans d'aplicar un ajust.</sys:String>
	<sys:String x:Key="LblSortingStyles">Ordenant les fotos per tipus...</sys:String>
	<sys:String x:Key="BtnExportMarked">Exporta les seleccionades</sys:String>
	<sys:String x:Key="LblMarkedCount">{0} seleccionades</sys:String>
	<sys:String x:Key="TipMarkPhoto">Selecciona aquesta foto per a les accions en bloc (o Ctrl+clic; Maj+clic selecciona un interval)</sys:String>
	<sys:String x:Key="TipMarkAll">Selecciona totes les fotos per a les accions en bloc</sys:String>
	<sys:String x:Key="BtnCopySettingsToMarked">Copia els ajustos a les seleccionades</sys:String>
	<sys:String x:Key="TipCopySettingsToMarked">Dona a les fotos seleccionades els ajustos d'aquesta foto (les reparacions no es copien)</sys:String>
	<sys:String x:Key="TipFinishGrid">Fes clic en una foto per editar-la; Ctrl+clic o Maj+clic per seleccionar-ne diverses i canviar-les alhora</sys:String>
	<sys:String x:Key="TipCopySettingsToAll">Aplicar a totes les fotos els ajustos de restauració de la foto seleccionada</sys:String>
	<sys:String x:Key="LblAutoRestore">Restauració automàtica</sys:String>
	<sys:String x:Key="LblPresets">Preajustos</sys:String>
	<sys:String x:Key="PresetFaded">Còpia en color descolorida</sys:String>
	<sys:String x:Key="PresetBlackAndWhite">Blanc i negre</sys:String>
	<sys:String x:Key="PresetSepia">Sèpia</sys:String>
	<sys:String x:Key="PresetOnlyDust">Només netejar la pols</sys:String>
	<sys:String x:Key="PresetNone">Cap</sys:String>
	<sys:String x:Key="LblAutomatic">Automàtic</sys:String>
	<sys:String x:Key="StrengthGentle">Suau</sys:String>
	<sys:String x:Key="StrengthNormal">Normal</sys:String>
	<sys:String x:Key="StrengthStrong">Fort</sys:String>
	<sys:String x:Key="LblAutoWhiteBalance">Dominant de color</sys:String>
	<sys:String x:Key="LblAutoContrast">Contrast</sys:String>
	<sys:String x:Key="LblAutoSaturation">Colors apagats</sys:String>
	<sys:String x:Key="LblPhotoType">Tipus de foto</sys:String>
	<sys:String x:Key="ColorModeAuto">Detectar automàticament</sys:String>
	<sys:String x:Key="ColorModeColor">Color</sys:String>
	<sys:String x:Key="ColorModeKeepTone">Blanc i negre, conservar el to (sèpia)</sys:String>
	<sys:String x:Key="ColorModeNeutral">Blanc i negre, gris neutre</sys:String>
	<sys:String x:Key="LblAdjustments">Ajustos</sys:String>
	<sys:String x:Key="BtnResetAdjustments">Restablir</sys:String>
	<sys:String x:Key="LblBrightness">Brillantor</sys:String>
	<sys:String x:Key="LblContrast">Contrast</sys:String>
	<sys:String x:Key="LblWarmth">Calidesa</sys:String>
	<sys:String x:Key="LblTint">Tint</sys:String>
	<sys:String x:Key="LblSaturation">Saturació</sys:String>
	<sys:String x:Key="BtnRepairBrush">🖌 Pinzell de reparació</sys:String>
	<sys:String x:Key="TipRepairBrush">Pinta sobre ratllades, plecs, estrips o taques: s'omplen a partir del seu entorn</sys:String>
	<sys:String x:Key="LblBrushSize">Mida</sys:String>
	<sys:String x:Key="BtnUndoStroke">Desfer el traç</sys:String>
	<sys:String x:Key="BtnClearRepairs">Esborrar les reparacions</sys:String>
	<sys:String x:Key="LblRepairHint">Pinta sobre els danys</sys:String>
	<sys:String x:Key="MsgRepairsOutdated">Les reparacions d'aquesta foto es van pintar sobre un retall anterior d'una altra mida, així que no s'apliquen. En pintar un traç nou se substitueixen; Esborrar les reparacions les elimina.</sys:String>
	<sys:String x:Key="LblFillMethod">Farciment:</sys:String>
	<sys:String x:Key="OptQuickFill">Ràpid</sys:String>
	<sys:String x:Key="TipQuickFill">Barreja l'entorn a la zona pintada. Instantani; ideal per a ratllades, plecs i taques petites.</sys:String>
	<sys:String x:Key="OptAiFill">IA</sys:String>
	<sys:String x:Key="TipAiFill">Genera contingut nou que continua l'entorn (vores, parets, cel, herba). Uns segons per zona; ideal per a danys grans i cantonades estripades. No serveix per a cares ni text: s'inventa detalls. S'executa en aquest ordinador.</sys:String>
	<sys:String x:Key="LblAiLoading">Carregant el model d'IA…</sys:String>
	<sys:String x:Key="MsgAiDownload">El farciment amb IA necessita descarregar una sola vegada el model LaMa (208 MB). S'executa en aquest ordinador: les teves fotos no es pugen mai.</sys:String>
	<sys:String x:Key="BtnDownloadAiModel">Descarregar (208 MB)</sys:String>
	<sys:String x:Key="BtnCancelDownload">Cancel·lar</sys:String>
	<sys:String x:Key="BtnBackToGrid">◀ Totes les fotos</sys:String>
	<sys:String x:Key="TipBackToGrid">Tornar a totes les fotos (Esc)</sys:String>
	<sys:String x:Key="TipPreviousPhoto">Foto anterior (←)</sys:String>
	<sys:String x:Key="TipNextPhoto">Foto següent (→)</sys:String>
	<sys:String x:Key="BtnZoomFit">Ajustar</sys:String>
	<sys:String x:Key="TipViewerControls">Roda del ratolí: zoom · arrossegar: moure la foto · arrossegar el divisor: comparar abans i després · mantenir Espai: veure l'original · F: ajustar · B: pinzell de reparació</sys:String>
	<sys:String x:Key="MsgReprocessing">Reprocessant amb nous ajustos...</sys:String>
	<sys:String x:Key="MsgDetectingPhotos">Detectant fotos...</sys:String>
	<sys:String x:Key="MsgDetectionComplete">Detecció finalitzada. Trobades {0} fotos.</sys:String>
	<sys:String x:Key="MsgPhotoDeleted">Foto esborrada.</sys:String>
	<sys:String x:Key="MsgRotating">Girant foto...</sys:String>
	<sys:String x:Key="MsgPhotoRotated">Foto girada.</sys:String>
	<sys:String x:Key="MsgExtractingCrop">Extraient retall manual...</sys:String>
	<sys:String x:Key="MsgManualCropAdded">Retall manual afegit.</sys:String>
	<sys:String x:Key="MsgFindingPhoto">Cercant la foto...</sys:String>
	<sys:String x:Key="MsgNoPhotoFound">No s'ha trobat cap foto aquí. Fes clic més a prop del seu centre, o dibuixa-hi un requadre.</sys:String>
	<sys:String x:Key="MsgPhotoFound">Foto trobada i afegida.</sys:String>
	<sys:String x:Key="MsgPhotoRefitted">Requadre ajustat a la foto.</sys:String>
	<sys:String x:Key="MsgRefineModeHelp">Mode d'ajust: dibuixa per retallar a mà, Enter per acceptar, Esc per cancel·lar.</sys:String>
	<sys:String x:Key="MsgApplyingRefine">Aplicant ajust...</sys:String>
	<sys:String x:Key="MsgRefineSuccess">Retall ajustat correctament.</sys:String>
	<sys:String x:Key="MsgRefineCancelled">Ajust cancel·lat.</sys:String>
	<sys:String x:Key="MenuLanguage">Idioma</sys:String>
	<sys:String x:Key="BtnHelp">Ajuda</sys:String>
	<sys:String x:Key="BtnClose">Tancar</sys:String>
	<sys:String x:Key="HeaderHelp">Controls i Dreceres</sys:String>
	<sys:String x:Key="HelpSaveResults">No hi ha cap botó Desa: cada canvi es desa al projecte mentre el fas. En passar a l'etapa d'acabat, els retalls s'escriuen a Cropped/ com a PNG sense pèrdua, i Exporta a l'etapa d'acabat escriu les fotos acabades a Final/.</sys:String>
	<sys:String x:Key="HelpSensitivity">Amb quina intensitat es busquen les vores de les fotos. Un valor més alt troba vores més febles però pot captar soroll. La mida mínima i màxima i el llindar de vores són als controls d'ajust; la detecció es torna a fer quan deixes d'arrossegar.</sys:String>
	<sys:String x:Key="HelpManualCrop">Arrossega un rectangle sobre l'escaneig per afegir una foto que no s'hagi detectat. S'afegeix a la llista i queda seleccionada.</sys:String>
	<sys:String x:Key="HelpRefine">Dibuixa un retall més ajustat dins d'una foto, per exemple per treure un marge blanc de l'escàner. En acceptar, la foto es torna a retallar i la seva caixa a l'escaneig s'hi ajusta (Retorn per acceptar, Esc per cancel·lar).</sys:String>
	<sys:String x:Key="HelpInteractiveBoxesTitle">Editar les caixes</sys:String>
	<sys:String x:Key="HelpInteractiveBoxes">Fes clic dins d'una caixa per veure'n la foto. Arrossega una cantonada per canviar-ne la mida (mentre arrossegues apareix en una cantonada una vista ampliada del punt, per ajustar la vora just a la de la foto) i la nansa blava per girar-la; la foto es torna a extreure quan la deixes anar. Fes clic a la ✕ vermella de la cantonada superior dreta per eliminar-la. Tots els canvis es poden desfer.</sys:String>
	<sys:String x:Key="HelpDpiTitle">Resolució de l'escaneig</sys:String>
	<sys:String x:Key="HelpDpi">La resolució de l'escàner (per exemple 300 o 600 PPP) es conserva a les fotos exportades, perquè s'imprimeixin a la seva mida real.</sys:String>
	<sys:String x:Key="HelpAutoOrientTitle">Orientació amb IA i paisatge</sys:String>
	<sys:String x:Key="HelpAutoOrientDesc">Posa les fotos dretes automàticament: un model de detecció de cares (YuNet) troba les cares, i l'anàlisi de cel, aigua i paisatge cobreix les fotos sense persones.</sys:String>
	<sys:String x:Key="HelpRestoreColorsTitle">Restauració del color</sys:String>
	<sys:String x:Key="HelpRestoreColorsDesc">Per a cada foto: predefinits (còpia en color esvaïda, blanc i negre, sèpia, només netejar la pols, cap), una intensitat automàtica, detecció de blanc i negre o sèpia i ajust manual de brillantor, contrast, calidesa, to i saturació. «Copiar els ajustos a totes» aplica els d'una foto a totes.</sys:String>
	<sys:String x:Key="HelpRemoveDustTitle">Eliminació de pols</sys:String>
	<sys:String x:Key="HelpRemoveDustDesc">Troba la pols de l'escàner, les fibres i les ratlles fines i les omple a partir del seu voltant. Es pot fer servir sola, sense canviar els colors.</sys:String>
	<sys:String x:Key="HelpAutoTuneTitle">⚡ Ajust automàtic de la detecció</sys:String>
	<sys:String x:Key="HelpAutoTuneDesc">Prova moltes combinacions de tolerància del fons, llindar de vores i mida de foto per trobar fotos difícils o febles, sense tocar els controls. També es pot executar a cada escaneig nou, o només quan les fotos cobreixen poca part de l'escaneig.</sys:String>
	<sys:String x:Key="HelpThemeTitle">Temes i caixes per a daltònics</sys:String>
	<sys:String x:Key="HelpThemeDesc">Canvia entre els temes Fosc, Clar i Sistema a Configuració → Tema. Color de la caixa ofereix colors predefinits aptes per a daltònics o qualsevol color personalitzat.</sys:String>
	<sys:String x:Key="HelpSafeExitTitle">Desament automàtic i recuperació</sys:String>
	<sys:String x:Key="HelpSafeExitDesc">Els escanejos s'escriuen al projecte tan bon punt arriben, i els canvis als retalls i la configuració de l'acabat es desen mentre els fas, de manera que tancar l'aplicació o una fallada no fan perdre res. Es poden desfer les 30 últimes edicions.</sys:String>
