	<sys:String x:Key="MenuRotateCcw">Girar 90° Antihorari</sys:String>
	<sys:String x:Key="MenuRefineCrop">Ajustar Vores del Retall</sys:String>
	<sys:String x:Key="MenuExportSingle">Exportar Aquesta Foto...</sys:String>
	<sys:String x:Key="EmptyStateTitle">Arrossegueu i Deixeu Anar Escanejos Aquí</sys:String>
	<sys:String x:Key="EmptyStateDesc">Deixeu anar fitxers d'imatge o carpetes d'escaneig completes aquí, o feu clic a Obrir / Escanejar a dalt.</sys:String>
