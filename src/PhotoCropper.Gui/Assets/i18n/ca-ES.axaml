	<sys:String x:Key="LblNoPhotosHint">Prova de reduir la mida mínima de foto, o fes clic a Auto-Ajustar per trobar fotos.</sys:String>
	<sys:String x:Key="TipDeletePhoto">Elimina la foto (Supr)</sys:String>
