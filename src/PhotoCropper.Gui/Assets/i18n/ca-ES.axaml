	<sys:String x:Key="ColorCustom">Color Personalitzat...</sys:String>
	<sys:String x:Key="TitleCustomColor">Color de Marc Personalitzat</sys:String>
	<sys:String x:Key="DescCustomColor">Selecciona o ajusta un color d'alt contrast per als marcs de detecció de fotos.</sys:String>
	<sys:String x:Key="BtnApply">Aplicar</sys:String>
