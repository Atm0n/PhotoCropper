	<sys:String x:Key="LblScanner">Escàner:</sys:String>
	<sys:String x:Key="LblDpi">PPP:</sys:String>
	<sys:String x:Key="TipScannerConfig">Configurar escàner, resolució (PPP) i opcions de xarxa</sys:String>
	<sys:String x:Key="TitleScannerConfig">Configuració de l'Escàner</sys:String>
	<sys:String x:Key="DescScannerConfig">Seleccioneu el vostre escàner i la resolució de captura. La configuració es desarà automàticament.</sys:String>
	<sys:String x:Key="BtnSaveAndScan">Desar i Escanejar</sys:String>
	<sys:String x:Key="BtnSaveSettings">Desar</sys:String>
	<sys:String x:Key="LblScannerResolution">Resolució (PPP):</sys:String>
	<sys:String x:Key="LblScannerDevice">Dispositiu d'Escàner:</sys:String>
	<sys:String x:Key="TxtScanningSearching">Cercant escàners connectats...</sys:String>
	<sys:String x:Key="BtnSelectAll">Seleccionar Tot</sys:String>
	<sys:String x:Key="TipSelectAll">Seleccionar totes les fotos detectades en aquest escaneig (Ctrl+A)</sys:String>
	<sys:String x:Key="BtnClearSelection">Deseleccionar</sys:String>
	<sys:String x:Key="TipClearSelection">Deseleccionar fotos</sys:String>
	<sys:String x:Key="TxtSelectedCount">({0} de {1} seleccionades)</sys:String>
	<sys:String x:Key="BtnDeleteCount">Eliminar ({0})</sys:String>
	<sys:String x:Key="BtnRotateCount">Girar ({0})</sys:String>
	<sys:String x:Key="MsgBatchRotating">Girant {0} fotos...</sys:String>
	<sys:String x:Key="MsgBatchRotated">{0} fotos girades.</sys:String>
	<sys:String x:Key="MsgBatchDeleted">{0} fotos eliminades.</sys:String>
	<sys:String x:Key="TipRefineMultiDisabled">Seleccioneu una sola foto per ajustar vores</sys:String>
	<sys:String x:Key="TitleUnsavedChanges">Canvis no desats</sys:String>
	<sys:String x:Key="MsgUnsavedChanges">Teniu canvis no desats o fotos no exportades. Voleu desar el vostre treball abans de sortir?</sys:String>
	<sys:String x:Key="BtnSaveAndExit">Desar i Sortir</sys:String>
	<sys:String x:Key="BtnDiscardAndExit">Descartar i Sortir</sys:String>
