<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<sys:String x:Key="BtnOpenScans">Abrir</sys:String>
	<sys:String x:Key="BtnSaveResults">Guardar</sys:String>
	<sys:String x:Key="LblDetectionSensitivity">Sensibilidad</sys:String>
	<sys:String x:Key="LblZoom">Zoom</sys:String>
	<sys:String x:Key="BtnAdvanced">Avanzado</sys:String>
	<sys:String x:Key="LblMinPhotoSize">Tamaño Mínimo</sys:String>
	<sys:String x:Key="LblMaxPhotoSize">Tamaño Máximo</sys:String>
	<sys:String x:Key="LblEdgeThreshold">Umbral de Bordes</sys:String>
	<sys:String x:Key="LblAutoOrient">Auto-Orientar (IA / Paisaje)</sys:String>
	<sys:String x:Key="TipAutoOrient">Endereza y orienta automáticamente las fotos usando detección facial por IA y análisis de paisajes/agua.</sys:String>
	<sys:String x:Key="LblRestoreColors">Restaurar Color y Contraste</sys:String>
	<sys:String x:Key="TipRestoreColors">Neutraliza el amarilleo por envejecimiento, recupera sombras y luces con LAB CLAHE y revive colores desvaídos.</sys:String>
	<sys:String x:Key="LblRemoveDust">Eliminar Polvo y Rayaduras</sys:String>
	<sys:String x:Key="TipRemoveDust">Inpainting automático de rayaduras finas, motas de polvo y fibras del escáner.</sys:String>
	<sys:String x:Key="TxtNoFiles">Sin archivos</sys:String>
	<sys:String x:Key="HeaderOriginal">ESCANEO ORIGINAL (CLIC Y ARRASTRAR PARA RECORTAR)</sys:String>
	<sys:String x:Key="HeaderDetected">FOTOS DETECTADAS</sys:String>
	<sys:String x:Key="ViewCarousel">Individual</sys:String>
	<sys:String x:Key="ViewGrid">Cuadrícula</sys:String>
	<sys:String x:Key="TipViewCarousel">Vista individual de fotos (Atajo: 1)</sys:String>
	<sys:String x:Key="TipViewGrid">Vista en cuadrícula de todas las fotos (Atajo: 2)</sys:String>
	<sys:String x:Key="BtnDelete">Eliminar</sys:String>
	<sys:String x:Key="BtnRotate">Rotar 90°</sys:String>
	<sys:String x:Key="BtnRefine">Ajustar Bordes</sys:String>
	<sys:String x:Key="BtnAccept">Aceptar (Enter)</sys:String>
	<sys:String x:Key="BtnReject">Rechazar (Retroceso)</sys:String>
	<sys:String x:Key="StatusReady">Listo</sys:String>
	<sys:String x:Key="StatusShortcuts">Atajos: [↑/↓] Cambiar Escaneo | [←/→] Navegar Fotos | [T] Auto-Ajustar | [R] Rotar | [Espacio] Comparar Original | [Ctrl+Z/Y] Deshacer/Rehacer</sys:String>
	<sys:String x:Key="MsgUndo">Deshecho: {0}.</sys:String>
	<sys:String x:Key="MsgRedo">Rehecho: {0}.</sys:String>
	<sys:String x:Key="PhotoCounter">FOTO {0} DE {1}</sys:String>
	<sys:String x:Key="ScanCounter">Escaneo {0} de {1}</sys:String>
	<sys:String x:Key="ProcessingScan">Procesando...</sys:String>
	<sys:String x:Key="MsgSavingProgress">Exportando foto {0} de {1}...</sys:String>
	<sys:String x:Key="MsgSaved">Se han guardado {0} fotos con éxito.</sys:String>
	<sys:String x:Key="MsgReprocessing">Reprocesando con nuevos ajustes...</sys:String>
	<sys:String x:Key="MsgDetectionComplete">Detección finalizada. Encontradas {0} fotos.</sys:String>
	<sys:String x:Key="MsgPhotoDeleted">Foto eliminada.</sys:String>
	<sys:String x:Key="MsgRotating">Rotando foto...</sys:String>
	<sys:String x:Key="MsgPhotoRotated">Foto rotada.</sys:String>
	<sys:String x:Key="MsgExtractingCrop">Extrayendo recorte manual...</sys:String>
	<sys:String x:Key="MsgManualCropAdded">Recorte manual añadido.</sys:String>
	<sys:String x:Key="MsgRefineModeHelp">Modo ajuste: Dibuja para recortar, Enter para Aceptar, Retroceso para Cancelar.</sys:String>
	<sys:String x:Key="MsgApplyingRefine">Aplicando ajuste...</sys:String>
	<sys:String x:Key="MsgRefineSuccess">Recorte ajustado con éxito.</sys:String>
	<sys:String x:Key="MsgRefineCancelled">Ajuste cancelado.</sys:String>
	<sys:String x:Key="MenuLanguage">Idioma</sys:String>
	<sys:String x:Key="BtnHelp">Ayuda</sys:String>
	<sys:String x:Key="BtnClose">Cerrar</sys:String>
	<sys:String x:Key="HeaderHelp">Controles y Atajos</sys:String>
	<sys:String x:Key="HelpOpenScans">Carga múltiples imágenes o escaneos a la vez desde tu ordenador.</sys:String>
	<sys:String x:Key="HelpSaveResults">Guarda todas las fotos detectadas y ajustadas en una subcarpeta 'cropped' junto a cada escaneo original.</sys:String>
	<sys:String x:Key="HelpSensitivity">Ajusta la agresividad con la que el motor busca bordes de fotos. Valores altos encuentran bordes tenues pero pueden incluir ruido.</sys:String>
	<sys:String x:Key="HelpManualCrop">Haz clic y arrastra sobre el escaneo original (izquierda) para definir manualmente el área de una foto si no fue detectada.</sys:String>
	<sys:String x:Key="HelpRefine">Entra en un modo especializado para ajustar los bordes de una foto. Ideal para eliminar márgenes blancos del escáner.</sys:String>
	<sys:String x:Key="HelpDragDropTitle">Arrastrar y Soltar</sys:String>
	<sys:String x:Key="HelpDragDrop">Arrastra archivos de imagen o carpetas enteras a la ventana para poner en cola y procesar escaneos automáticamente.</sys:String>
	<sys:String x:Key="HelpDpiTitle">Preservación de DPI</sys:String>
	<sys:String x:Key="HelpDpi">La resolución original del escáner (ej. 300/600 DPI) se detecta y preserva al exportar para conservar la escala física de impresión 1:1.</sys:String>
	<sys:String x:Key="HelpAutoOrientTitle">Orientación IA y Paisajes</sys:String>
	<sys:String x:Key="HelpAutoOrientDesc">Usa una red neuronal integrada (YuNet) para detectar la orientación de rostros y análisis de paisajes/agua para orientar fotos en vertical.</sys:String>
	<sys:String x:Key="HelpRestoreColorsTitle">Restauración de Color Vintage</sys:String>
	<sys:String x:Key="HelpRestoreColorsDesc">Corrige el tono amarillento/sepia por envejecimiento, recupera contraste con LAB CLAHE y realza pigmentos desvaídos.</sys:String>
	<sys:String x:Key="HelpRemoveDustTitle">Eliminación de Polvo y Rayaduras</sys:String>
	<sys:String x:Key="HelpRemoveDustDesc">Detecta motas de polvo, fibras y rayaduras finas mediante filtros morfológicos y las repara con inpainting de OpenCV.</sys:String>
	<sys:String x:Key="HelpAutoTuneTitle">⚡ Auto-Ajuste de Detección</sys:String>
	<sys:String x:Key="HelpAutoTuneDesc">Realiza un barrido automático de tolerancias, umbrales de borde y tamaños mínimos para descubrir fotos difíciles sin tocar los controles.</sys:String>
	<sys:String x:Key="HelpShortcutsTitle">Atajos de Teclado</sys:String>
	<sys:String x:Key="HelpShortcutScan">[F5] Escanear desde el escáner</sys:String>
	<sys:String x:Key="HelpShortcutAutoTune">[T] Auto-ajustar escaneo activo</sys:String>
	<sys:String x:Key="HelpShortcutRotate">[R] Rotar foto 90°</sys:String>
	<sys:String x:Key="HelpShortcutDelete">[X] o [Supr] Descartar foto</sys:String>
	<sys:String x:Key="HelpShortcutNextScan">[Re Pág / Av Pág] o [↑ / ↓] Cambiar escaneo</sys:String>
	<sys:String x:Key="HelpShortcutNextPhoto">[Izquierda / Derecha] Navegar fotos</sys:String>
	<sys:String x:Key="HelpShortcutCompare">[Espacio] Mantener para comparar original</sys:String>
	<sys:String x:Key="HelpShortcutRefine">[N] o [Ñ] Ajustar bordes</sys:String>
	<sys:String x:Key="HelpShortcutToggleView">[1 / 2] Cambiar Individual / Cuadrícula</sys:String>
	<sys:String x:Key="HelpShortcutUndo">[Ctrl+Z] Deshacer último cambio</sys:String>
	<sys:String x:Key="HelpShortcutRedo">[Ctrl+Y] Rehacer cambio</sys:String>
	<sys:String x:Key="HelpShortcutSave">[Ctrl+S] Guardar todos los resultados</sys:String>
	<sys:String x:Key="HelpShortcutClose">[ESC] Cerrar ventana</sys:String>
	<sys:String x:Key="TipRefine">Atajo: N o Ñ</sys:String>
	<sys:String x:Key="HelpAboutTitle">Acerca de PhotoCropper</sys:String>
	<sys:String x:Key="HelpAboutDescription">Extractor inteligente de fotos de alto rendimiento. Diseñado para una digitalización rápida y precisa de álbumes antiguos.</sys:String>
	<sys:String x:Key="HelpVersion">Versión 2.1.0</sys:String>
	<sys:String x:Key="HelpAuthor">Desarrollado por Nil Riera</sys:String>
	<sys:String x:Key="HelpPoweredBy">Impulsado por Emgu.CV (wrapper de OpenCV)</sys:String>
	<sys:String x:Key="HelpModelLicense">Detección facial IA: YuNet por Shiqi Yu / OpenCV Zoo (Apache 2.0)</sys:String>
	<sys:String x:Key="HelpCopyright">© 2026 Nil Riera. Licencia GPLv3.</sys:String>
	<sys:String x:Key="BtnReset">Restablecer valores</sys:String>
	<sys:String x:Key="LblFormat">Formato de salida</sys:String>
	<sys:String x:Key="LblQuality">Calidad JPEG</sys:String>
	<sys:String x:Key="LblOutputDir">Carpeta de salida</sys:String>
	<sys:String x:Key="WatermarkSameDir">Misma que el original (cropped/)</sys:String>
	<sys:String x:Key="TipClearDir">Restablecer a la carpeta original</sys:String>
	<sys:String x:Key="BtnSampleBackground">Muestrear Fondo</sys:String>
	<sys:String x:Key="BtnResetBackground">Fondo Automático</sys:String>
	<sys:String x:Key="MsgClickToSample">Haga clic en cualquier parte del fondo del escaneo para muestrear su color...</sys:String>
	<sys:String x:Key="BtnAutoTune">Auto-Ajustar</sys:String>
	<sys:String x:Key="TipAutoTune">Busca automáticamente los parámetros de detección óptimos para este escaneo. (Atajo: T)</sys:String>
	<sys:String x:Key="MsgAutoTuning">Auto-ajustando parámetros de detección...</sys:String>
	<sys:String x:Key="MsgAutoTuneSuccess">Auto-ajustado: se encontraron {0} fotos (Tolerancia: {1:0}, Borde: {2:0}).</sys:String>
	<sys:String x:Key="MsgAutoTuneFailed">El auto-ajuste no encontró fotos adicionales.</sys:String>
	<sys:String x:Key="BtnScan">Escanear</sys:String>
	<sys:String x:Key="TipScan">Adquirir escaneo desde el escáner plano (Atajo: F5)</sys:String>
	<sys:String x:Key="BtnWorkDir">Carpeta</sys:String>
	<sys:String x:Key="TipWorkDir">Seleccionar una carpeta de trabajo para almacenamiento automático y recuperación de sesión</sys:String>
	<sys:String x:Key="MsgScanning">Escaneando imagen desde {0}...</sys:String>
	<sys:String x:Key="MsgScanSuccess">Escaneo adquirido y guardado en el espacio de trabajo: {0}</sys:String>
	<sys:String x:Key="MsgNoScannerFound">No se detectó ningún escáner. Asegúrese de que esté encendido y conectado.</sys:String>
	<sys:String x:Key="MsgScanFailed">Error al escanear: {0}</sys:String>
	<sys:String x:Key="MsgResumeSession">Se detectó una sesión previa en esta carpeta ({0} escaneos). ¿Desea reanudarla?</sys:String>
	<sys:String x:Key="TitleResumeSession">Reanudar Sesión de Escaneo</sys:String>
	<sys:String x:Key="LblWorkDirStatus">Carpeta: {0}</sys:String>
	<sys:String x:Key="LblNoWorkDir">Sin Carpeta de Trabajo</sys:String>
	<sys:String x:Key="BtnDeleteScan">Eliminar Escaneo</sys:String>
	<sys:String x:Key="TipDeleteScan">Eliminar este escaneo completo del espacio de trabajo y disco (Atajo: Shift+Supr)</sys:String>
	<sys:String x:Key="MsgScanDeleted">Escaneo '{0}' eliminado.</sys:String>
	<sys:String x:Key="HelpShortcutDeleteScan">[Shift+Supr] Eliminar escaneo completo</sys:String>
	<sys:String x:Key="BtnCancel">Cancelar</sys:String>
	<sys:String x:Key="BtnOk">Aceptar</sys:String>
	<sys:String x:Key="BtnRefreshScanners">Actualizar Escáneres</sys:String>
	<sys:String x:Key="TitleNoScanner">No Se Detectó Ningún Escáner</sys:String>
	<sys:String x:Key="MsgNoScannerDetails">No se detectó ningún escáner en su sistema.&#x0a;&#x0a;• Compruebe que el escáner esté encendido y enchufado.&#x0a;• Verifique la conexión por cable USB o Wi-Fi.&#x0a;• Asegúrese de tener instalados los controladores (WIA, TWAIN o SANE).&#x0a;• Haga clic en 'Actualizar Escáneres' para volver a detectar.</sys:String>
	<sys:String x:Key="TitleScannerNotFound">Escáner No Encontrado</sys:String>
	<sys:String x:Key="MsgScannerNotFoundDetails">{0}&#x0a;&#x0a;• Verifique que el escáner esté encendido y los cables bien conectados.&#x0a;• Asegúrese de que ningún otro programa esté utilizando el escáner.&#x0a;• Reconecte el escáner y haga clic en 'Actualizar Escáneres'.</sys:String>
	<sys:String x:Key="TitleScannerError">Error de Comunicación con el Escáner</sys:String>
	<sys:String x:Key="MsgScannerErrorDetails">Error al comunicarse con el escáner '{0}':&#x0a;&#x0a;{1}&#x0a;&#x0a;Solución de problemas:&#x0a;• Compruebe la alimentación y cables del escáner.&#x0a;• Verifique el estado del controlador en su sistema operativo.&#x0a;• Reinicie el escáner y haga clic en 'Actualizar Escáneres'.</sys:String>
	<sys:String x:Key="MsgScanCancelled">El escaneo fue cancelado o expiró el tiempo de espera.</sys:String>
	<sys:String x:Key="LblNetworkScanners">Buscar en red (Wi-Fi / eSCL)</sys:String>
	<sys:String x:Key="TipNetworkScanners">Busca escáneres inalámbricos en la red local mediante Apple AirScan / eSCL (puede solicitar permiso del cortafuegos).</sys:String>
</ResourceDictionary>
