	<sys:String x:Key="StageFinishStatus">{0} fotos · {1} por exportar</sys:String>
	<sys:String x:Key="StageNeedsProject">Necesita un proyecto</sys:String>
	<sys:String x:Key="StartSubtitle">Digitaliza álbumes de fotos: escanea, recorta y restaura</sys:String>
	<sys:String x:Key="BtnNewProject">Proyecto nuevo</sys:String>
	<sys:String x:Key="TipNewProject">Empieza un álbum: escanea páginas, recorta las fotos y restáuralas.</sys:String>
	<sys:String x:Key="BtnOpenProject">Abrir proyecto</sys:String>
	<sys:String x:Key="TipOpenProject">Continúa una carpeta de proyecto de otro lugar.</sys:String>
	<sys:String x:Key="BtnRestoreOnly">Solo restaurar fotos</sys:String>
	<sys:String x:Key="TipRestoreOnly">Importa fotos que ya están recortadas y restáuralas, sin escanear.</sys:String>
