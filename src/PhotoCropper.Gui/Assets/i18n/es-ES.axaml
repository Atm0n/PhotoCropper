	<sys:String x:Key="LblProjectLocation">Ubicación</sys:String>
	<sys:String x:Key="BtnChangeLocation">Cambiar…</sys:String>
	<sys:String x:Key="BtnCreateProject">Crear</sys:String>
	<sys:String x:Key="LblRecentProjects">Proyectos recientes</sys:String>
	<sys:String x:Key="LblNoRecentProjects">Todavía no hay proyectos recientes.</sys:String>
	<sys:String x:Key="TipRemoveRecent">Quitar de esta lista (la carpeta no se borra)</sys:String>
	<sys:String x:Key="BtnBackToProject">Volver a {0}</sys:String>
	<sys:String x:Key="LblProjectMissing">No se encuentra la carpeta</sys:String>
	<sys:String x:Key="LblRecentProjectDetails">{0} escaneos · {1} fotos acabadas</sys:String>
	<sys:String x:Key="DefaultProjectName">Álbum {0}</sys:String>
	<sys:String x:Key="MsgProjectNameInvalid">El nombre de un proyecto no puede contener \ / : * ? " &lt; &gt; |</sys:String>
	<sys:String x:Key="MsgProjectExists">Ya hay una carpeta llamada '{0}' en esa ubicación. Elige otro nombre o usa Abrir proyecto.</sys:String>
	<sys:String x:Key="MsgProjectCreateFailed">No se ha podido crear la carpeta del proyecto: {0}</sys:String>
	<sys:String x:Key="BtnScanStage">🖨  Escanear</sys:String>
	<sys:String x:Key="BtnImportScans">Importar escaneos…</sys:String>
	<sys:String x:Key="ScanStageEmpty">Aún no hay escaneos. Escanea con tu escáner o importa archivos para empezar.&#x0a;Haz doble clic en un escaneo para ajustar sus recortes.</sys:String>
	<sys:String x:Key="ScanStatusNotChecked">Sin revisar</sys:String>
	<sys:String x:Key="ScanPreviewDetecting">Buscando fotos…</sys:String>
	<sys:String x:Key="TipScanPreview">Haz doble clic para ajustar los recortes de este escaneo</sys:String>
	<sys:String x:Key="ScanStatusNoPhotos">No se encontraron fotos</sys:String>
	<sys:String x:Key="ScanStatusPhotos">{0} fotos</sys:String>
	<sys:String x:Key="BtnExportFinal">Exportar a Final</sys:String>
	<sys:String x:Key="BtnImportPhotos">Importar fotos…</sys:String>
	<sys:String x:Key="BtnOpenFinalFolder">Abrir carpeta Final</sys:String>
	<sys:String x:Key="FinishNoProject">Abre o crea un proyecto (directorio de trabajo) para acabar las fotos.&#x0a;La etapa de acabado trabaja con las fotos de Cropped y las guarda en Final.</sys:String>
	<sys:String x:Key="FinishEmpty">Aún no hay fotos recortadas. Ajusta los recortes en el paso 2 o importa fotos ya recortadas.</sys:String>
	<sys:String x:Key="FinishSourceImported">Importada</sys:String>
	<sys:String x:Key="FinishStatusNew">Aún no exportada</sys:String>
	<sys:String x:Key="FinishStatusStale">Cambiada desde la exportación</sys:String>
	<sys:String x:Key="FinishStatusExported">Exportada</sys:String>
	<sys:String x:Key="MsgSavingCrops">Guardando recortes ({0} de {1})...</sys:String>
	<sys:String x:Key="MsgCropsSaved">Recortes guardados de {0} escaneos.</sys:String>
	<sys:String x:Key="MsgAutosaveFailed">No se han podido guardar los cambios: {0}</sys:String>
	<sys:String x:Key="MsgExportingFinal">Exportando {0} fotos...</sys:String>
	<sys:String x:Key="MsgFinalExported">Se han exportado {0} fotos a Final.</sys:String>
	<sys:String x:Key="MsgImportingPhotos">Importando {0} fotos...</sys:String>
	<sys:String x:Key="BtnAdjustCrops">Ajustar recortes</sys:String>
	<sys:String x:Key="BtnRescan">↻ Volver a escanear</sys:String>
	<sys:String x:Key="TipRescan">Escanear esta página de nuevo y sustituir este escaneo por el nuevo</sys:String>
	<sys:String x:Key="BtnDiscardScan">Descartar</sys:String>
	<sys:String x:Key="BtnConfirmDiscard">Confirmar descarte</sys:String>
	<sys:String x:Key="TipDiscardScan">Eliminar este escaneo y sus fotos del proyecto</sys:String>
	<sys:String x:Key="MsgScanReplaced">Se ha sustituido '{0}' por un nuevo escaneo.</sys:String>
	<sys:String x:Key="LblBefore">Antes</sys:String>
	<sys:String x:Key="LblAfter">Después (tal como se exportará)</sys:String>
	<sys:String x:Key="LblUpdatingPreview">actualizando…</sys:String>
	<sys:String x:Key="BtnCopySettingsToAll">Copiar ajustes a todas</sys:String>
	<sys:String x:Key="LblBorder">Borde</sys:String>
	<sys:String x:Key="LblTrimBorders">Recortar borde blanco</sys:String>
	<sys:String x:Key="TipTrimBorders">Deja fuera el borde blanco o crema de la copia en la foto final y conserva solo la imagen. La vista previa oscurece lo que se recortará. Las fotos sin un borde claro no cambian; la foto recortada siempre conserva la copia entera.</sys:String>
	<sys:String x:Key="TipBulkToggle">Marcado: todas las fotos seleccionadas lo tienen. Guion: solo algunas. Haz clic para activarlo en todas, o desactivarlo si ya lo tienen todas.</sys:String>
	<sys:String x:Key="LblStyleAll">Todas</sys:String>
	<sys:String x:Key="StyleBlackAndWhite">Blanco y negro</sys:String>
	<sys:String x:Key="StyleSepia">Sepia</sys:String>
	<sys:String x:Key="StyleFadedColor">Color descolorido</sys:String>
	<sys:String x:Key="StyleColor">Color</sys:String>
	<sys:String x:Key="BtnSuggestedPresets">Sugerido por tipo</sys:String>
	<sys:String x:Key="TipSuggestedPresets">Da a cada foto seleccionada el ajuste que mejor le va: Blanco y negro para copias en blanco y negro, Sepia para las sepia, Copia en color descolorida para el color descolorido y Solo limpiar polvo para fotos en color en buen estado.</sys:String>
	<sys:String x:Key="TipStyleFilter">Muestra solo las fotos de un tipo. Blanco y negro, sepia, color descolorido (domina un tono) y color se distinguen a partir de las propias fotos; revísalas antes de aplicar un ajuste.</sys:String>
	<sys:String x:Key="LblSortingStyles">Ordenando las fotos por tipo...</sys:String>
	<sys:String x:Key="BtnExportMarked">Exportar seleccionadas</sys:String>
	<sys:String x:Key="LblMarkedCount">{0} seleccionadas</sys:String>
	<sys:String x:Key="TipMarkPhoto">Selecciona esta foto para las acciones en bloque (o Ctrl+clic; Mayús+clic selecciona un rango)</sys:String>
	<sys:String x:Key="TipMarkAll">Selecciona todas las fotos para las acciones en bloque</sys:String>
	<sys:String x:Key="BtnCopySettingsToMarked">Copiar ajustes a las seleccionadas</sys:String>
	<sys:String x:Key="TipCopySettingsToMarked">Da a las fotos seleccionadas los ajustes de esta foto (las reparaciones no se copian)</sys:String>
	<sys:String x:Key="TipFinishGrid">Haz clic en una foto para editarla; Ctrl+clic o Mayús+clic para seleccionar varias y cambiarlas a la vez</sys:String>
	<sys:String x:Key="TipCopySettingsToAll">Aplicar a todas las fotos los ajustes de restauración de la foto seleccionada</sys:String>
	<sys:String x:Key="LblAutoRestore">Restauración automática</sys:String>
	<sys:String x:Key="LblPresets">Preajustes</sys:String>
	<sys:String x:Key="PresetFaded">Copia en color descolorida</sys:String>
	<sys:String x:Key="PresetBlackAndWhite">Blanco y negro</sys:String>
	<sys:String x:Key="PresetSepia">Sepia</sys:String>
	<sys:String x:Key="PresetOnlyDust">Solo limpiar polvo</sys:String>
	<sys:String x:Key="PresetNone">Ninguno</sys:String>
	<sys:String x:Key="LblAutomatic">Automático</sys:String>
	<sys:String x:Key="StrengthGentle">Suave</sys:String>
	<sys:String x:Key="StrengthNormal">Normal</sys:String>
	<sys:String x:Key="StrengthStrong">Fuerte</sys:String>
	<sys:String x:Key="LblAutoWhiteBalance">Dominante de color</sys:String>
	<sys:String x:Key="LblAutoContrast">Contraste</sys:String>
	<sys:String x:Key="LblAutoSaturation">Colores apagados</sys:String>
	<sys:String x:Key="LblPhotoType">Tipo de foto</sys:String>
	<sys:String x:Key="ColorModeAuto">Detectar automáticamente</sys:String>
	<sys:String x:Key="ColorModeColor">Color</sys:String>
	<sys:String x:Key="ColorModeKeepTone">Blanco y negro, conservar el tono (sepia)</sys:String>
	<sys:String x:Key="ColorModeNeutral">Blanco y negro, gris neutro</sys:String>
	<sys:String x:Key="LblAdjustments">Ajustes</sys:String>
	<sys:String x:Key="BtnResetAdjustments">Restablecer</sys:String>
	<sys:String x:Key="LblBrightness">Brillo</sys:String>
	<sys:String x:Key="LblContrast">Contraste</sys:String>
	<sys:String x:Key="LblWarmth">Calidez</sys:String>
	<sys:String x:Key="LblTint">Matiz</sys:String>
	<sys:String x:Key="LblSaturation">Saturación</sys:String>
	<sys:String x:Key="BtnRepairBrush">🖌 Pincel de reparación</sys:String>
	<sys:String x:Key="TipRepairBrush">Pinta sobre arañazos, pliegues, roturas o manchas: se rellenan a partir de su entorno</sys:String>
	<sys:String x:Key="LblBrushSize">Tamaño</sys:String>
	<sys:String x:Key="BtnUndoStroke">Deshacer trazo</sys:String>
	<sys:String x:Key="BtnClearRepairs">Borrar reparaciones</sys:String>
	<sys:String x:Key="LblRepairHint">Pinta sobre los daños</sys:String>
	<sys:String x:Key="MsgRepairsOutdated">Las reparaciones de esta foto se pintaron sobre un recorte anterior de otro tamaño, así que no se aplican. Al pintar un trazo nuevo se sustituyen; Borrar reparaciones las elimina.</sys:String>
	<sys:String x:Key="LblFillMethod">Relleno:</sys:String>
	<sys:String x:Key="OptQuickFill">Rápido</sys:String>
	<sys:String x:Key="TipQuickFill">Mezcla el entorno en la zona pintada. Instantáneo; ideal para arañazos, pliegues y manchas pequeñas.</sys:String>
	<sys:String x:Key="OptAiFill">IA</sys:String>
	<sys:String x:Key="TipAiFill">Genera contenido nuevo que continúa el entorno (bordes, paredes, cielo, hierba). Unos segundos por zona; ideal para daños grandes y esquinas rotas. No sirve para caras ni texto: inventa detalles. Se ejecuta en este ordenador.</sys:String>
	<sys:String x:Key="LblAiLoading">Cargando el modelo de IA…</sys:String>
	<sys:String x:Key="MsgAiDownload">El relleno con IA necesita descargar una sola vez el modelo LaMa (208 MB). Se ejecuta en este ordenador: tus fotos nunca se suben.</sys:String>
	<sys:String x:Key="BtnDownloadAiModel">Descargar (208 MB)</sys:String>
	<sys:String x:Key="BtnCancelDownload">Cancelar</sys:String>
	<sys:String x:Key="BtnBackToGrid">◀ Todas las fotos</sys:String>
	<sys:String x:Key="TipBackToGrid">Volver a todas las fotos (Esc)</sys:String>
	<sys:String x:Key="TipPreviousPhoto">Foto anterior (←)</sys:String>
	<sys:String x:Key="TipNextPhoto">Foto siguiente (→)</sys:String>
	<sys:String x:Key="BtnZoomFit">Ajustar</sys:String>
	<sys:String x:Key="TipViewerControls">Rueda del ratón: zoom · arrastrar: mover la foto · arrastrar el divisor: comparar antes y después · mantener Espacio: ver el original · F: ajustar · B: pincel de reparación</sys:String>
	<sys:String x:Key="MsgReprocessing">Reprocesando escaneo con nuevos ajustes...</sys:String>
	<sys:String x:Key="MsgDetectingPhotos">Detectando fotos...</sys:String>
	<sys:String x:Key="MsgDetectionComplete">Detección finalizada. Encontradas {0} fotos.</sys:String>
	<sys:String x:Key="MsgPhotoDeleted">Foto eliminada.</sys:String>
	<sys:String x:Key="MsgRotating">Rotando foto...</sys:String>
	<sys:String x:Key="MsgPhotoRotated">Foto rotada.</sys:String>
	<sys:String x:Key="MsgExtractingCrop">Extrayendo recorte manual...</sys:String>
	<sys:String x:Key="MsgManualCropAdded">Recorte manual añadido.</sys:String>
	<sys:String x:Key="MsgFindingPhoto">Buscando la foto...</sys:String>
	<sys:String x:Key="MsgNoPhotoFound">No se ha encontrado ninguna foto aquí. Haz clic más cerca de su centro, o dibuja un recuadro.</sys:String>
	<sys:String x:Key="MsgPhotoFound">Foto encontrada y añadida.</sys:String>
	<sys:String x:Key="MsgPhotoRefitted">Recuadro ajustado a la foto.</sys:String>
	<sys:String x:Key="BtnFindPhoto">Buscar foto</sys:String>
	<sys:String x:Key="TipFindPhoto">Haz clic en una foto para encontrarla y añadir su recuadro; haz clic dentro de un recuadro para ajustarlo a la foto. Vuelve a pulsar el botón o Esc para terminar.</sys:String>
	<sys:String x:Key="MsgRefineModeHelp">Modo de ajuste: dibuja para recortar a mano, Enter para aceptar, Esc para cancelar.</sys:String>
	<sys:String x:Key="MsgApplyingRefine">Aplicando ajuste...</sys:String>
	<sys:String x:Key="MsgRefineSuccess">Recorte ajustado con éxito.</sys:String>
	<sys:String x:Key="MsgRefineCancelled">Ajuste cancelado.</sys:String>
	<sys:String x:Key="MenuLanguage">Idioma</sys:String>
	<sys:String x:Key="BtnHelp">Ayuda</sys:String>
	<sys:String x:Key="BtnClose">Cerrar</sys:String>
	<sys:String x:Key="HeaderHelp">Controles y Atajos</sys:String>
	<sys:String x:Key="HelpSaveResults">No hay botón Guardar: cada cambio se guarda en el proyecto mientras lo haces. Al pasar a la etapa de acabado, los recortes se escriben en Cropped/ como PNG sin pérdida, y Exportar en la etapa de acabado escribe las fotos acabadas en Final/.</sys:String>
	<sys:String x:Key="HelpSensitivity">Con qué intensidad se buscan los bordes de las fotos. Un valor más alto encuentra bordes más débiles pero puede captar ruido. El tamaño mínimo y máximo y el umbral de bordes están en los controles de ajuste; la detección se repite cuando dejas de arrastrar.</sys:String>
	<sys:String x:Key="HelpManualCrop">Arrastra un rectángulo sobre el escaneo para añadir una foto que no se haya detectado. Se añade a la lista y queda seleccionada.</sys:String>
	<sys:String x:Key="HelpRefine">Dibuja un recorte más ajustado dentro de una foto, por ejemplo para quitar un margen blanco del escáner. Al aceptar, la foto se vuelve a recortar y su caja en el escaneo se ajusta (Intro para aceptar, Esc para cancelar).</sys:String>
	<sys:String x:Key="HelpInteractiveBoxesTitle">Editar las cajas</sys:String>
	<sys:String x:Key="HelpInteractiveBoxes">Haz clic dentro de una caja para ver su foto. Arrastra una esquina para cambiar su tamaño (mientras arrastras aparece en una esquina una vista ampliada del punto, para ajustar el borde justo al de la foto) y el asa azul para girarla; la foto se vuelve a extraer al soltarla. Haz clic en la ✕ roja de la esquina superior derecha para eliminarla. Todos los cambios se pueden deshacer.</sys:String>
	<sys:String x:Key="HelpDpiTitle">Resolución del escaneo</sys:String>
	<sys:String x:Key="HelpDpi">La resolución del escáner (por ejemplo 300 o 600 PPP) se conserva en las fotos exportadas, para que se impriman a su tamaño real.</sys:String>
	<sys:String x:Key="HelpAutoOrientTitle">Orientación con IA y paisaje</sys:String>
	<sys:String x:Key="HelpAutoOrientDesc">Pone las fotos derechas automáticamente: un modelo de detección de caras (YuNet) encuentra las caras, y el análisis de cielo, agua y paisaje cubre las fotos sin personas.</sys:String>
	<sys:String x:Key="HelpRestoreColorsTitle">Restauración del color</sys:String>
	<sys:String x:Key="HelpRestoreColorsDesc">Para cada foto: preajustes (copia en color desvaída, blanco y negro, sepia, solo limpiar el polvo, ninguno), una intensidad automática, detección de blanco y negro o sepia y ajuste manual de brillo, contraste, calidez, tono y saturación. «Copiar ajustes a todas» aplica los de una foto a todas.</sys:String>
	<sys:String x:Key="HelpRemoveDustTitle">Eliminación de polvo</sys:String>
	<sys:String x:Key="HelpRemoveDustDesc">Encuentra el polvo del escáner, las fibras y los arañazos finos y los rellena a partir de su entorno. Se puede usar sola, sin cambiar los colores.</sys:String>
	<sys:String x:Key="HelpAutoTuneTitle">⚡ Ajuste automático de la detección</sys:String>
	<sys:String x:Key="HelpAutoTuneDesc">Prueba muchas combinaciones de tolerancia del fondo, umbral de bordes y tamaño de foto para encontrar fotos difíciles o débiles, sin tocar los controles. También puede ejecutarse en cada escaneo nuevo, o solo cuando las fotos cubren poca parte del escaneo.</sys:String>
	<sys:String x:Key="HelpThemeTitle">Temas y cajas para daltónicos</sys:String>
	<sys:String x:Key="HelpThemeDesc">Cambia entre los temas Oscuro, Claro y Sistema en Configuración → Tema. Color de la caja ofrece colores predefinidos aptos para daltónicos o cualquier color personalizado.</sys:String>
	<sys:String x:Key="HelpSafeExitTitle">Guardado automático y recuperación</sys:String>
	<sys:String x:Key="HelpSafeExitDesc">Los escaneos se escriben en el proyecto en cuanto llegan, y los cambios en los recortes y los ajustes del acabado se guardan mientras los haces, de modo que cerrar la aplicación o un fallo no hacen perder nada. Se pueden deshacer las 30 últimas ediciones.</sys:String>
	<sys:String x:Key="HelpShortcutsTitle">Atajos de Teclado</sys:String>
	<sys:String x:Key="HelpShortcutScan">[F5] Escanear desde el escáner</sys:String>
	<sys:String x:Key="HelpShortcutRotate">[R] Rotar foto 90°</sys:String>
	<sys:String x:Key="HelpShortcutDelete">[Supr] Elimina las fotos seleccionadas</sys:String>
