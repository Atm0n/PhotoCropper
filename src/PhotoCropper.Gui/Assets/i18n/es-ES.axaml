	<sys:String x:Key="HelpMetadataTitle">Metadatos de las fotos (EXIF)</sys:String>
	<sys:String x:Key="HelpMetadataDesc">Da a las fotos un año aproximado, una fecha, una descripción y un fotógrafo; se escriben como etiquetas EXIF para que los gestores de fotos puedan ordenarlas por cuándo se hicieron.</sys:String>
