<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gui="using:PhotoCropper.Gui"
		WindowState="Maximized"
		MinWidth="850"
		MinHeight="550"
        x:Class="PhotoCropper.Gui.MainWindow"
		Background="#1e1e1e"
		Foreground="White"
        Title="PhotoCropper - Intelligent Photo Extractor"
        Icon="avares://PhotoCropper.Gui/Assets/app_icon.png"
        DragDrop.AllowDrop="True">

	<Grid>
		<DockPanel>
			<!-- Header / Toolbar -->
		<Border DockPanel.Dock="Top" Background="#262626" MinHeight="48" BorderBrush="#383838" BorderThickness="0,0,0,1">
			<StackPanel>
				<!-- Responsive Main Toolbar with Grouped Cards -->
				<WrapPanel Orientation="Horizontal" Margin="8,4" VerticalAlignment="Center">
					<!-- Group 1: File Actions (Scan, Open, Save) -->
					<Border Background="#1e1e1e" CornerRadius="6" Padding="4,3" BorderBrush="#353535" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<!-- Scan Button with Config Trigger -->
							<Border Background="#28a745" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="0">
									<Button x:Name="btnScan" Click="BtnScan_Click" Padding="10,5" Background="Transparent" BorderThickness="0" Foreground="White" Focusable="False" ToolTip.Tip="{DynamicResource TipScan}">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="🖨️" FontSize="12" VerticalAlignment="Center"/>
											<TextBlock Text="{DynamicResource BtnScan}" FontWeight="SemiBold" VerticalAlignment="Center"/>
										</StackPanel>
									</Button>
									<Rectangle Width="1" Fill="#3db85a" Margin="0,4"/>
									<Button x:Name="btnScannerConfig" Click="BtnScannerConfig_Click" Padding="6,5" Background="Transparent" BorderThickness="0" Foreground="White" Focusable="False" ToolTip.Tip="{DynamicResource TipScannerConfig}">
										<TextBlock Text="⚙️" FontSize="11" VerticalAlignment="Center"/>
									</Button>
								</StackPanel>
							</Border>
							<Button x:Name="btnOpenFiles" Click="BtnOpenFiles_Click" Padding="10,5" Background="#1c6ec2" Foreground="White" Focusable="False" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="📁" FontSize="12" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource BtnOpenScans}" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<Button x:Name="btnSave" Click="BtnSaveImages_Click" Padding="10,5" Background="#353535" Foreground="White" Focusable="False" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="💾" FontSize="12" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource BtnSaveResults}" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>

					<!-- Group 2: Project Workspace -->
					<Border Background="#1e1e1e" CornerRadius="6" Padding="4,3" BorderBrush="#353535" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<Button x:Name="btnWorkDir" Click="BtnWorkDir_Click" Padding="8,5" Background="#353535" Foreground="White" Focusable="False" ToolTip.Tip="{DynamicResource TipWorkDir}" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
									<TextBlock Text="🗂️" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock x:Name="txtWorkDirBtn" Text="{DynamicResource BtnWorkDir}" FontWeight="SemiBold" MaxWidth="110" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<Button x:Name="btnNewProject" Click="BtnNewProject_Click" Padding="8,5" Background="#353535" Foreground="White" Focusable="False" ToolTip.Tip="{DynamicResource TipNewProject}" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
									<TextBlock Text="➕" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource BtnNewProject}" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>

					<!-- Group 3: Detection Tuning -->
					<Border Background="#1e1e1e" CornerRadius="6" Padding="6,3" BorderBrush="#353535" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<ToggleButton x:Name="tglColorPicker" Click="TglColorPicker_Click" Padding="6,4" Focusable="False" ToolTip.Tip="{DynamicResource BtnSampleBackground}" CornerRadius="4">
								<TextBlock Text="🎨" FontSize="12"/>
							</ToggleButton>
							<Button x:Name="btnResetBackground" Click="BtnResetBackground_Click" Padding="6,4" Focusable="False" IsEnabled="False" ToolTip.Tip="{DynamicResource BtnResetBackground}" CornerRadius="4">
								<TextBlock Text="🔄" FontSize="12"/>
							</Button>

							<Rectangle Width="1" Height="18" Fill="#3e3e3e" Margin="2,0"/>

							<TextBlock Text="{DynamicResource LblDetectionSensitivity}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#aaaaaa"/>
							<Slider x:Name="sldSensitivity" Minimum="0" Maximum="100" Value="25" Width="70" 
									PointerCaptureLost="SldSensitivity_PointerCaptureLost" VerticalAlignment="Center" Focusable="False"/>
							<TextBlock Text="{Binding #sldSensitivity.Value, StringFormat='{}{0:0}%'}" 
									   VerticalAlignment="Center" Width="30" FontSize="11" FontWeight="Bold"/>

							<Button x:Name="btnAutoTune" Click="BtnAutoTune_Click" Padding="6,4" Background="#24517e" ToolTip.Tip="{DynamicResource TipAutoTune}" Focusable="False" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="4">
									<TextBlock Text="⚡" FontSize="11"/>
									<TextBlock Text="{DynamicResource BtnAutoTune}" FontSize="11" FontWeight="SemiBold"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>

					<!-- Group 4: Zoom View -->
					<Border Background="#1e1e1e" CornerRadius="6" Padding="6,3" BorderBrush="#353535" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<TextBlock Text="{DynamicResource LblZoom}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#aaaaaa"/>
							<Slider x:Name="sldZoom" Minimum="1" Maximum="10" Value="1" Width="65" 
									PropertyChanged="SldZoom_PropertyChanged" VerticalAlignment="Center" Focusable="False"/>
							<TextBlock Text="{Binding #sldZoom.Value, StringFormat='{}{0:0}x'}" 
									   VerticalAlignment="Center" Width="26" FontSize="11" FontWeight="Bold"/>
						</StackPanel>
					</Border>

					<!-- Group 5: Scan Navigation -->
					<Border Background="#1e1e1e" CornerRadius="6" Padding="3,2" BorderBrush="#353535" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
							<Button x:Name="btnPrevScan" Click="BtnPrevScan_Click" Padding="6,4" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip.Tip="Previous Scan (PageUp / ↑)">
								<TextBlock Text="◀" FontSize="10"/>
							</Button>
							<TextBlock x:Name="txtFileCounter" Text="{DynamicResource TxtNoFiles}" Foreground="#aaaaaa" VerticalAlignment="Center" Margin="4,0" FontSize="11"/>
							<Button x:Name="btnNextScan" Click="BtnNextScan_Click" Padding="6,4" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip.Tip="Next Scan (PageDown / ↓)">
								<TextBlock Text="▶" FontSize="10"/>
							</Button>
							<Rectangle Width="1" Height="16" Fill="#3e3e3e" Margin="2,0"/>
							<Button x:Name="btnDeleteScan" Click="BtnDeleteScan_Click" Padding="6,4" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip.Tip="{DynamicResource TipDeleteScan}">
								<TextBlock Text="🗑️" FontSize="11"/>
							</Button>
						</StackPanel>
					</Border>

					<!-- Group 6: Advanced, Language & Help -->
					<Border Background="#1e1e1e" CornerRadius="6" Padding="4,3" BorderBrush="#353535" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<ToggleButton x:Name="tglAdvanced" Padding="8,4" FontSize="11" VerticalAlignment="Center" Focusable="False" CornerRadius="4" ToolTip.Tip="{DynamicResource BtnAdvanced}">
								<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
									<TextBlock Text="⚙️" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource BtnAdvanced}" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</ToggleButton>

							<Rectangle Width="1" Height="16" Fill="#3e3e3e" Margin="2,0"/>

							<Menu Background="Transparent" VerticalAlignment="Center" Margin="0" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None">
								<MenuItem Header="{DynamicResource MenuLanguage}" x:Name="menuLanguage" Focusable="False" IsTabStop="False" FontSize="11"/>
							</Menu>

							<Button x:Name="btnHelp" Click="BtnHelp_Click" Padding="6,4" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip.Tip="{DynamicResource BtnHelp}">
								<TextBlock Text="❓" FontSize="14"/>
							</Button>
						</StackPanel>
					</Border>
				</WrapPanel>

				<!-- Advanced Settings Drawer -->
				<Border Background="#202020" IsVisible="{Binding #tglAdvanced.IsChecked}" BorderBrush="#333333" BorderThickness="0,1,0,0">
					<ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
						<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,6">
							<!-- Card 1: Detection Fine-Tuning -->
							<Border Background="#181818" CornerRadius="6" Padding="12,10" BorderBrush="#333333" BorderThickness="1" Margin="5">
								<StackPanel Orientation="Vertical" Spacing="8">
									<TextBlock Text="{DynamicResource HeaderAdvDetection}" FontSize="11" FontWeight="Bold" Foreground="#3399ff"/>
									
									<WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
										<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,14,2">
											<TextBlock Text="{DynamicResource LblMinPhotoSize}" VerticalAlignment="Center" FontSize="11" Foreground="#888888"/>
											<Slider x:Name="sldMinArea" Minimum="5" Maximum="50" Value="15" Width="85" 
													PointerCaptureLost="SldSensitivity_PointerCaptureLost" VerticalAlignment="Center" Focusable="False"/>
											<TextBlock Text="{Binding #sldMinArea.Value, StringFormat='{}{0:0}%'}" FontSize="11" VerticalAlignment="Center" Width="28"/>
										</StackPanel>

										<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,14,2">
											<TextBlock Text="{DynamicResource LblMaxPhotoSize}" VerticalAlignment="Center" FontSize="11" Foreground="#888888"/>
											<Slider x:Name="sldMaxArea" Minimum="20" Maximum="100" Value="90" Width="85" 
													PointerCaptureLost="SldSensitivity_PointerCaptureLost" VerticalAlignment="Center" Focusable="False"/>
											<TextBlock Text="{Binding #sldMaxArea.Value, StringFormat='{}{0:0}%'}" FontSize="11" VerticalAlignment="Center" Width="28"/>
										</StackPanel>

										<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,14,2">
											<TextBlock Text="{DynamicResource LblEdgeThreshold}" VerticalAlignment="Center" FontSize="11" Foreground="#888888"/>
											<Slider x:Name="sldEdge" Minimum="1" Maximum="100" Value="20" Width="85" 
													PointerCaptureLost="SldSensitivity_PointerCaptureLost" VerticalAlignment="Center" Focusable="False"/>
											<TextBlock Text="{Binding #sldEdge.Value, StringFormat='{}{0:0}'}" FontSize="11" VerticalAlignment="Center" Width="28"/>
										</StackPanel>
									</WrapPanel>

									<WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
										<CheckBox x:Name="chkAutoOrient" Content="{DynamicResource LblAutoOrient}" ToolTip.Tip="{DynamicResource TipAutoOrient}" IsCheckedChanged="ChkAutoOrient_IsCheckedChanged" VerticalAlignment="Center" FontSize="11" Focusable="False" Margin="0,2,12,2"/>
										<CheckBox x:Name="chkRestoreColors" Content="{DynamicResource LblRestoreColors}" ToolTip.Tip="{DynamicResource TipRestoreColors}" IsCheckedChanged="ChkRestoreColors_IsCheckedChanged" VerticalAlignment="Center" FontSize="11" Focusable="False" Margin="0,2,12,2"/>
										<CheckBox x:Name="chkRemoveDust" Content="{DynamicResource LblRemoveDust}" ToolTip.Tip="{DynamicResource TipRemoveDust}" IsCheckedChanged="ChkRemoveDust_IsCheckedChanged" VerticalAlignment="Center" FontSize="11" Focusable="False" Margin="0,2,12,2"/>

										<Button x:Name="btnResetDefaults" Click="BtnResetDefaults_Click" Padding="8,4" FontSize="11" Background="#383838" VerticalAlignment="Center" Focusable="False" CornerRadius="4" Margin="0,2,4,2">
											<TextBlock Text="{DynamicResource BtnReset}"/>
										</Button>
									</WrapPanel>
								</StackPanel>
							</Border>

							<!-- Card 2: Export & Output -->
							<Border Background="#181818" CornerRadius="6" Padding="12,10" BorderBrush="#333333" BorderThickness="1" Margin="5">
								<StackPanel Orientation="Vertical" Spacing="8">
									<TextBlock Text="{DynamicResource HeaderAdvExport}" FontSize="11" FontWeight="Bold" Foreground="#3399ff"/>
									
									<WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
										<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,14,2">
											<TextBlock Text="{DynamicResource LblFormat}" VerticalAlignment="Center" FontSize="11" Foreground="#888888"/>
											<ComboBox x:Name="cbFormat" SelectedIndex="0" Width="85" SelectionChanged="CbFormat_SelectionChanged" Focusable="False" FontSize="11">
												<ComboBoxItem Content="JPEG"/>
												<ComboBoxItem Content="PNG"/>
											</ComboBox>
										</StackPanel>

										<StackPanel x:Name="pnlJpegQuality" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,14,2">
											<TextBlock Text="{DynamicResource LblQuality}" VerticalAlignment="Center" FontSize="11" Foreground="#888888"/>
											<Slider x:Name="sldJpegQuality" Minimum="10" Maximum="100" Value="90" Width="85" 
													PointerCaptureLost="SldJpegQuality_PointerCaptureLost" VerticalAlignment="Center" Focusable="False"/>
											<TextBlock Text="{Binding #sldJpegQuality.Value, StringFormat='{}{0:0}%'}" FontSize="11" VerticalAlignment="Center" Width="30"/>
										</StackPanel>
									</WrapPanel>

									<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
										<TextBlock Text="{DynamicResource LblOutputDir}" VerticalAlignment="Center" FontSize="11" Foreground="#888888"/>
										<TextBox x:Name="txtOutputDir" Width="180" IsReadOnly="True" PlaceholderText="{DynamicResource WatermarkSameDir}" FontSize="11" VerticalAlignment="Center" Background="#111111" BorderBrush="#333333" Focusable="False"/>
										<Button x:Name="btnBrowseDir" Click="BtnBrowseDir_Click" Padding="8,4" FontSize="11" Background="#383838" VerticalAlignment="Center" Focusable="False" CornerRadius="4">
											<TextBlock Text="..."/>
										</Button>
										<Button x:Name="btnClearOutputDir" Click="BtnClearOutputDir_Click" Padding="6,4" FontSize="11" Background="#382222" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource TipClearDir}" Focusable="False" CornerRadius="4">
											<TextBlock Text="✖" Foreground="#ff5555"/>
										</Button>
									</StackPanel>
								</StackPanel>
							</Border>
						</WrapPanel>
					</ScrollViewer>
				</Border>
			</StackPanel>
		</Border>

		<!-- Footer / Status Bar -->
		<Border DockPanel.Dock="Bottom" Background="#252525" Height="30" BorderBrush="#3f3f3f" BorderThickness="0,1,0,0">
			<Grid ColumnDefinitions="Auto, *, Auto">
				<!-- Project Indicator Badge -->
				<Border Grid.Column="0" Margin="8,3" Background="#1e1e1e" BorderBrush="#3a3a3a" BorderThickness="1" CornerRadius="4" Padding="8,2"
						PointerPressed="LblCurrentProject_PointerPressed" Cursor="Hand" ToolTip.Tip="{DynamicResource TipWorkDir}">
					<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
						<TextBlock Text="🗂️" FontSize="11" VerticalAlignment="Center"/>
						<TextBlock x:Name="lblCurrentProject" Text="{DynamicResource LblNoProject}" FontSize="11" FontWeight="SemiBold" Foreground="#3399ff" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Border>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0" Spacing="20" VerticalAlignment="Center">
					<TextBlock x:Name="lblStatus" Text="{DynamicResource StatusReady}" VerticalAlignment="Center" FontSize="12" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
					<TextBlock Text="{DynamicResource StatusShortcuts}" 
							   VerticalAlignment="Center" FontSize="11" Foreground="#555555" TextTrimming="CharacterEllipsis"/>
				</StackPanel>
				<TextBlock Grid.Column="2" x:Name="lblPhotoInfo" Text="" Margin="10,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#3399ff"/>
			</Grid>
		</Border>

		<!-- Main Workspace -->
		<Grid ColumnDefinitions="*, *">
			<!-- Left: Original Scan -->
			<Border Grid.Column="0" Margin="10" Background="#121212" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
				<Grid RowDefinitions="Auto, *">
					<TextBlock Grid.Row="0" Text="{DynamicResource HeaderOriginal}" Margin="10,5" FontSize="10" FontWeight="Bold" Foreground="#555555"/>
					<ScrollViewer Grid.Row="1" x:Name="scrollOriginal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
								  SizeChanged="ScrollOriginal_SizeChanged">
						<Panel x:Name="pnlOriginal" Background="Transparent" 
							   PointerPressed="PnlOriginal_PointerPressed" 
							   PointerMoved="PnlOriginal_PointerMoved" 
							   PointerReleased="PnlOriginal_PointerReleased"
							   PointerWheelChanged="ScrollOriginal_PointerWheelChanged"
							   HorizontalAlignment="Center" VerticalAlignment="Center">
							<LayoutTransformControl x:Name="ltcOriginal" HorizontalAlignment="Center" VerticalAlignment="Center">
								<LayoutTransformControl.LayoutTransform>
									<ScaleTransform ScaleX="{Binding #sldZoom.Value}" ScaleY="{Binding #sldZoom.Value}"/>
								</LayoutTransformControl.LayoutTransform>
								<Image x:Name="img" Stretch="Uniform"/>
							</LayoutTransformControl>
							<Canvas x:Name="cnvCrop" Background="Transparent" IsHitTestVisible="False">
								<Rectangle x:Name="rectCrop" Stroke="#3399ff" StrokeThickness="2" Fill="#333399ff" IsVisible="False"/>
							</Canvas>
						</Panel>
					</ScrollViewer>
				</Grid>
			</Border>

			<!-- Right: Cropped Results -->
			<Border Grid.Column="1" Margin="10" Background="#121212" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
				<Grid RowDefinitions="Auto, *, Auto">
					<!-- Header with View Toggle -->
					<Grid Grid.Row="0" Margin="10,5" ColumnDefinitions="*, Auto">
						<TextBlock Grid.Column="0" Text="{DynamicResource HeaderDetected}" FontSize="10" FontWeight="Bold" Foreground="#555555" VerticalAlignment="Center"/>
						
						<!-- Toggle Mode: Single vs Grid -->
						<Border Grid.Column="1" Background="#1a1a1a" CornerRadius="6" Padding="2" BorderBrush="#333333" BorderThickness="1">
							<StackPanel Orientation="Horizontal" Spacing="2">
								<RadioButton x:Name="rbViewCarousel" GroupName="grpResultView" IsChecked="True" 
											 IsCheckedChanged="RbViewMode_IsCheckedChanged" ToolTip.Tip="{DynamicResource TipViewCarousel}"
											 Focusable="False" Padding="8,3" CornerRadius="4" FontSize="11">
									<TextBlock Text="{DynamicResource ViewCarousel}"/>
								</RadioButton>
								<RadioButton x:Name="rbViewGrid" GroupName="grpResultView" 
											 IsCheckedChanged="RbViewMode_IsCheckedChanged" ToolTip.Tip="{DynamicResource TipViewGrid}"
											 Focusable="False" Padding="8,3" CornerRadius="4" FontSize="11">
									<TextBlock Text="{DynamicResource ViewGrid}"/>
								</RadioButton>
							</StackPanel>
						</Border>
					</Grid>
					
					<!-- Content Area: Single Carousel vs Gallery Grid -->
					<Panel Grid.Row="1">
						<!-- 1. Single Photo Carousel View -->
						<Panel x:Name="pnlCarouselView" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1000" MaxHeight="800">
							<Carousel x:Name="slides" SelectionChanged="Slides_SelectionChanged" Focusable="False" IsTabStop="False">
								<Carousel.PageTransition>
									<PageSlide Duration="0:0:0.2" Orientation="Horizontal" />
								</Carousel.PageTransition>
								<Carousel.ItemTemplate>
									<DataTemplate>
										<Border Margin="10" CornerRadius="4" ClipToBounds="True" Background="Transparent">
											<Image Stretch="Uniform" Source="{Binding}" 
												   MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center"/>
										</Border>
									</DataTemplate>
								</Carousel.ItemTemplate>
							</Carousel>
							
							<!-- Overlay Controls -->
							<Button VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-15,0"
									Click="BtnPreviousCroppedImage_Click" Content="&lt;" 
									Background="#80000000" Width="40" Height="80" CornerRadius="4" Focusable="False"/>
							
							<Button VerticalAlignment="Center" HorizontalAlignment="Right" Margin="-15,0"
									Click="BtnNextCroppedImage_Click" Content="&gt;" 
									Background="#80000000" Width="40" Height="80" CornerRadius="4" Focusable="False"/>
						</Panel>

						<!-- 2. Gallery Grid View -->
						<ScrollViewer x:Name="scrollGalleryView" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="False" Margin="10">
							<ListBox x:Name="lstGallery" SelectionChanged="LstGallery_SelectionChanged" Background="Transparent" BorderThickness="0" Focusable="False">
								<ListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5"/>
									</ItemsPanelTemplate>
								</ListBox.ItemsPanel>
								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="gui:GalleryPhotoItem">
										<Border Margin="6" Padding="4" Background="#1a1a1a" CornerRadius="6" BorderBrush="#333333" BorderThickness="1"
												Width="200" Height="220">
											<Grid RowDefinitions="*, Auto">
												<Image Grid.Row="0" Stretch="Uniform" Source="{Binding Image}" Margin="4"/>
												<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,4,0,0">
													<TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="#aaaaaa" VerticalAlignment="Center"/>
													<TextBlock Text="{Binding Dimensions}" FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</ScrollViewer>
					</Panel>

					<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15" Spacing="10">
						<Button x:Name="btnDelete" Click="BtnDelete_Click" Padding="15,10" CornerRadius="20" Background="#442222" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="✖" FontSize="16" VerticalAlignment="Center" Foreground="#ff4444"/>
								<TextBlock Text="{DynamicResource BtnDelete}" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="btnRotate" Click="BtnRotate_Click" Padding="15,10" CornerRadius="20" Background="#2d2d2d" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="↻" FontSize="16" VerticalAlignment="Center"/>
								<TextBlock Text="{DynamicResource BtnRotate}" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="btnRefine" Click="BtnRefine_Click" Padding="15,10" CornerRadius="20" Background="#2d2d2d" ToolTip.Tip="{DynamicResource TipRefine}" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="✨" FontSize="16" VerticalAlignment="Center"/>
								<TextBlock Text="{DynamicResource BtnRefine}" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
		</DockPanel>

		<!-- Refine Overlay -->
		<Panel x:Name="pnlRefineOverlay" Background="#E0000000" IsVisible="False" ZIndex="100">
			<Grid RowDefinitions="*, Auto" Margin="50">
				<Border Grid.Row="0" Margin="20" CornerRadius="8" ClipToBounds="True" Background="#111111" BorderBrush="#333333" BorderThickness="1">
					<Panel x:Name="pnlRefineImage" Background="Transparent"
						   PointerPressed="PnlRefine_PointerPressed"
						   PointerMoved="PnlRefine_PointerMoved"
						   PointerReleased="PnlRefine_PointerReleased">
						<Image x:Name="imgRefine" Stretch="Uniform" Margin="20"
							   VerticalAlignment="Center" HorizontalAlignment="Center"/>
						<Canvas x:Name="cnvRefineCrop" Background="Transparent" IsHitTestVisible="False">
							<Rectangle x:Name="rectRefineCrop" Stroke="#3399ff" StrokeThickness="2" Fill="#333399ff" IsVisible="False"/>
						</Canvas>
					</Panel>
				</Border>
				<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30" Margin="20">
					<Button x:Name="btnAcceptRefine" Click="BtnAcceptRefine_Click" Padding="40,15" CornerRadius="8" Background="#2d882d" Focusable="False">
						<TextBlock Text="{DynamicResource BtnAccept}" FontSize="18" FontWeight="Bold"/>
					</Button>
					<Button x:Name="btnRejectRefine" Click="BtnRejectRefine_Click" Padding="40,15" CornerRadius="8" Background="#882d2d" Focusable="False">
						<TextBlock Text="{DynamicResource BtnReject}" FontSize="18" FontWeight="Bold"/>
					</Button>
				</StackPanel>
			</Grid>
		</Panel>
		<!-- Loading Overlay -->
		<Panel x:Name="pnlLoadingOverlay" Background="#90000000" IsVisible="False" ZIndex="200">
			<Border Background="#252525" BorderBrush="#3f3f3f" BorderThickness="1" CornerRadius="10" Padding="30,25" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320">
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
					<ProgressBar IsIndeterminate="True" Width="240" Height="8" Foreground="#3399ff"/>
					<TextBlock x:Name="txtLoadingText" Text="{DynamicResource ProcessingScan}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
					<Button x:Name="btnCancelLoading" Click="BtnCancelLoading_Click" IsVisible="False" Padding="16,6" Background="#3a3a3a" Foreground="#ff8888" CornerRadius="6" HorizontalAlignment="Center" Focusable="False">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Text="✖" FontSize="11"/>
							<TextBlock Text="{DynamicResource BtnCancel}" FontSize="12" FontWeight="SemiBold"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Border>
		</Panel>

		<!-- Help Overlay -->
		<Panel x:Name="pnlHelpOverlay" Background="#F0121212" IsVisible="False" ZIndex="300">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="50" MaxWidth="800" Spacing="30">
					<TextBlock Text="{DynamicResource HeaderHelp}" FontSize="32" FontWeight="Bold" Foreground="#3399ff" HorizontalAlignment="Center"/>
					
					<Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" Margin="0,20">
						<StackPanel Grid.Row="0" Grid.Column="0" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource BtnOpenScans}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpOpenScans}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="0" Grid.Column="1" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource BtnSaveResults}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpSaveResults}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="1" Grid.Column="0" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource LblDetectionSensitivity}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpSensitivity}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="1" Grid.Column="1" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource HeaderOriginal}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpManualCrop}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="2" Grid.Column="0" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource BtnRefine}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpRefine}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="2" Grid.Column="1" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource LblZoom}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpZoom}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="3" Grid.Column="0" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource HelpDragDropTitle}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpDragDrop}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="3" Grid.Column="1" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource HelpDpiTitle}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpDpi}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="4" Grid.Column="0" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource HelpAutoOrientTitle}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpAutoOrientDesc}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="4" Grid.Column="1" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource HelpRestoreColorsTitle}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpRestoreColorsDesc}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="5" Grid.Column="0" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource HelpRemoveDustTitle}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpRemoveDustDesc}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
						<StackPanel Grid.Row="5" Grid.Column="1" Margin="10" Spacing="5">
							<TextBlock Text="{DynamicResource HelpAutoTuneTitle}" FontWeight="Bold" Foreground="#3399ff"/>
							<TextBlock Text="{DynamicResource HelpAutoTuneDesc}" TextWrapping="Wrap" Foreground="#aaaaaa"/>
						</StackPanel>
					</Grid>

					<Border Background="#1e1e1e" Padding="20" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
						<StackPanel Spacing="15">
							<TextBlock Text="{DynamicResource HelpShortcutsTitle}" FontSize="20" FontWeight="Bold"/>
							<UniformGrid Columns="2">
								<TextBlock Text="{DynamicResource HelpShortcutScan}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutAutoTune}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutRotate}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutDelete}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutDeleteScan}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutNextScan}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutNextPhoto}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutCompare}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutRefine}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutToggleView}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutUndo}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutRedo}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutSave}" Margin="5"/>
								<TextBlock Text="{DynamicResource HelpShortcutClose}" Margin="5"/>
							</UniformGrid>
						</StackPanel>
					</Border>

					<StackPanel Spacing="5" HorizontalAlignment="Center">
						<TextBlock Text="{DynamicResource HelpAboutTitle}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#3399ff"/>
						<TextBlock Text="{DynamicResource HelpAboutDescription}" HorizontalAlignment="Center" Foreground="#aaaaaa" TextAlignment="Center"/>
						<StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0,10,0,0">
							<TextBlock Text="{DynamicResource HelpVersion}" Foreground="#888888" FontSize="12"/>
							<TextBlock Text="{DynamicResource HelpAuthor}" Foreground="#888888" FontSize="12" FontWeight="Bold"/>
						</StackPanel>
						<TextBlock Text="{DynamicResource HelpPoweredBy}" Foreground="#888888" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
						<TextBlock Text="{DynamicResource HelpModelLicense}" Foreground="#777777" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
						<TextBlock Text="{DynamicResource HelpCopyright}" Foreground="#555555" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
					</StackPanel>

					<Button x:Name="btnCloseHelp" Click="BtnCloseHelp_Click" HorizontalAlignment="Center" Padding="40,15" CornerRadius="8" Background="#3399ff" Focusable="False">
						<TextBlock Text="{DynamicResource BtnClose}" FontSize="18" FontWeight="Bold" Foreground="White"/>
					</Button>
				</StackPanel>
			</ScrollViewer>
		</Panel>

		<!-- Scanner Configuration Modal Overlay -->
		<Panel x:Name="pnlScannerOverlay" Background="#A0000000" IsVisible="False" ZIndex="350">
			<Border Background="#252525" BorderBrush="#3f3f3f" BorderThickness="1" CornerRadius="12" Padding="25" 
					HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Margin="20">
				<StackPanel Spacing="16">
					<!-- Modal Header -->
					<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
						<Border Background="#1b3a26" CornerRadius="20" Width="40" Height="40">
							<TextBlock Text="🖨️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<StackPanel VerticalAlignment="Center">
							<TextBlock Text="{DynamicResource TitleScannerConfig}" FontSize="18" FontWeight="Bold" Foreground="#33bb66"/>
							<TextBlock Text="{DynamicResource DescScannerConfig}" FontSize="11" Foreground="#888888" TextWrapping="Wrap" MaxWidth="360"/>
						</StackPanel>
					</StackPanel>

					<Rectangle Height="1" Fill="#333333" Margin="0,2"/>

					<!-- Scanner Device Selection -->
					<StackPanel Spacing="6">
						<TextBlock Text="{DynamicResource LblScannerDevice}" FontSize="11" FontWeight="SemiBold" Foreground="#cccccc"/>
						<Grid ColumnDefinitions="*, Auto">
							<ComboBox Grid.Column="0" x:Name="cbScanner" HorizontalAlignment="Stretch" SelectionChanged="CbScanner_SelectionChanged" Focusable="False" FontSize="12"/>
							<Button Grid.Column="1" x:Name="btnRefreshScanners" Click="BtnRefreshScanners_Click" Margin="8,0,0,0" Padding="8,6" Background="#383838" VerticalAlignment="Center" Focusable="False" ToolTip.Tip="{DynamicResource BtnRefreshScanners}" CornerRadius="4">
								<TextBlock Text="🔄"/>
							</Button>
						</Grid>
						<TextBlock x:Name="txtScannerStatus" Text="" FontSize="10" Foreground="#888888" Margin="2,0"/>
					</StackPanel>

					<!-- Resolution (DPI) -->
					<StackPanel Spacing="6">
						<TextBlock Text="{DynamicResource LblScannerResolution}" FontSize="11" FontWeight="SemiBold" Foreground="#cccccc"/>
						<ComboBox x:Name="cbScannerDpi" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="CbScannerDpi_SelectionChanged" Focusable="False" FontSize="12">
							<ComboBoxItem Content="150 (Draft / Fast)"/>
							<ComboBoxItem Content="300 (Standard Photos - Recommended)"/>
							<ComboBoxItem Content="600 (High Detail / Archival)"/>
						</ComboBox>
					</StackPanel>

					<!-- Network Scanners Checkbox -->
					<CheckBox x:Name="chkNetworkScanners" Content="{DynamicResource LblNetworkScanners}" ToolTip.Tip="{DynamicResource TipNetworkScanners}" IsCheckedChanged="ChkNetworkScanners_IsCheckedChanged" FontSize="11" Focusable="False"/>

					<Rectangle Height="1" Fill="#333333" Margin="0,2"/>

					<!-- Action Buttons -->
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
						<Button x:Name="btnCancelScannerConfig" Click="BtnCancelScannerConfig_Click" Padding="16,8" Background="#333333" Foreground="White" CornerRadius="6" Focusable="False">
							<TextBlock Text="{DynamicResource BtnCancel}"/>
						</Button>
						<Button x:Name="btnSaveScannerConfig" Click="BtnSaveScannerConfig_Click" Padding="16,8" Background="#3a4a5a" Foreground="White" CornerRadius="6" Focusable="False">
							<TextBlock Text="{DynamicResource BtnSaveSettings}"/>
						</Button>
						<Button x:Name="btnSaveAndScan" Click="BtnSaveAndScan_Click" Padding="20,8" Background="#28a745" Foreground="White" CornerRadius="6" FontWeight="SemiBold" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="🖨️"/>
								<TextBlock Text="{DynamicResource BtnSaveAndScan}"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Panel>

		<!-- Error / Alert Modal Overlay -->
		<Panel x:Name="pnlErrorOverlay" Background="#A0000000" IsVisible="False" ZIndex="400">
			<Border Background="#252525" BorderBrush="#ff4444" BorderThickness="1" CornerRadius="12" Padding="25" 
					HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="20">
				<StackPanel Spacing="18">
					<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
						<Border Background="#3a1a1a" CornerRadius="20" Width="40" Height="40">
							<TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock x:Name="txtErrorTitle" Text="{DynamicResource TitleScannerError}" FontSize="18" FontWeight="Bold" Foreground="#ff6666" VerticalAlignment="Center"/>
					</StackPanel>

					<TextBlock x:Name="txtErrorMessage" Text="An error occurred while communicating with the scanner." 
							   TextWrapping="Wrap" Foreground="#cccccc" FontSize="13" LineHeight="20"/>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
						<Button x:Name="btnErrorRefresh" Click="BtnErrorRefresh_Click" Padding="16,8" Background="#333333" Foreground="White" CornerRadius="6" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="🔄"/>
								<TextBlock Text="{DynamicResource BtnRefreshScanners}"/>
							</StackPanel>
						</Button>
						<Button x:Name="btnCloseError" Click="BtnCloseError_Click" Padding="20,8" Background="#3399ff" Foreground="White" CornerRadius="6" FontWeight="SemiBold" Focusable="False">
							<TextBlock Text="{DynamicResource BtnOk}"/>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Panel>

	</Grid>
</Window>
