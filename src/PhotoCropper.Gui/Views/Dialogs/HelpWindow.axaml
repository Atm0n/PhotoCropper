<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PhotoCropper.Gui.Dialogs.HelpWindow"
        Title="PhotoCropper - Help &amp; Shortcuts"
        Icon="avares://PhotoCropper.Gui/Assets/app_icon.png"
        Width="820"
        Height="680"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextPrimaryBrush}">

	<Grid RowDefinitions="*, Auto">
		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="35,25" MaxWidth="780" Spacing="25">
				<TextBlock Text="{DynamicResource HeaderHelp}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
				
				<Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" Margin="0,10">
					<StackPanel Grid.Row="0" Grid.Column="0" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource BtnOpenScans}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpOpenScans}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="0" Grid.Column="1" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource BtnSaveResults}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpSaveResults}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="1" Grid.Column="0" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource LblDetectionSensitivity}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpSensitivity}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="1" Grid.Column="1" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HeaderOriginal}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpManualCrop}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="2" Grid.Column="0" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource BtnRefine}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpRefine}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="2" Grid.Column="1" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource LblZoom}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpZoom}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="3" Grid.Column="0" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HelpDragDropTitle}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpDragDrop}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="3" Grid.Column="1" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HelpDpiTitle}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpDpi}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="0" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HelpAutoOrientTitle}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpAutoOrientDesc}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="1" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HelpRestoreColorsTitle}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpRestoreColorsDesc}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="5" Grid.Column="0" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HelpRemoveDustTitle}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpRemoveDustDesc}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="5" Grid.Column="1" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HelpAutoTuneTitle}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpAutoTuneDesc}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="6" Grid.Column="0" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HelpThemeTitle}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpThemeDesc}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="6" Grid.Column="1" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HelpSafeExitTitle}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpSafeExitDesc}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="7" Grid.Column="0" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HelpNamingTitle}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpNamingDesc}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
					<StackPanel Grid.Row="7" Grid.Column="1" Margin="10" Spacing="5">
						<TextBlock Text="{DynamicResource HelpMetadataTitle}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
						<TextBlock Text="{DynamicResource HelpMetadataDesc}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
					</StackPanel>
				</Grid>

				<Border Background="{DynamicResource AppCardBackgroundBrush}" Padding="20" CornerRadius="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
					<StackPanel Spacing="15">
						<TextBlock Text="{DynamicResource HelpShortcutsTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
						<UniformGrid Columns="2">
							<TextBlock Text="{DynamicResource HelpShortcutScan}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutAutoTune}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutRotate}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutDelete}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutDeleteScan}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutNextScan}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutNextPhoto}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutCompare}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutRefine}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutToggleView}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutSelectAll}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutUndo}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutRedo}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutSave}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutClose}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource HelpShortcutF1}" Margin="5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
						</UniformGrid>
					</StackPanel>
				</Border>

				<StackPanel Spacing="5" HorizontalAlignment="Center">
					<TextBlock Text="{DynamicResource HelpAboutTitle}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
					<TextBlock Text="{DynamicResource HelpAboutDescription}" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" TextAlignment="Center"/>
					<StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0,10,0,0">
						<TextBlock x:Name="txtAppVersion" Text="{DynamicResource HelpVersion}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="12"/>
						<TextBlock Text="{DynamicResource HelpAuthor}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="12" FontWeight="Bold"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
						<Button x:Name="btnCheckUpdates" Click="BtnCheckUpdates_Click" Padding="12,4" CornerRadius="4" Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="🔄" FontSize="11" VerticalAlignment="Center"/>
								<TextBlock Text="{DynamicResource BtnCheckUpdates}" FontSize="11" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="btnOpenRelease" Click="BtnOpenRelease_Click" IsVisible="False" Padding="12,4" CornerRadius="4" Background="{DynamicResource AppAccentBrush}" Foreground="White" Focusable="False">
							<TextBlock Text="{DynamicResource BtnOpenReleasePage}" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
						</Button>
					</StackPanel>
					<TextBlock x:Name="txtUpdateStatus" Text="" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>

					<TextBlock Text="{DynamicResource HelpPoweredBy}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
					<TextBlock Text="{DynamicResource HelpModelLicense}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
					<TextBlock Text="{DynamicResource HelpCopyright}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<!-- Bottom Action Bar -->
		<Border Grid.Row="1" Background="{DynamicResource AppFooterBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="15,10">
			<Button x:Name="btnClose" Click="BtnClose_Click" HorizontalAlignment="Center" Padding="35,10" CornerRadius="6" Background="{DynamicResource AppAccentBrush}" Foreground="White" Focusable="False">
				<TextBlock Text="{DynamicResource BtnClose}" FontSize="15" FontWeight="Bold" Foreground="White"/>
			</Button>
		</Border>
	</Grid>
</Window>
