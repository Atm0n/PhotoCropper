<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoCropper.Gui.ViewModels"
             x:Class="PhotoCropper.Gui.Views.Overlays.ReviewView"
             x:DataType="vm:ReviewViewModel"
             Background="{DynamicResource AppOverlayScrimBrush}"
             PointerWheelChanged="OnPointerWheelChanged" DoubleTapped="OnDoubleTapped">
	<Grid RowDefinitions="Auto, *, Auto" Margin="30,20">
		<!-- Header Bar -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="10,0,10,10">
			<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
				<Border Background="{DynamicResource AppAccentBrush}" CornerRadius="6" Padding="8,4">
					<TextBlock Text="🔍" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
				</Border>
				<StackPanel VerticalAlignment="Center" Spacing="2">
					<TextBlock Text="{DynamicResource TitleReviewMode}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
					<TextBlock x:Name="txtReviewScanInfo" Text="{Binding ScanInfoText}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
				</StackPanel>
			</StackPanel>

			<Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,4">
				<TextBlock x:Name="txtReviewCounter" Text="{Binding CounterText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
			</Border>

			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
				<Button x:Name="btnReviewEdit" Command="{Binding CloseCommand}" Padding="12,6" Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Focusable="False" ToolTip.Tip="{DynamicResource TipReviewEdit}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<TextBlock Text="&#x270F;&#xFE0F;" FontSize="12" VerticalAlignment="Center"/>
						<TextBlock Text="{DynamicResource BtnReviewEdit}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button x:Name="btnReviewClose" Command="{Binding CloseCommand}" Padding="12,6" Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Focusable="False" ToolTip.Tip="Close Review (Esc)">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<TextBlock Text="✕" FontSize="12" VerticalAlignment="Center"/>
						<TextBlock Text="Close" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<!-- Center Photo Preview with Nav Arrows -->
		<Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto">
			<Button Grid.Column="0" x:Name="btnReviewPrev" Command="{Binding PreviousCommand}" VerticalAlignment="Center" Margin="0,0,15,0"
					Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Width="48" Height="96" CornerRadius="8" Focusable="False" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ToolTip.Tip="Previous Photo (← / Left)">
				<TextBlock Text="◀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Button>

			<Panel Grid.Column="1">
				<!-- Normal photo view -->
				<Border x:Name="brdReviewPhoto" IsVisible="{Binding !IsAtEnd}" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource AppWorkspaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
					<Image x:Name="imgReview" Source="{Binding Image}" Stretch="Uniform" Margin="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
				</Border>

				<!-- Sentinel: end-of-loop marker — shown when navigating past the last photo -->
				<Border x:Name="pnlReviewSentinel" IsVisible="{Binding IsAtEnd}" CornerRadius="8"
						Background="{DynamicResource AppWorkspaceBrush}"
						BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2">
					<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
						<Border Background="{DynamicResource AppAccentBrush}" CornerRadius="60" Width="80" Height="80" HorizontalAlignment="Center">
							<TextBlock Text="&#x21BB;" FontSize="40" FontWeight="Bold" Foreground="White"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock x:Name="txtSentinelTitle" Text="{DynamicResource ReviewSentinelTitle}"
								   FontSize="22" FontWeight="Bold"
								   Foreground="{DynamicResource AppTextPrimaryBrush}"
								   HorizontalAlignment="Center" TextAlignment="Center"/>
						<TextBlock x:Name="txtSentinelSubtitle" Text="{DynamicResource ReviewSentinelSubtitle}"
								   FontSize="14" Foreground="{DynamicResource AppTextSecondaryBrush}"
								   HorizontalAlignment="Center" TextAlignment="Center"/>
						<Border Background="{DynamicResource AppCardBackgroundBrush}"
								BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
								CornerRadius="20" Padding="18,8" HorizontalAlignment="Center">
							<TextBlock x:Name="txtSentinelStats" Text="{Binding EndStatsText}"
									   FontSize="13" Foreground="{DynamicResource AppAccentBrush}"
									   FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
						</Border>
						<TextBlock Text="[&#x2190;] Last Photo  |  [&#x2192;] Back to First"
								   FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}"
								   HorizontalAlignment="Center" TextAlignment="Center"/>
					</StackPanel>
				</Border>
			</Panel>

			<Button Grid.Column="2" x:Name="btnReviewNext" Command="{Binding NextCommand}" VerticalAlignment="Center" Margin="15,0,0,0"
					Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Width="48" Height="96" CornerRadius="8" Focusable="False" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ToolTip.Tip="Next Photo (→ / Right / Space)">
				<TextBlock Text="▶" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Button>
		</Grid>

		<!-- Bottom Action Controls -->
		<Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="10,15,10,0">
			<Button Grid.Column="0" x:Name="btnReviewDelete" Command="{Binding DeleteCommand}" Padding="16,10" CornerRadius="8" Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}" Focusable="False" ToolTip.Tip="Delete Photo (Del / X)">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<TextBlock Text="🗑️" FontSize="15" VerticalAlignment="Center"/>
					<TextBlock Text="{DynamicResource BtnDelete}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<!-- Shortcut Tips -->
			<StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="Shortcuts: [R] Rotate 90° CW | [L] Rotate 90° CCW | [←/→/Space] Navigate | [Del/X] Delete | [Esc] Exit" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
			</StackPanel>

			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
				<Button x:Name="btnReviewRotateCcw" Command="{Binding RotateCounterClockwiseCommand}" Padding="16,10" CornerRadius="8" Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Focusable="False" ToolTip.Tip="Rotate 90° Counter-Clockwise (L)">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Text="↺" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
						<TextBlock Text="90° CCW" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button x:Name="btnReviewRotateCw" Command="{Binding RotateClockwiseCommand}" Padding="18,10" CornerRadius="8" Background="{DynamicResource AppButtonActionBrush}" Foreground="{DynamicResource AppButtonActionTextBrush}" Focusable="False" ToolTip.Tip="Rotate 90° Clockwise (R)">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Text="↻" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
						<TextBlock Text="{DynamicResource BtnRotate}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
