<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoCropper.Gui.ViewModels"
             xmlns:controls="using:PhotoCropper.Gui.Controls"
             x:Class="PhotoCropper.Gui.Views.Stages.ScanStageView"
             x:DataType="vm:ScanStageViewModel">
	<Border Margin="10,0,10,10" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="8"
			BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
		<Grid RowDefinitions="Auto, *" Margin="16">
			<!-- Actions -->
			<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
				<!-- Scan, with the scanner settings attached to it -->
				<Border Background="{DynamicResource AppButtonAccentBrush}" CornerRadius="6">
					<StackPanel Orientation="Horizontal">
						<Button Command="{Binding ScanCommand}" Padding="16,8" CornerRadius="6,0,0,6" Background="Transparent" BorderThickness="0"
								Foreground="{DynamicResource AppButtonAccentTextBrush}" ToolTip.Tip="{DynamicResource TipScanF5}">
							<TextBlock Text="{DynamicResource BtnScanStage}" FontWeight="SemiBold"/>
						</Button>
						<Rectangle Width="1" Fill="{DynamicResource AppButtonAccentTextBrush}" Opacity="0.35" Margin="0,6"/>
						<Button Command="{Binding ConfigureScannerCommand}" Padding="10,8" CornerRadius="0,6,6,0" Background="Transparent" BorderThickness="0"
								Foreground="{DynamicResource AppButtonAccentTextBrush}" ToolTip.Tip="{DynamicResource MenuScannerSettings}">
							<TextBlock Text="⚙️" FontSize="13" VerticalAlignment="Center"/>
						</Button>
					</StackPanel>
				</Border>
				<Button Command="{Binding ImportScansCommand}" Padding="16,8" CornerRadius="6"
						Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}">
					<TextBlock Text="{DynamicResource BtnImportScans}"/>
				</Button>
				<TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="10,0,0,0"
						   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
			</StackPanel>

			<!-- Empty state -->
			<Border Grid.Row="1" IsVisible="{Binding IsEmpty}" Background="{DynamicResource AppEmptyStateBrush}" CornerRadius="6">
				<TextBlock Text="{DynamicResource ScanStageEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
						   TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
			</Border>

			<!-- The selected scan, large, beside the list of scans: check each page as it arrives, then rescan or discard it -->
			<Grid Grid.Row="1" IsVisible="{Binding !IsEmpty}" ColumnDefinitions="*, 12, 300">
				<Border Grid.Column="0" Background="{DynamicResource AppPhotoCardBrush}" CornerRadius="8"
						BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
					<Grid RowDefinitions="*, Auto">
						<controls:ScanPreview x:Name="scanPreview" Grid.Row="0" Margin="12" Cursor="Hand"
											  Source="{Binding Preview}" Boxes="{Binding PreviewBoxes}"
											  DoubleTapped="Preview_DoubleTapped" ToolTip.Tip="{DynamicResource TipScanPreview}"/>
						<Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="14,0,14,12" IsVisible="{Binding HasSelection}">
							<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
								<TextBlock Text="{Binding SelectedFileName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
								<TextBlock Text="{Binding PreviewStatus}" FontSize="13" VerticalAlignment="Center"
										   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
								<Button Command="{Binding RescanCommand}" CommandParameter="{Binding SelectedScan}" Padding="14,7" CornerRadius="6"
										ToolTip.Tip="{DynamicResource TipRescan}"
										Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}">
									<TextBlock Text="{DynamicResource BtnRescan}" FontSize="13"/>
								</Button>
								<Button Command="{Binding DiscardCommand}" CommandParameter="{Binding SelectedScan}" Padding="14,7" CornerRadius="6"
										ToolTip.Tip="{DynamicResource TipDiscardScan}"
										Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}">
									<Panel>
										<TextBlock Text="{DynamicResource BtnDiscardScan}" FontSize="13" IsVisible="{Binding !IsSelectedConfirmingDiscard}"/>
										<TextBlock Text="{DynamicResource BtnConfirmDiscard}" FontSize="13" FontWeight="Bold" IsVisible="{Binding IsSelectedConfirmingDiscard}"/>
									</Panel>
								</Button>
								<Button Command="{Binding OpenScanCommand}" CommandParameter="{Binding SelectedScan}" Padding="14,7" CornerRadius="6"
										Background="{DynamicResource AppButtonAccentBrush}" Foreground="{DynamicResource AppButtonAccentTextBrush}">
									<TextBlock Text="{DynamicResource BtnAdjustCrops}" FontSize="13" FontWeight="SemiBold"/>
								</Button>
							</StackPanel>
						</Grid>
					</Grid>
				</Border>

				<!-- All scans; the newest is selected as soon as it is scanned -->
				<ListBox Grid.Column="2" x:Name="lstScans" ItemsSource="{Binding Scans}" SelectedItem="{Binding SelectedScan}"
						 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
					<ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Padding" Value="6"/>
							<Setter Property="Margin" Value="0,0,0,6"/>
							<Setter Property="CornerRadius" Value="6"/>
						</Style>
					</ListBox.Styles>
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ScanRowViewModel">
							<Grid ColumnDefinitions="90, *" DoubleTapped="ScanRow_DoubleTapped" Background="Transparent">
								<Border Grid.Column="0" Height="110" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="4">
									<Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
								</Border>
								<StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="4">
									<TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
									<StackPanel Orientation="Horizontal" Spacing="4">
										<TextBlock Text="⚠" IsVisible="{Binding IsFlagged}" Foreground="{DynamicResource AppDangerTextBrush}"/>
										<TextBlock Text="{Binding PhotosText}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
									</StackPanel>
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</Grid>
	</Border>
</UserControl>
