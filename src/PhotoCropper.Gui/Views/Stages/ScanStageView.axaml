<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoCropper.Gui.ViewModels"
             x:Class="PhotoCropper.Gui.Views.Stages.ScanStageView"
             x:DataType="vm:ScanStageViewModel">
	<Border Margin="10,0,10,10" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="8"
			BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
		<Grid RowDefinitions="Auto, *" Margin="16">
			<!-- Actions -->
			<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
				<Button Command="{Binding ScanCommand}" Padding="16,8" CornerRadius="6"
						Background="{DynamicResource AppButtonAccentBrush}" Foreground="{DynamicResource AppButtonAccentTextBrush}">
					<TextBlock Text="{DynamicResource BtnScanStage}" FontWeight="SemiBold"/>
				</Button>
				<Button Command="{Binding ImportScansCommand}" Padding="16,8" CornerRadius="6"
						Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}">
					<TextBlock Text="{DynamicResource BtnImportScans}"/>
				</Button>
				<TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="10,0,0,0"
						   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
			</StackPanel>

			<!-- Empty state -->
			<Border Grid.Row="1" IsVisible="{Binding IsEmpty}" Background="{DynamicResource AppEmptyStateBrush}" CornerRadius="6">
				<TextBlock Text="{DynamicResource ScanStageEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
						   TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
			</Border>

			<!-- Scans as cards: see each one, then rescan or discard it while scanning -->
			<ScrollViewer Grid.Row="1" x:Name="scrollScans" IsVisible="{Binding !IsEmpty}" HorizontalScrollBarVisibility="Disabled">
				<ItemsControl x:Name="lstScans" ItemsSource="{Binding Scans}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ScanRowViewModel">
							<Border Width="340" Margin="6" Padding="10" CornerRadius="8"
									Background="{DynamicResource AppPhotoCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
								<StackPanel Spacing="6">
									<!-- Thumbnail; double-click opens the scan's crops -->
									<Border Height="240" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="4" Cursor="Hand"
											DoubleTapped="ScanCard_DoubleTapped">
										<Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
									</Border>
									<Grid ColumnDefinitions="*, Auto, Auto">
										<TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
										<TextBlock Grid.Column="1" Text="⚠" Margin="6,0" VerticalAlignment="Center"
												   IsVisible="{Binding IsFlagged}" Foreground="{DynamicResource AppDangerTextBrush}"/>
										<TextBlock Grid.Column="2" Text="{Binding PhotosText}" VerticalAlignment="Center" FontSize="12"
												   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
									</Grid>
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Button Command="{Binding $parent[ItemsControl].((vm:ScanStageViewModel)DataContext).OpenScanCommand}"
												CommandParameter="{Binding}" Padding="10,5" CornerRadius="5"
												Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}">
											<TextBlock Text="{DynamicResource BtnAdjustCrops}" FontSize="12"/>
										</Button>
										<Button Command="{Binding $parent[ItemsControl].((vm:ScanStageViewModel)DataContext).RescanCommand}"
												CommandParameter="{Binding}" Padding="10,5" CornerRadius="5"
												ToolTip.Tip="{DynamicResource TipRescan}"
												Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}">
											<TextBlock Text="{DynamicResource BtnRescan}" FontSize="12"/>
										</Button>
										<Button Command="{Binding $parent[ItemsControl].((vm:ScanStageViewModel)DataContext).DiscardCommand}"
												CommandParameter="{Binding}" Padding="10,5" CornerRadius="5"
												ToolTip.Tip="{DynamicResource TipDiscardScan}"
												Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}">
											<Panel>
												<TextBlock Text="{DynamicResource BtnDiscardScan}" FontSize="12" IsVisible="{Binding !IsConfirmingDiscard}"/>
												<TextBlock Text="{DynamicResource BtnConfirmDiscard}" FontSize="12" FontWeight="Bold" IsVisible="{Binding IsConfirmingDiscard}"/>
											</Panel>
										</Button>
									</StackPanel>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Border>
</UserControl>
