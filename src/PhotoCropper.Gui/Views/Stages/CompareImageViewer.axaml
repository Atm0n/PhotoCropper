<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="using:PhotoCropper.Gui.Controls"
			 x:Class="PhotoCropper.Gui.Views.Stages.CompareImageViewer">
	<!-- A zoomable, pannable image with a before/after split. All interaction is in the code-behind. -->
	<Grid x:Name="pnlViewport" Background="Transparent" ClipToBounds="True" Focusable="True"
		  PointerPressed="Viewport_PointerPressed" PointerMoved="Viewport_PointerMoved"
		  PointerReleased="Viewport_PointerReleased" PointerExited="Viewport_PointerExited"
		  PointerWheelChanged="Viewport_PointerWheelChanged" PointerCaptureLost="Viewport_PointerCaptureLost">
		<!-- The photo, at its pixel size, moved and scaled by a render transform -->
		<Canvas>
			<Panel x:Name="pnlContent" RenderTransformOrigin="0,0">
				<Image x:Name="imgAfter" Stretch="Fill"/>
				<Image x:Name="imgBefore" Stretch="Fill"/>
				<Canvas x:Name="cnvStrokes" IsHitTestVisible="False">
					<Ellipse x:Name="ellBrushCursor" Stroke="White" IsVisible="False" Opacity="0.9"/>
				</Canvas>
			</Panel>
		</Canvas>

		<!-- The trim: what the final photo leaves out is shaded; in adjust mode its edges can be dragged (screen space) -->
		<Canvas x:Name="cnvTrim" IsHitTestVisible="False" IsVisible="False">
			<Rectangle x:Name="rectShadeTop" Fill="#A6000000"/>
			<Rectangle x:Name="rectShadeBottom" Fill="#A6000000"/>
			<Rectangle x:Name="rectShadeLeft" Fill="#A6000000"/>
			<Rectangle x:Name="rectShadeRight" Fill="#A6000000"/>
			<Rectangle x:Name="rectTrim" Stroke="White" StrokeThickness="1.5" StrokeDashArray="4,3"/>
			<Border x:Name="bdrTrimLeft" Width="8" Height="34" CornerRadius="3" Background="White" BorderBrush="#333" BorderThickness="1"/>
			<Border x:Name="bdrTrimRight" Width="8" Height="34" CornerRadius="3" Background="White" BorderBrush="#333" BorderThickness="1"/>
			<Border x:Name="bdrTrimTop" Width="34" Height="8" CornerRadius="3" Background="White" BorderBrush="#333" BorderThickness="1"/>
			<Border x:Name="bdrTrimBottom" Width="34" Height="8" CornerRadius="3" Background="White" BorderBrush="#333" BorderThickness="1"/>
		</Canvas>

		<!-- Split divider, drawn in screen space so it stays thin at any zoom -->
		<Canvas IsHitTestVisible="False">
			<Rectangle x:Name="rectDivider" Width="2" Fill="White" Opacity="0.95" IsVisible="False"/>
			<Border x:Name="bdrDividerHandle" Width="30" Height="30" CornerRadius="15" Background="White" IsVisible="False"
					BoxShadow="0 1 4 0 #60000000">
				<TextBlock Text="◀▶" FontSize="10" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>
		</Canvas>

		<!-- Zoomed view while a trim edge is dragged; moves aside when the pointer comes near -->
		<controls:Magnifier x:Name="magnifier" Width="200" Height="200" Margin="10"
							HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="False"/>

		<Border x:Name="bdrBeforeLabel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,3"
				CornerRadius="4" Background="#99000000" IsHitTestVisible="False" IsVisible="False">
			<TextBlock Text="{DynamicResource LblBefore}" Foreground="White" FontSize="11"/>
		</Border>
		<Border x:Name="bdrAfterLabel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,3"
				CornerRadius="4" Background="#99000000" IsHitTestVisible="False" IsVisible="False">
			<TextBlock Text="{DynamicResource LblAfter}" Foreground="White" FontSize="11"/>
		</Border>
	</Grid>
</UserControl>
