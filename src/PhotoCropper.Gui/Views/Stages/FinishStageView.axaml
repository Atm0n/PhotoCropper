<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoCropper.Gui.ViewModels"
             x:Class="PhotoCropper.Gui.Views.Stages.FinishStageView"
             x:DataType="vm:FinishStageViewModel">
	<Border Margin="10,0,10,10" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="8"
			BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
		<Grid RowDefinitions="Auto, *" Margin="16">
			<!-- Actions -->
			<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12" IsVisible="{Binding HasProject}">
				<Button Command="{Binding ExportCommand}" Padding="16,8" CornerRadius="6"
						Background="{DynamicResource AppButtonAccentBrush}" Foreground="{DynamicResource AppButtonAccentTextBrush}">
					<TextBlock Text="{DynamicResource BtnExportFinal}" FontWeight="SemiBold"/>
				</Button>
				<Button Command="{Binding ImportPhotosCommand}" Padding="12,8" CornerRadius="6"
						Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}">
					<TextBlock Text="{DynamicResource BtnImportPhotos}"/>
				</Button>
				<Button Command="{Binding RestoreAllCommand}" Padding="12,8" CornerRadius="6"
						Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}">
					<TextBlock Text="{DynamicResource BtnRestoreAll}"/>
				</Button>
				<Button Command="{Binding RestoreNoneCommand}" Padding="12,8" CornerRadius="6"
						Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}">
					<TextBlock Text="{DynamicResource BtnRestoreNone}"/>
				</Button>
				<Button Command="{Binding OpenFinalFolderCommand}" Padding="12,8" CornerRadius="6"
						Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}">
					<TextBlock Text="{DynamicResource BtnOpenFinalFolder}"/>
				</Button>
				<TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="10,0,0,0"
						   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
			</StackPanel>

			<!-- No project: the pipeline folders only exist inside a project -->
			<Border Grid.Row="1" IsVisible="{Binding !HasProject}" Background="{DynamicResource AppEmptyStateBrush}" CornerRadius="6">
				<TextBlock Text="{DynamicResource FinishNoProject}" HorizontalAlignment="Center" VerticalAlignment="Center"
						   TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
			</Border>

			<!-- Project, but nothing cropped yet -->
			<Border Grid.Row="1" Background="{DynamicResource AppEmptyStateBrush}" CornerRadius="6">
				<Border.IsVisible>
					<MultiBinding Converter="{x:Static BoolConverters.And}">
						<Binding Path="HasProject"/>
						<Binding Path="IsEmpty"/>
					</MultiBinding>
				</Border.IsVisible>
				<TextBlock Text="{DynamicResource FinishEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
						   TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
			</Border>

			<!-- Photo grid (click a photo to preview it) + before/after preview panel -->
			<Grid Grid.Row="1" IsVisible="{Binding !IsEmpty}" ColumnDefinitions="*, Auto">
				<ListBox Grid.Column="0" ItemsSource="{Binding Photos}" SelectedItem="{Binding SelectedPhoto}"
						 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:FinishPhotoViewModel">
							<Border Width="260" Margin="6" Padding="10" CornerRadius="8"
									Background="{DynamicResource AppPhotoCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
								<StackPanel Spacing="6">
									<Image Source="{Binding Thumbnail}" Height="170" Stretch="Uniform"/>
									<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
									<TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
									<CheckBox IsChecked="{Binding RestoreColors}" Content="{DynamicResource LblRestoreColors}"/>
									<CheckBox IsChecked="{Binding RemoveDust}" IsEnabled="{Binding RestoreColors}" Content="{DynamicResource LblRemoveDust}"/>
									<TextBlock Text="{Binding StatusText}" FontSize="11"
											   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<!-- Before / after preview of the selected photo -->
				<Border Grid.Column="1" Width="560" Margin="12,0,0,0" Padding="12" CornerRadius="8" IsVisible="{Binding HasSelection}"
						Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
					<Grid RowDefinitions="Auto, Auto, *, Auto, *, Auto">
						<Grid Grid.Row="0" ColumnDefinitions="*, Auto">
							<TextBlock Text="{Binding SelectedPhoto.Title, FallbackValue=''}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
							<Button Grid.Column="1" Command="{Binding ClosePreviewCommand}" Padding="8,2" Background="Transparent"
									ToolTip.Tip="{DynamicResource TipClosePreview}">
								<TextBlock Text="✕"/>
							</Button>
						</Grid>

						<TextBlock Grid.Row="1" Text="{DynamicResource LblBefore}" Margin="0,8,0,4" FontSize="11"
								   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
						<Border Grid.Row="2" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="4">
							<Image Source="{Binding BeforePreview}" Stretch="Uniform"/>
						</Border>

						<StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,4">
							<TextBlock Text="{DynamicResource LblAfter}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
							<TextBlock Text="{DynamicResource LblUpdatingPreview}" FontSize="11" IsVisible="{Binding IsPreviewBusy}"
									   Foreground="{DynamicResource AppTextMutedBrush}"/>
						</StackPanel>
						<Border Grid.Row="4" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="4">
							<Image Source="{Binding AfterPreview}" Stretch="Uniform"/>
						</Border>

						<!-- The selected photo's settings; changing them updates "After" -->
						<StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
							<CheckBox IsChecked="{Binding SelectedPhoto.RestoreColors, FallbackValue=False}" Content="{DynamicResource LblRestoreColors}"/>
							<CheckBox IsChecked="{Binding SelectedPhoto.RemoveDust, FallbackValue=False}"
									  IsEnabled="{Binding SelectedPhoto.RestoreColors, FallbackValue=False}" Content="{DynamicResource LblRemoveDust}"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Border>
</UserControl>
