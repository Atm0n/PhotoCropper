<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gui="using:PhotoCropper.Gui"
		WindowState="Maximized"
		MinWidth="850"
		MinHeight="550"
        x:Class="PhotoCropper.Gui.MainWindow"
		Background="{DynamicResource AppBackgroundBrush}"
		Foreground="{DynamicResource AppTextPrimaryBrush}"
        Title="PhotoCropper - Intelligent Photo Extractor"
        Icon="avares://PhotoCropper.Gui/Assets/app_icon.png"
        DragDrop.AllowDrop="True">

	<Grid>
		<DockPanel>
			<!-- Hidden Classic Menu Bar (Toggled with ALT key) -->
			<Border x:Name="pnlMenuBar" DockPanel.Dock="Top" Background="{DynamicResource AppToolbarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" IsVisible="False">
				<Menu Background="Transparent" FontSize="12">
					<!-- File Menu -->
					<MenuItem Header="_File">
						<MenuItem Header="{DynamicResource BtnScan}" InputGesture="F5" Click="BtnScan_Click"/>
						<MenuItem Header="{DynamicResource TitleScannerConfig}" Click="BtnScannerConfig_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnOpenScans}" InputGesture="Ctrl+O" Click="BtnOpenFiles_Click"/>
						<MenuItem Header="{DynamicResource BtnSaveResults}" InputGesture="Ctrl+S" Click="BtnSaveImages_Click"/>
						<MenuItem Header="{DynamicResource TitleExportSettings}" InputGesture="Ctrl+Shift+S" Click="BtnSaveSettings_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnWorkDir}" Click="BtnWorkDir_Click"/>
						<MenuItem Header="{DynamicResource BtnNewProject}" Click="BtnNewProject_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnDeleteScan}" InputGesture="Shift+Delete" Click="BtnDeleteScan_Click"/>
						<MenuItem Header="{DynamicResource BtnReset}" Click="BtnReset_Click"/>
						<Separator/>
						<MenuItem Header="Exit" InputGesture="Alt+F4" Click="MenuExit_Click"/>
					</MenuItem>

					<!-- Edit Menu -->
					<MenuItem Header="_Edit">
						<MenuItem Header="Undo" InputGesture="Ctrl+Z" Click="MenuUndo_Click"/>
						<MenuItem Header="Redo" InputGesture="Ctrl+Y" Click="MenuRedo_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnSelectAll}" InputGesture="Ctrl+A" Click="BtnSelectAll_Click"/>
						<MenuItem Header="{DynamicResource BtnClearSelection}" InputGesture="Escape" Click="BtnClearSelection_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnRotate}" InputGesture="R" Click="BtnRotate_Click"/>
						<MenuItem Header="{DynamicResource BtnDelete}" InputGesture="Delete" Click="BtnDelete_Click"/>
						<MenuItem Header="{DynamicResource BtnRefine}" Click="BtnRefine_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnResetBackground}" Click="BtnResetBackground_Click"/>
						<MenuItem Header="{DynamicResource BtnAutoTune}" Click="BtnAutoTune_Click"/>
					</MenuItem>

					<!-- View Menu -->
					<MenuItem Header="_View">
						<MenuItem Header="{DynamicResource ViewCarousel}" Click="MenuViewCarousel_Click"/>
						<MenuItem Header="{DynamicResource ViewGrid}" Click="MenuViewGrid_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnPrevScan}" InputGesture="Up" Click="BtnPrevScan_Click"/>
						<MenuItem Header="{DynamicResource BtnNextScan}" InputGesture="Down" Click="BtnNextScan_Click"/>
						<MenuItem Header="{DynamicResource BtnPreviousCroppedImage}" InputGesture="Left" Click="BtnPreviousCroppedImage_Click"/>
						<MenuItem Header="{DynamicResource BtnNextCroppedImage}" InputGesture="Right" Click="BtnNextCroppedImage_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource TitleExportSettings}" Click="BtnSaveSettings_Click"/>
						<MenuItem Header="{DynamicResource BtnAdvanced}" Click="BtnToggleAdvanced_Click"/>
					</MenuItem>

					<!-- Theme Menu -->
					<MenuItem Header="{DynamicResource MenuTheme}" x:Name="menuAltTheme"/>

					<!-- Detection Box Color Menu -->
					<MenuItem Header="{DynamicResource MenuDetectionColor}" x:Name="menuAltDetectionColor"/>

					<!-- Language Menu -->
					<MenuItem Header="{DynamicResource MenuLanguage}" x:Name="menuAltLanguage"/>

					<!-- Help Menu -->
					<MenuItem Header="_Help">
						<MenuItem Header="{DynamicResource BtnHelp}" InputGesture="F1" Click="BtnHelp_Click"/>
					</MenuItem>
				</Menu>
			</Border>

			<!-- Header / Toolbar -->
		<Border DockPanel.Dock="Top" Background="{DynamicResource AppToolbarBrush}" MinHeight="48" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
			<StackPanel>
				<!-- Responsive Main Toolbar with Grouped Cards -->
				<WrapPanel Orientation="Horizontal" Margin="8,4" VerticalAlignment="Center">
					<!-- Group 1: File Actions (Scan, Open, Save) -->
					<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="4,3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<!-- Scan Button with Config Trigger -->
							<Border Background="#28a745" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="0">
									<Button x:Name="btnScan" Click="BtnScan_Click" Padding="10,5" Background="Transparent" BorderThickness="0" Foreground="White" Focusable="False" ToolTip.Tip="{DynamicResource TipScan}">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="🖨️" FontSize="12" VerticalAlignment="Center"/>
											<TextBlock Text="{DynamicResource BtnScan}" FontWeight="SemiBold" VerticalAlignment="Center"/>
										</StackPanel>
									</Button>
									<Rectangle Width="1" Fill="#3db85a" Margin="0,4"/>
									<Button x:Name="btnScannerConfig" Click="BtnScannerConfig_Click" Padding="6,5" Background="Transparent" BorderThickness="0" Foreground="White" Focusable="False" ToolTip.Tip="{DynamicResource TipScannerConfig}">
										<TextBlock Text="⚙️" FontSize="11" VerticalAlignment="Center"/>
									</Button>
								</StackPanel>
							</Border>
							<Button x:Name="btnOpenFiles" Click="BtnOpenFiles_Click" Padding="10,5" Background="#1c6ec2" Foreground="White" Focusable="False" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="📁" FontSize="12" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource BtnOpenScans}" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<!-- Save Button with Options Trigger -->
							<Border Background="{DynamicResource AppButtonDefaultBrush}" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="0">
									<Button x:Name="btnSave" Click="BtnSaveImages_Click" Padding="10,5" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppButtonDefaultTextBrush}" Focusable="False" ToolTip.Tip="{DynamicResource BtnSaveResults}">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="💾" FontSize="12" VerticalAlignment="Center"/>
											<TextBlock Text="{DynamicResource BtnSaveResults}" VerticalAlignment="Center"/>
										</StackPanel>
									</Button>
									<Rectangle Width="1" Fill="{DynamicResource AppBorderBrush}" Margin="0,4"/>
									<Button x:Name="btnSaveSettings" Click="BtnSaveSettings_Click" Padding="6,5" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppButtonDefaultTextBrush}" Focusable="False" ToolTip.Tip="{DynamicResource TipSaveSettings}">
										<TextBlock Text="⚙️" FontSize="11" VerticalAlignment="Center"/>
									</Button>
								</StackPanel>
							</Border>
						</StackPanel>
					</Border>

					<!-- Group 2: Project Workspace -->
					<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="4,3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<Button x:Name="btnWorkDir" Click="BtnWorkDir_Click" Padding="8,5" Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Focusable="False" ToolTip.Tip="{DynamicResource TipWorkDir}" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
									<TextBlock Text="🗂️" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock x:Name="txtWorkDirBtn" Text="{DynamicResource BtnWorkDir}" FontWeight="SemiBold" MaxWidth="110" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<Button x:Name="btnNewProject" Click="BtnNewProject_Click" Padding="8,5" Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Focusable="False" ToolTip.Tip="{DynamicResource TipNewProject}" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
									<TextBlock Text="➕" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource BtnNewProject}" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>

					<!-- Group 3: Detection Tuning -->
					<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="6,3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<ToggleButton x:Name="tglColorPicker" Click="TglColorPicker_Click" Padding="6,4" Focusable="False" ToolTip.Tip="{DynamicResource BtnSampleBackground}" CornerRadius="4">
								<TextBlock Text="🎨" FontSize="12"/>
							</ToggleButton>
							<Button x:Name="btnResetBackground" Click="BtnResetBackground_Click" Padding="6,4" Focusable="False" IsEnabled="False" ToolTip.Tip="{DynamicResource BtnResetBackground}" CornerRadius="4">
								<TextBlock Text="🔄" FontSize="12"/>
							</Button>

							<Rectangle Width="1" Height="18" Fill="{DynamicResource AppSeparatorBrush}" Margin="2,0"/>

							<TextBlock Text="{DynamicResource LblDetectionSensitivity}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
							<Slider x:Name="sldSensitivity" Minimum="0" Maximum="100" Value="25" Width="70" 
									PointerCaptureLost="SldSensitivity_PointerCaptureLost" VerticalAlignment="Center" Focusable="False"/>
							<TextBlock Text="{Binding #sldSensitivity.Value, StringFormat='{}{0:0}%'}" 
									   VerticalAlignment="Center" Width="30" FontSize="11" FontWeight="Bold"/>

							<Button x:Name="btnAutoTune" Click="BtnAutoTune_Click" Padding="6,4" Background="{DynamicResource AppButtonAccentBrush}" Foreground="{DynamicResource AppButtonAccentTextBrush}" ToolTip.Tip="{DynamicResource TipAutoTune}" Focusable="False" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="4">
									<TextBlock Text="⚡" FontSize="11"/>
									<TextBlock Text="{DynamicResource BtnAutoTune}" FontSize="11" FontWeight="SemiBold"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>

					<!-- Group 4: Zoom View -->
					<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="6,3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<TextBlock Text="{DynamicResource LblZoom}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
							<Slider x:Name="sldZoom" Minimum="1" Maximum="10" Value="1" Width="65" 
									PropertyChanged="SldZoom_PropertyChanged" VerticalAlignment="Center" Focusable="False"/>
							<TextBlock Text="{Binding #sldZoom.Value, StringFormat='{}{0:0}x'}" 
									   VerticalAlignment="Center" Width="26" FontSize="11" FontWeight="Bold"/>
						</StackPanel>
					</Border>

					<!-- Group 5: Scan Navigation -->
					<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="3,2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
							<Button x:Name="btnPrevScan" Click="BtnPrevScan_Click" Padding="6,4" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip.Tip="Previous Scan (PageUp / ↑)">
								<TextBlock Text="◀" FontSize="10"/>
							</Button>
							<TextBlock x:Name="txtFileCounter" Text="{DynamicResource TxtNoFiles}" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0" FontSize="11"/>
							<Button x:Name="btnNextScan" Click="BtnNextScan_Click" Padding="6,4" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip.Tip="Next Scan (PageDown / ↓)">
								<TextBlock Text="▶" FontSize="10"/>
							</Button>
							<Rectangle Width="1" Height="16" Fill="{DynamicResource AppSeparatorBrush}" Margin="2,0"/>
							<Button x:Name="btnDeleteScan" Click="BtnDeleteScan_Click" Padding="6,4" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip.Tip="{DynamicResource TipDeleteScan}">
								<TextBlock Text="🗑️" FontSize="11"/>
							</Button>
						</StackPanel>
					</Border>

					<!-- Group 6: Advanced, Language & Theme -->
					<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="4,3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<ToggleButton x:Name="tglAdvanced" Padding="8,4" FontSize="11" VerticalAlignment="Center" Focusable="False" CornerRadius="4" ToolTip.Tip="{DynamicResource BtnAdvanced}">
								<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
									<TextBlock Text="⚙️" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource BtnAdvanced}" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</ToggleButton>

							<Rectangle Width="1" Height="16" Fill="{DynamicResource AppSeparatorBrush}" Margin="2,0"/>

							<Menu Background="Transparent" VerticalAlignment="Center" Margin="0" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None">
								<MenuItem Header="{DynamicResource MenuTheme}" x:Name="menuTheme" Focusable="False" IsTabStop="False" FontSize="11"/>
							</Menu>

							<Rectangle Width="1" Height="16" Fill="{DynamicResource AppSeparatorBrush}" Margin="2,0"/>

							<Menu Background="Transparent" VerticalAlignment="Center" Margin="0" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None">
								<MenuItem Header="{DynamicResource MenuDetectionColor}" x:Name="menuDetectionColor" Focusable="False" IsTabStop="False" FontSize="11"/>
							</Menu>

							<Rectangle Width="1" Height="16" Fill="{DynamicResource AppSeparatorBrush}" Margin="2,0"/>

							<Menu Background="Transparent" VerticalAlignment="Center" Margin="0" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None">
								<MenuItem Header="{DynamicResource MenuLanguage}" x:Name="menuLanguage" Focusable="False" IsTabStop="False" FontSize="11"/>
							</Menu>
						</StackPanel>
					</Border>
				</WrapPanel>

				<!-- Advanced Detection Drawer -->
				<Border Background="{DynamicResource AppToolbarBrush}" IsVisible="{Binding #tglAdvanced.IsChecked}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
					<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,6">
						<!-- Card 1: Detection Fine-Tuning -->
						<Border Background="{DynamicResource AppSubtleCardBrush}" CornerRadius="6" Padding="12,10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="5">
							<StackPanel Orientation="Vertical" Spacing="8">
								<TextBlock Text="{DynamicResource HeaderAdvDetection}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
								
								<WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
									<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,14,2">
										<TextBlock Text="{DynamicResource LblMinPhotoSize}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
										<Slider x:Name="sldMinArea" Minimum="5" Maximum="50" Value="25" Width="85" 
												PointerCaptureLost="SldSensitivity_PointerCaptureLost" VerticalAlignment="Center" Focusable="False"/>
										<TextBlock Text="{Binding #sldMinArea.Value, StringFormat='{}{0:0}%'}" FontSize="11" VerticalAlignment="Center" Width="28"/>
									</StackPanel>

									<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,14,2">
										<TextBlock Text="{DynamicResource LblMaxPhotoSize}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
										<Slider x:Name="sldMaxArea" Minimum="20" Maximum="100" Value="90" Width="85" 
												PointerCaptureLost="SldSensitivity_PointerCaptureLost" VerticalAlignment="Center" Focusable="False"/>
										<TextBlock Text="{Binding #sldMaxArea.Value, StringFormat='{}{0:0}%'}" FontSize="11" VerticalAlignment="Center" Width="28"/>
									</StackPanel>

									<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,14,2">
										<TextBlock Text="{DynamicResource LblEdgeThreshold}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
										<Slider x:Name="sldEdge" Minimum="1" Maximum="100" Value="20" Width="85" 
												PointerCaptureLost="SldSensitivity_PointerCaptureLost" VerticalAlignment="Center" Focusable="False"/>
										<TextBlock Text="{Binding #sldEdge.Value, StringFormat='{}{0:0}'}" FontSize="11" VerticalAlignment="Center" Width="28"/>
									</StackPanel>
								</WrapPanel>

								<WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
									<CheckBox x:Name="chkAutoOrient" Content="{DynamicResource LblAutoOrient}" ToolTip.Tip="{DynamicResource TipAutoOrient}" IsCheckedChanged="ChkAutoOrient_IsCheckedChanged" VerticalAlignment="Center" FontSize="11" Focusable="False" Margin="0,2,12,2"/>
									<CheckBox x:Name="chkRestoreColors" Content="{DynamicResource LblRestoreColors}" ToolTip.Tip="{DynamicResource TipRestoreColors}" IsCheckedChanged="ChkRestoreColors_IsCheckedChanged" VerticalAlignment="Center" FontSize="11" Focusable="False" Margin="0,2,12,2"/>
									<CheckBox x:Name="chkRemoveDust" Content="{DynamicResource LblRemoveDust}" ToolTip.Tip="{DynamicResource TipRemoveDust}" IsCheckedChanged="ChkRemoveDust_IsCheckedChanged" VerticalAlignment="Center" FontSize="11" Focusable="False" Margin="0,2,12,2"/>

									<Button x:Name="btnResetDefaults" Click="BtnResetDefaults_Click" Padding="8,4" FontSize="11" Background="{DynamicResource AppCardBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" Focusable="False" CornerRadius="4" Margin="0,2,4,2">
										<TextBlock Text="{DynamicResource BtnReset}"/>
									</Button>
								</WrapPanel>
							</StackPanel>
						</Border>
					</WrapPanel>
				</Border>
			</StackPanel>
		</Border>

		<!-- Footer / Status Bar -->
		<Border DockPanel.Dock="Bottom" Background="{DynamicResource AppFooterBrush}" Height="30" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
			<Grid ColumnDefinitions="Auto, *, Auto">
				<!-- Project Indicator Badge -->
				<Border Grid.Column="0" Margin="8,3" Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2"
						PointerPressed="LblCurrentProject_PointerPressed" Cursor="Hand" ToolTip.Tip="{DynamicResource TipWorkDir}">
					<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
						<TextBlock Text="🗂️" FontSize="11" VerticalAlignment="Center"/>
						<TextBlock x:Name="lblCurrentProject" Text="{DynamicResource LblNoProject}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Border>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0" Spacing="20" VerticalAlignment="Center">
					<TextBlock x:Name="lblStatus" Text="{DynamicResource StatusReady}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
					<TextBlock Text="{DynamicResource StatusShortcuts}" 
							   VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0" Spacing="8" VerticalAlignment="Center">
					<TextBlock x:Name="lblPhotoInfo" Text="" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
					<Button x:Name="btnHelp" Click="BtnHelp_Click" Padding="6,2" Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Focusable="False" ToolTip.Tip="{DynamicResource BtnHelp}">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock Text="❓" FontSize="11" VerticalAlignment="Center"/>
							<TextBlock Text="{DynamicResource BtnHelp}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Main Workspace -->
		<Grid ColumnDefinitions="*, Auto, *">
			<!-- Left: Original Scan & Empty State Dropzone -->
			<Border Grid.Column="0" Margin="10,10,4,10" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
				<Grid RowDefinitions="Auto, *">
					<TextBlock Grid.Row="0" Text="{DynamicResource HeaderOriginal}" Margin="10,5" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}"/>

					<!-- Empty State Dropzone -->
					<Border x:Name="pnlEmptyState" Grid.Row="1" Background="{DynamicResource AppEmptyStateBrush}" CornerRadius="6" Margin="10" IsVisible="True">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="20">
							<TextBlock Text="📥" FontSize="44" HorizontalAlignment="Center"/>
							<TextBlock Text="{DynamicResource EmptyStateTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
							<TextBlock Text="{DynamicResource EmptyStateDesc}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/>
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
								<Button Click="BtnOpenFiles_Click" Padding="12,6" Background="#1c6ec2" Foreground="White" CornerRadius="4" Focusable="False">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Text="📁" FontSize="11" VerticalAlignment="Center"/>
										<TextBlock Text="{DynamicResource BtnOpenScans}" FontSize="11" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>
								<Button Click="BtnScan_Click" Padding="12,6" Background="#28a745" Foreground="White" CornerRadius="4" Focusable="False">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Text="🖨️" FontSize="11" VerticalAlignment="Center"/>
										<TextBlock Text="{DynamicResource BtnScan}" FontSize="11" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- Active Scan View -->
					<ScrollViewer Grid.Row="1" x:Name="scrollOriginal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
								  SizeChanged="ScrollOriginal_SizeChanged">
						<Panel x:Name="pnlOriginal" Background="Transparent" 
							   PointerPressed="PnlOriginal_PointerPressed" 
							   PointerMoved="PnlOriginal_PointerMoved" 
							   PointerReleased="PnlOriginal_PointerReleased"
							   PointerWheelChanged="ScrollOriginal_PointerWheelChanged"
							   HorizontalAlignment="Center" VerticalAlignment="Center">
							<LayoutTransformControl x:Name="ltcOriginal" HorizontalAlignment="Center" VerticalAlignment="Center">
								<LayoutTransformControl.LayoutTransform>
									<ScaleTransform ScaleX="{Binding #sldZoom.Value}" ScaleY="{Binding #sldZoom.Value}"/>
								</LayoutTransformControl.LayoutTransform>
								<Image x:Name="img" Stretch="Uniform"/>
							</LayoutTransformControl>
							<Canvas x:Name="cnvCrop" Background="Transparent" IsHitTestVisible="False">
								<Rectangle x:Name="rectCrop" Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="2" Fill="#333399ff" IsVisible="False"/>
							</Canvas>
						</Panel>
					</ScrollViewer>
				</Grid>
			</Border>

			<!-- Resizable Splitter without white bar artifact -->
			<GridSplitter Grid.Column="1" Width="8" Background="Transparent" ResizeDirection="Columns" Focusable="False">
				<GridSplitter.Template>
					<ControlTemplate>
						<Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<Border Width="2" 
									HorizontalAlignment="Center" 
									VerticalAlignment="Stretch" 
									Background="{DynamicResource AppBorderBrush}" 
									CornerRadius="1"/>
						</Border>
					</ControlTemplate>
				</GridSplitter.Template>
				<GridSplitter.Styles>
					<Style Selector="GridSplitter:pointerover /template/ Border > Border">
						<Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
					</Style>
					<Style Selector="GridSplitter:pressed /template/ Border > Border">
						<Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
					</Style>
				</GridSplitter.Styles>
			</GridSplitter>

			<!-- Right: Cropped Results -->
			<Border Grid.Column="2" Margin="4,10,10,10" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
				<Grid RowDefinitions="Auto, *, Auto">
					<!-- Header with View Toggle & Selection Status -->
					<Grid Grid.Row="0" Margin="10,5" ColumnDefinitions="*, Auto">
						<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
							<TextBlock Text="{DynamicResource HeaderDetected}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
							<TextBlock x:Name="txtGallerySelection" FontSize="10" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="False"/>
							<StackPanel x:Name="pnlBatchSelectionActions" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="False">
								<Button x:Name="btnSelectAll" Click="BtnSelectAll_Click" Padding="6,2" CornerRadius="4" 
										Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
										ToolTip.Tip="{DynamicResource TipSelectAll}" Focusable="False" FontSize="10">
									<TextBlock Text="{DynamicResource BtnSelectAll}"/>
								</Button>
								<Button x:Name="btnClearSelection" Click="BtnClearSelection_Click" Padding="6,2" CornerRadius="4" 
										Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
										ToolTip.Tip="{DynamicResource TipClearSelection}" Focusable="False" FontSize="10">
									<TextBlock Text="{DynamicResource BtnClearSelection}"/>
								</Button>
							</StackPanel>
						</StackPanel>
						
						<!-- Toggle Mode: Single vs Grid -->
						<Border Grid.Column="1" Background="{DynamicResource AppToggleGroupBrush}" CornerRadius="6" Padding="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
							<StackPanel Orientation="Horizontal" Spacing="2">
								<RadioButton x:Name="rbViewCarousel" GroupName="grpResultView" IsChecked="True" 
											 IsCheckedChanged="RbViewMode_IsCheckedChanged" ToolTip.Tip="{DynamicResource TipViewCarousel}"
											 Focusable="False" Padding="8,3" CornerRadius="4" FontSize="11">
									<TextBlock Text="{DynamicResource ViewCarousel}"/>
								</RadioButton>
								<RadioButton x:Name="rbViewGrid" GroupName="grpResultView" 
											 IsCheckedChanged="RbViewMode_IsCheckedChanged" ToolTip.Tip="{DynamicResource TipViewGrid}"
											 Focusable="False" Padding="8,3" CornerRadius="4" FontSize="11">
									<TextBlock Text="{DynamicResource ViewGrid}"/>
								</RadioButton>
							</StackPanel>
						</Border>
					</Grid>
					
					<!-- Content Area: Single Carousel vs Gallery Grid -->
					<Panel Grid.Row="1">
						<!-- 1. Single Photo Carousel View -->
						<Panel x:Name="pnlCarouselView" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1000" MaxHeight="800">
							<Carousel x:Name="slides" SelectionChanged="Slides_SelectionChanged" Focusable="False" IsTabStop="False">
								<Carousel.PageTransition>
									<PageSlide Duration="0:0:0.2" Orientation="Horizontal" />
								</Carousel.PageTransition>
								<Carousel.ItemTemplate>
									<DataTemplate>
										<Border Margin="10" CornerRadius="4" ClipToBounds="True" Background="Transparent">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem Header="{DynamicResource MenuRotateCw}" InputGesture="R" Click="ContextMenu_RotateCw_Click"/>
													<MenuItem Header="{DynamicResource MenuRotateCcw}" Click="ContextMenu_RotateCcw_Click"/>
													<Separator/>
													<MenuItem Header="{DynamicResource MenuRefineCrop}" Click="ContextMenu_Refine_Click"/>
													<MenuItem Header="{DynamicResource MenuExportSingle}" Click="ContextMenu_ExportSingle_Click"/>
													<Separator/>
													<MenuItem Header="{DynamicResource BtnDelete}" InputGesture="Delete" Click="ContextMenu_Delete_Click"/>
												</ContextMenu>
											</Border.ContextMenu>
											<Image Stretch="Uniform" Source="{Binding}" 
												   MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center"/>
										</Border>
									</DataTemplate>
								</Carousel.ItemTemplate>
							</Carousel>
							
							<!-- Overlay Controls -->
							<Button VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-15,0"
									Click="BtnPreviousCroppedImage_Click" Content="&lt;" 
									Background="#80000000" Foreground="White" Width="40" Height="80" CornerRadius="4" Focusable="False"/>
							
							<Button VerticalAlignment="Center" HorizontalAlignment="Right" Margin="-15,0"
									Click="BtnNextCroppedImage_Click" Content="&gt;" 
									Background="#80000000" Foreground="White" Width="40" Height="80" CornerRadius="4" Focusable="False"/>
						</Panel>

						<!-- 2. Gallery Grid View -->
						<ScrollViewer x:Name="scrollGalleryView" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="False" Margin="10">
							<ListBox x:Name="lstGallery" SelectionChanged="LstGallery_SelectionChanged" Background="Transparent" BorderThickness="0" Focusable="False" SelectionMode="Multiple">
								<ListBox.Styles>
									<Style Selector="ListBoxItem">
										<Setter Property="Padding" Value="0"/>
										<Setter Property="Margin" Value="4"/>
										<Setter Property="CornerRadius" Value="8"/>
										<Setter Property="Background" Value="Transparent"/>
									</Style>
									<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
										<Setter Property="Background" Value="Transparent"/>
									</Style>
									<Style Selector="ListBoxItem:selected Border.photoCard">
										<Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
										<Setter Property="BorderThickness" Value="2"/>
										<Setter Property="Background" Value="{DynamicResource AppCardBackgroundSelectedBrush}"/>
									</Style>
									<Style Selector="ListBoxItem:selected Border.selectionBadge">
										<Setter Property="IsVisible" Value="True"/>
									</Style>
								</ListBox.Styles>
								<ListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5"/>
									</ItemsPanelTemplate>
								</ListBox.ItemsPanel>
								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="gui:GalleryPhotoItem">
										<Border Classes="photoCard" Margin="2" Padding="4" Background="{DynamicResource AppPhotoCardBrush}" CornerRadius="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
												Width="200" Height="220">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem Header="{DynamicResource MenuRotateCw}" InputGesture="R" Click="ContextMenu_RotateCw_Click"/>
													<MenuItem Header="{DynamicResource MenuRotateCcw}" Click="ContextMenu_RotateCcw_Click"/>
													<Separator/>
													<MenuItem Header="{DynamicResource MenuRefineCrop}" Click="ContextMenu_Refine_Click"/>
													<MenuItem Header="{DynamicResource MenuExportSingle}" Click="ContextMenu_ExportSingle_Click"/>
													<Separator/>
													<MenuItem Header="{DynamicResource BtnDelete}" InputGesture="Delete" Click="ContextMenu_Delete_Click"/>
												</ContextMenu>
											</Border.ContextMenu>
											<Grid RowDefinitions="*, Auto">
												<Image Grid.Row="0" Stretch="Uniform" Source="{Binding Image}" Margin="4"/>
												<!-- Selection checkmark badge -->
												<Border Grid.Row="0" Classes="selectionBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" 
														Background="{DynamicResource AppAccentBrush}" CornerRadius="10" Width="20" Height="20" IsVisible="False">
													<TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White" 
															   HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
												<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,4,0,0">
													<TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
													<TextBlock Text="{Binding Dimensions}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</ScrollViewer>
					</Panel>

					<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15" Spacing="10">
						<Button x:Name="btnDelete" Click="BtnDelete_Click" Padding="15,10" CornerRadius="20" Background="{DynamicResource AppButtonDangerBrush}" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="✖" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AppButtonDangerTextBrush}"/>
								<TextBlock x:Name="txtBtnDelete" Text="{DynamicResource BtnDelete}" Foreground="{DynamicResource AppButtonDangerTextBrush}" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="btnRotate" Click="BtnRotate_Click" Padding="15,10" CornerRadius="20" Background="{DynamicResource AppButtonActionBrush}" Foreground="{DynamicResource AppButtonActionTextBrush}" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="↻" FontSize="16" VerticalAlignment="Center"/>
								<TextBlock x:Name="txtBtnRotate" Text="{DynamicResource BtnRotate}" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="btnRefine" Click="BtnRefine_Click" Padding="15,10" CornerRadius="20" Background="{DynamicResource AppButtonActionBrush}" Foreground="{DynamicResource AppButtonActionTextBrush}" ToolTip.Tip="{DynamicResource TipRefine}" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="✨" FontSize="16" VerticalAlignment="Center"/>
								<TextBlock Text="{DynamicResource BtnRefine}" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
		</DockPanel>

		<!-- Refine Overlay -->
		<Panel x:Name="pnlRefineOverlay" Background="{DynamicResource AppOverlayScrimBrush}" IsVisible="False" ZIndex="100">
			<Grid RowDefinitions="*, Auto" Margin="50">
				<Border Grid.Row="0" Margin="20" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource AppWorkspaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
					<Panel x:Name="pnlRefineImage" Background="Transparent"
						   PointerPressed="PnlRefine_PointerPressed"
						   PointerMoved="PnlRefine_PointerMoved"
						   PointerReleased="PnlRefine_PointerReleased">
						<Image x:Name="imgRefine" Stretch="Uniform" Margin="20"
							   VerticalAlignment="Center" HorizontalAlignment="Center"/>
						<Canvas x:Name="cnvRefineCrop" Background="Transparent" IsHitTestVisible="False">
							<Rectangle x:Name="rectRefineCrop" Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="2" Fill="#333399ff" IsVisible="False"/>
						</Canvas>
					</Panel>
				</Border>
				<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30" Margin="20">
					<Button x:Name="btnAcceptRefine" Click="BtnAcceptRefine_Click" Padding="40,15" CornerRadius="8" Background="#2d882d" Foreground="White" Focusable="False">
						<TextBlock Text="{DynamicResource BtnAccept}" FontSize="18" FontWeight="Bold"/>
					</Button>
					<Button x:Name="btnRejectRefine" Click="BtnRejectRefine_Click" Padding="40,15" CornerRadius="8" Background="#882d2d" Foreground="White" Focusable="False">
						<TextBlock Text="{DynamicResource BtnReject}" FontSize="18" FontWeight="Bold"/>
					</Button>
				</StackPanel>
			</Grid>
		</Panel>
		<!-- Loading Overlay -->
		<Panel x:Name="pnlLoadingOverlay" Background="{DynamicResource AppOverlayScrimBrush}" IsVisible="False" ZIndex="200">
			<Border Background="{DynamicResource AppModalBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="30,25" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320">
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
					<ProgressBar IsIndeterminate="True" Width="240" Height="8" Foreground="{DynamicResource AppAccentBrush}"/>
					<TextBlock x:Name="txtLoadingText" Text="{DynamicResource ProcessingScan}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
					<Button x:Name="btnCancelLoading" Click="BtnCancelLoading_Click" IsVisible="False" Padding="16,6" Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}" CornerRadius="6" HorizontalAlignment="Center" Focusable="False">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Text="✖" FontSize="11"/>
							<TextBlock Text="{DynamicResource BtnCancel}" FontSize="12" FontWeight="SemiBold"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Border>
		</Panel>
		<!-- Error / Alert Modal Overlay -->
		<Panel x:Name="pnlErrorOverlay" Background="{DynamicResource AppOverlayScrimBrush}" IsVisible="False" ZIndex="400">
			<Border Background="{DynamicResource AppModalBackgroundBrush}" BorderBrush="#ff4444" BorderThickness="1" CornerRadius="12" Padding="25" 
					HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="20">
				<StackPanel Spacing="18">
					<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
						<Border Background="{DynamicResource AppDangerBackgroundBrush}" CornerRadius="20" Width="40" Height="40">
							<TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock x:Name="txtErrorTitle" Text="{DynamicResource TitleScannerError}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppDangerTextBrush}" VerticalAlignment="Center"/>
					</StackPanel>

					<TextBlock x:Name="txtErrorMessage" Text="An error occurred while communicating with the scanner." 
							   TextWrapping="Wrap" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13" LineHeight="20"/>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
						<Button x:Name="btnErrorRefresh" Click="BtnErrorRefresh_Click" Padding="16,8" Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" CornerRadius="6" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="🔄"/>
								<TextBlock Text="{DynamicResource BtnRefreshScanners}"/>
							</StackPanel>
						</Button>
						<Button x:Name="btnCloseError" Click="BtnCloseError_Click" Padding="20,8" Background="{DynamicResource AppAccentBrush}" Foreground="White" CornerRadius="6" FontWeight="SemiBold" Focusable="False">
							<TextBlock Text="{DynamicResource BtnOk}"/>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Panel>

		<!-- Unsaved Changes Confirmation Modal Overlay -->
		<Panel x:Name="pnlUnsavedOverlay" Background="{DynamicResource AppOverlayScrimBrush}" IsVisible="False" ZIndex="500">
			<Border Background="{DynamicResource AppModalBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25" 
					HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" Margin="20">
				<StackPanel Spacing="16">
					<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
						<Border Background="{DynamicResource AppWarningBackgroundBrush}" CornerRadius="20" Width="40" Height="40">
							<TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock Text="{DynamicResource TitleUnsavedChanges}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
					</StackPanel>

					<TextBlock Text="{DynamicResource MsgUnsavedChanges}" 
							   TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" LineHeight="20"/>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
						<Button x:Name="btnCancelExit" Click="BtnCancelExit_Click" Padding="14,8" Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" CornerRadius="6" Focusable="False">
							<TextBlock Text="{DynamicResource BtnCancel}"/>
						</Button>
						<Button x:Name="btnDiscardAndExit" Click="BtnDiscardAndExit_Click" Padding="14,8" Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}" CornerRadius="6" Focusable="False">
							<TextBlock Text="{DynamicResource BtnDiscardAndExit}"/>
						</Button>
						<Button x:Name="btnSaveAndExit" Click="BtnSaveAndExit_Click" Padding="18,8" Background="#28a745" Foreground="White" CornerRadius="6" FontWeight="SemiBold" Focusable="False">
							<TextBlock Text="{DynamicResource BtnSaveAndExit}"/>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Panel>

	</Grid>
</Window>
