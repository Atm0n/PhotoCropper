<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gui="using:PhotoCropper.Gui"
		WindowState="Maximized"
		MinWidth="1200"
		MinHeight="650"
        x:Class="PhotoCropper.Gui.MainWindow"
		Background="{DynamicResource AppBackgroundBrush}"
		Foreground="{DynamicResource AppTextPrimaryBrush}"
        Title="PhotoCropper - Intelligent Photo Extractor"
        Icon="avares://PhotoCropper.Gui/Assets/app_icon.png"
        DragDrop.AllowDrop="True">

	<Grid>
		<DockPanel>
			<!-- Hidden Classic Menu Bar (Toggled with ALT key) -->
			<Border x:Name="pnlMenuBar" DockPanel.Dock="Top" Background="{DynamicResource AppToolbarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" IsVisible="False">
				<Menu Background="Transparent" FontSize="12">
					<!-- File Menu -->
					<MenuItem Header="_File">
						<MenuItem Header="{DynamicResource BtnScan}" InputGesture="F5" Click="BtnScan_Click"/>
						<MenuItem Header="{DynamicResource TitleScannerConfig}" Click="BtnScannerConfig_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnWorkDir}" Click="BtnWorkDir_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnSaveResults}" InputGesture="Ctrl+S" Click="BtnSaveImages_Click"/>
						<Separator/>
						<MenuItem Header="Exit" InputGesture="Alt+F4" Click="MenuExit_Click"/>
					</MenuItem>

					<!-- Edit Menu -->
					<MenuItem Header="_Edit">
						<MenuItem Header="Undo" InputGesture="Ctrl+Z" Click="MenuUndo_Click"/>
						<MenuItem Header="Redo" InputGesture="Ctrl+Y" Click="MenuRedo_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnSelectAll}" InputGesture="Ctrl+A" Click="BtnSelectAll_Click"/>
						<MenuItem Header="{DynamicResource BtnClearSelection}" InputGesture="Escape" Click="BtnClearSelection_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnDeleteScan}" InputGesture="Shift+Delete" Click="BtnDeleteScan_Click"/>
						<MenuItem Header="{DynamicResource BtnDelete}" InputGesture="Delete" Click="BtnDelete_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnRotate}" InputGesture="R" Click="BtnRotate_Click"/>
						<MenuItem Header="{DynamicResource BtnRefine}" Click="BtnRefine_Click"/>
					</MenuItem>

					<!-- View Menu -->
					<MenuItem Header="_View">
						<MenuItem Header="{DynamicResource ViewCarousel}" Click="MenuViewCarousel_Click"/>
						<MenuItem Header="{DynamicResource ViewGrid}" Click="MenuViewGrid_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnPrevScan}" InputGesture="Up" Click="BtnPrevScan_Click"/>
						<MenuItem Header="{DynamicResource BtnNextScan}" InputGesture="Down" Click="BtnNextScan_Click"/>
						<MenuItem Header="{DynamicResource BtnPreviousCroppedImage}" InputGesture="Left" Click="BtnPreviousCroppedImage_Click"/>
						<MenuItem Header="{DynamicResource BtnNextCroppedImage}" InputGesture="Right" Click="BtnNextCroppedImage_Click"/>
					</MenuItem>

					<!-- Tools Menu -->
					<MenuItem Header="_Tools">
						<MenuItem Header="{DynamicResource BtnAutoTune}" Click="BtnAutoTune_Click"/>
						<MenuItem Header="{DynamicResource LblAutoTuneOnPass}" Click="MenuAutoTuneOnPass_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource BtnResetBackground}" Click="BtnResetBackground_Click"/>
						<MenuItem Header="{DynamicResource BtnReset}" Click="BtnReset_Click"/>
					</MenuItem>

					<!-- Settings Menu -->
					<MenuItem Header="_Settings">
						<MenuItem Header="{DynamicResource TitleExportSettings}" Click="BtnSaveSettings_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource MenuTheme}" x:Name="menuAltTheme"/>
						<MenuItem Header="{DynamicResource MenuLanguage}" x:Name="menuAltLanguage"/>
						<MenuItem Header="{DynamicResource MenuDetectionColor}" x:Name="menuAltDetectionColor"/>
					</MenuItem>

					<!-- Help Menu -->
					<MenuItem Header="_Help">
						<MenuItem Header="{DynamicResource BtnHelp}" InputGesture="F1" Click="BtnHelp_Click"/>
						<Separator/>
						<MenuItem Header="{DynamicResource MenuCheckUpdates}" Click="MenuCheckUpdates_Click"/>
					</MenuItem>
				</Menu>
			</Border>

			<!-- Header / Toolbar -->
		<Border DockPanel.Dock="Top" Background="{DynamicResource AppToolbarBrush}" MinHeight="48" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
			<StackPanel>
				<!-- Responsive Main Toolbar with Grouped Cards -->
				<Grid Margin="8,4" VerticalAlignment="Center" ColumnDefinitions="Auto, *, Auto">
					<!-- Group 1: File Actions (Scan, Save, Workspace) -->
					<Border Grid.Column="0" HorizontalAlignment="Left" Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="4,3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="3,2">
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<!-- Scan Button with Config Trigger -->
							<Border Background="#28a745" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="0">
									<Button x:Name="btnScan" Click="BtnScan_Click" Padding="10,5" Background="Transparent" BorderThickness="0" Foreground="White" Focusable="False" ToolTip.Tip="{DynamicResource TipScan}">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="🖨️" FontSize="12" VerticalAlignment="Center"/>
											<TextBlock Text="{DynamicResource BtnScan}" FontWeight="SemiBold" VerticalAlignment="Center"/>
										</StackPanel>
									</Button>
									<Rectangle Width="1" Fill="#3db85a" Margin="0,4"/>
									<Button x:Name="btnScannerConfig" Click="BtnScannerConfig_Click" Padding="6,5" Background="Transparent" BorderThickness="0" Foreground="White" Focusable="False" ToolTip.Tip="{DynamicResource TipScannerConfig}">
										<TextBlock Text="⚙️" FontSize="11" VerticalAlignment="Center"/>
									</Button>
								</StackPanel>
							</Border>
							<!-- Save Button with Options Trigger -->
							<Border Background="{DynamicResource AppButtonDefaultBrush}" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="0">
									<Button x:Name="btnSave" Click="BtnSaveImages_Click" Padding="10,5" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppButtonDefaultTextBrush}" Focusable="False" ToolTip.Tip="{DynamicResource BtnSaveResults}">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="💾" FontSize="12" VerticalAlignment="Center"/>
											<TextBlock Text="{DynamicResource BtnSaveResults}" VerticalAlignment="Center"/>
										</StackPanel>
									</Button>
									<Rectangle Width="1" Fill="{DynamicResource AppBorderBrush}" Margin="0,4"/>
									<Button x:Name="btnSaveSettings" Click="BtnSaveSettings_Click" Padding="6,5" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AppButtonDefaultTextBrush}" Focusable="False" ToolTip.Tip="{DynamicResource TipSaveSettings}">
										<TextBlock Text="⚙️" FontSize="11" VerticalAlignment="Center"/>
									</Button>
								</StackPanel>
							</Border>
							<Rectangle Width="1" Height="20" Fill="{DynamicResource AppSeparatorBrush}" Margin="4,0"/>
							<Button x:Name="btnWorkDir" Click="BtnWorkDir_Click" Padding="10,5" Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Focusable="False" ToolTip.Tip="{DynamicResource TipWorkDir}" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="🗂️" FontSize="12" VerticalAlignment="Center"/>
									<TextBlock x:Name="txtWorkDirBtn" Text="{DynamicResource BtnWorkDir}" FontWeight="SemiBold" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>


					<!-- Group 2: Edit Actions (Undo/Redo) -->
					<Border Grid.Column="1" HorizontalAlignment="Left" Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="4,3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="10,2,3,2">
						<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
							<Button x:Name="btnUndo" Click="MenuUndo_Click" Padding="10,5" Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Focusable="False" ToolTip.Tip="Undo (Ctrl+Z)" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="↩️" FontSize="12" VerticalAlignment="Center"/>
									<TextBlock Text="Undo" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<Button x:Name="btnRedo" Click="MenuRedo_Click" Padding="10,5" Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Focusable="False" ToolTip.Tip="Redo (Ctrl+Y)" CornerRadius="4">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="↪️" FontSize="12" VerticalAlignment="Center"/>
									<TextBlock Text="Redo" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>

					<!-- Group 5: Reset Defaults -->
					<Border Grid.Column="2" HorizontalAlignment="Right" Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="6,3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="3,2">
						<Button x:Name="btnResetDefaults" Click="BtnResetDefaults_Click" Padding="8,5" Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" VerticalAlignment="Center" Focusable="False" CornerRadius="4">
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBlock Text="↺" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
								<TextBlock Text="{DynamicResource BtnReset}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</Border>
				</Grid>
			</StackPanel>
		</Border>

		<!-- Footer / Status Bar -->
		<Border DockPanel.Dock="Bottom" Background="{DynamicResource AppFooterBrush}" Height="30" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
			<Grid ColumnDefinitions="Auto, *, Auto">
				<!-- Project Indicator Badge -->
				<Border Grid.Column="0" Margin="8,3" Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2"
						PointerPressed="LblCurrentProject_PointerPressed" Cursor="Hand" ToolTip.Tip="{DynamicResource TipWorkDir}">
					<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
						<TextBlock Text="🗂️" FontSize="11" VerticalAlignment="Center"/>
						<TextBlock x:Name="lblCurrentProject" Text="{DynamicResource LblNoProject}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
					</StackPanel>
				</Border>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0" Spacing="20" VerticalAlignment="Center">
					<TextBlock x:Name="lblStatus" Text="{DynamicResource StatusReady}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
					<TextBlock Text="{DynamicResource StatusShortcuts}" 
							   VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0" Spacing="8" VerticalAlignment="Center">

					<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="4" Padding="2,0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
						<Menu Background="Transparent" VerticalAlignment="Center" Margin="0" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None">
							<MenuItem Header="{DynamicResource MenuTheme}" x:Name="menuTheme" Focusable="False" IsTabStop="False" FontSize="11" Padding="6,2"/>
						</Menu>
					</Border>

					<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="4" Padding="2,0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
						<Menu Background="Transparent" VerticalAlignment="Center" Margin="0" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None">
							<MenuItem Header="{DynamicResource MenuLanguage}" x:Name="menuLanguage" Focusable="False" IsTabStop="False" FontSize="11" Padding="6,2"/>
						</Menu>
					</Border>

					<Button x:Name="btnHelp" Click="BtnHelp_Click" Padding="6,2" Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Focusable="False" ToolTip.Tip="{DynamicResource BtnHelp}">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock Text="❓" FontSize="11" VerticalAlignment="Center"/>
							<TextBlock Text="{DynamicResource BtnHelp}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Main Workspace -->
		<Grid x:Name="grdMainWorkspace">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" MinWidth="640"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*" MinWidth="550"/>
			</Grid.ColumnDefinitions>
			<!-- Left: Original Scan & Empty State Dropzone -->
			<Grid Grid.Column="0" RowDefinitions="Auto, *">
				<DockPanel Grid.Row="0" Margin="15,0,10,5" VerticalAlignment="Center">
					<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
						<Border x:Name="bdrLookaheadStatus" IsVisible="False" Background="{DynamicResource AppSubtleCardBrush}" BorderBrush="#3db85a" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" ToolTip.Tip="Pre-processed in background thread for 0ms navigation">
							<TextBlock x:Name="txtLookaheadBadge" Text="{DynamicResource LblLookaheadPreloaded}" FontSize="10" FontWeight="Bold" Foreground="#3db85a" VerticalAlignment="Center"/>
						</Border>
						<Border Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBlock Text="🎯" FontSize="10" VerticalAlignment="Center"/>
								<TextBlock x:Name="lblDetectionCoverage" Text="" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
							</StackPanel>
						</Border>
					</StackPanel>
					<StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
						<TextBlock Text="{DynamicResource HeaderOriginal}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
						<TextBlock x:Name="txtFileCounter" Text="{DynamicResource TxtNoFiles}" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
					</StackPanel>
				</DockPanel>
				<Border Grid.Row="1" Margin="10,0,4,10" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
					<Grid RowDefinitions="Auto, *, Auto">
						<DockPanel Grid.Row="0" Margin="10,5">
							<!-- Auto Tune Button (Prominent) -->
							<Button DockPanel.Dock="Right" x:Name="btnAutoTune" Click="BtnAutoTune_Click" Padding="16,8" Background="{DynamicResource AppButtonAccentBrush}" Foreground="{DynamicResource AppButtonAccentTextBrush}" ToolTip.Tip="{DynamicResource TipAutoTune}" Focusable="False" CornerRadius="8" VerticalAlignment="Center" Margin="10,0,0,0">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource BtnAutoTune}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>

							<ScrollViewer DockPanel.Dock="Left" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
								<StackPanel Orientation="Horizontal" Spacing="8">
								<Button x:Name="btnDeleteScan" Click="BtnDeleteScan_Click" Padding="12,6" Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}" CornerRadius="6" Focusable="False" ToolTip.Tip="{DynamicResource TipDeleteScan}" VerticalAlignment="Center">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Text="🗑️" FontSize="13" VerticalAlignment="Center"/>
										<TextBlock Text="{DynamicResource BtnDelete}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>
							<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="4,2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
								<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="2,0">
									<TextBlock Text="Background:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
									<ToggleButton x:Name="tglColorPicker" Click="TglColorPicker_Click" Padding="6,3" Focusable="False" ToolTip.Tip="{DynamicResource BtnSampleBackground}" CornerRadius="4">
										<StackPanel Orientation="Horizontal" Spacing="4">
											<TextBlock Text="🎨" FontSize="11" VerticalAlignment="Center"/>
											<TextBlock Text="Pick Color" FontSize="10" VerticalAlignment="Center"/>
										</StackPanel>
									</ToggleButton>
									<Button x:Name="btnResetBackground" Click="BtnResetBackground_Click" Padding="6,3" Focusable="False" IsEnabled="False" ToolTip.Tip="{DynamicResource BtnResetBackground}" CornerRadius="4">
										<StackPanel Orientation="Horizontal" Spacing="4">
											<TextBlock Text="↺" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
											<TextBlock Text="Reset" FontSize="10" VerticalAlignment="Center"/>
										</StackPanel>
									</Button>
								</StackPanel>
							</Border>
							<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="6" Padding="6,2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
								<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
									<Rectangle x:Name="rectCurrentDetectionColor" Width="12" Height="12" RadiusX="2" RadiusY="2" Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1"/>
									<Menu Background="Transparent" VerticalAlignment="Center" Margin="0" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None">
										<MenuItem Header="Box Color" x:Name="menuDetectionColor" Focusable="False" IsTabStop="False" FontSize="11" FontWeight="SemiBold"/>
									</Menu>
								</StackPanel>
							</Border>
							</StackPanel>
							</ScrollViewer>
					</DockPanel>

					<!-- Empty State Dropzone -->
					<Border x:Name="pnlEmptyState" Grid.Row="1" Background="{DynamicResource AppEmptyStateBrush}" CornerRadius="6" Margin="10" IsVisible="True">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="20">
							<TextBlock Text="📥" FontSize="44" HorizontalAlignment="Center"/>
							<TextBlock Text="{DynamicResource EmptyStateTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
							<TextBlock Text="{DynamicResource EmptyStateDesc}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/>

						</StackPanel>
					</Border>

					<!-- Active Scan View -->
					<Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
						<Button Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0" ZIndex="10"
								x:Name="btnPrevScan" Click="BtnPrevScan_Click"
								Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Width="40" Height="80" CornerRadius="4" Focusable="False" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ToolTip.Tip="Previous Scan (PageUp / ↑)">
							<TextBlock Text="◀" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Button>

						<ScrollViewer Grid.Column="1" x:Name="scrollOriginal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
									  SizeChanged="ScrollOriginal_SizeChanged">
						<Panel x:Name="pnlOriginal" Background="Transparent" 
							   PointerPressed="PnlOriginal_PointerPressed" 
							   PointerMoved="PnlOriginal_PointerMoved" 
							   PointerReleased="PnlOriginal_PointerReleased"
							   PointerWheelChanged="ScrollOriginal_PointerWheelChanged"
							   HorizontalAlignment="Center" VerticalAlignment="Center">
							<LayoutTransformControl x:Name="ltcOriginal" HorizontalAlignment="Center" VerticalAlignment="Center">
								<LayoutTransformControl.LayoutTransform>
									<ScaleTransform ScaleX="{Binding #sldZoom.Value}" ScaleY="{Binding #sldZoom.Value}"/>
								</LayoutTransformControl.LayoutTransform>
								<Image x:Name="img" Stretch="Uniform"/>
							</LayoutTransformControl>
							<Canvas x:Name="cnvCrop" Background="Transparent" IsHitTestVisible="False">
								<Rectangle x:Name="rectCrop" Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="2" Fill="#333399ff" IsVisible="False"/>
							</Canvas>
						</Panel>
					</ScrollViewer>
						
						<!-- Localized "Thinking" indicator for Live Preview -->
						<Border Grid.Column="1" x:Name="pnlLocalLoading" Background="{DynamicResource AppModalBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="15,8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" ZIndex="20">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="⏳" FontSize="16" VerticalAlignment="Center"/>
								<TextBlock Text="Calculating..." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
							</StackPanel>
						</Border>
						
						<Button Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0" ZIndex="10"
								x:Name="btnNextScan" Click="BtnNextScan_Click"
								Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Width="40" Height="80" CornerRadius="4" Focusable="False" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ToolTip.Tip="Next Scan (PageDown / ↓)">
							<TextBlock Text="▶" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Button>
					</Grid>
					<!-- Collapsible Detection Tuning Sliders & Zoom Bar (Bottom of Left Panel) -->
					<StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="10,0,10,8" MaxWidth="{Binding $parent.Bounds.Width}">
						<!-- Bottom Control Bar: Zoom + Sensitivity Toggle Button -->
						<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
							<!-- Zoom Control -->
							<Border Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="12" Padding="10,3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
								<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
									<TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource LblZoom}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
									<Slider x:Name="sldZoom" Minimum="1" Maximum="10" Value="1" Width="70" 
									        PropertyChanged="SldZoom_PropertyChanged" VerticalAlignment="Center" Focusable="False" Margin="0,-2,0,-2"/>
									<TextBlock Text="{Binding #sldZoom.Value, StringFormat='{}{0:0}x'}" 
									           VerticalAlignment="Center" Width="24" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
								</StackPanel>
							</Border>

							<!-- Sensitivity Toggle Pill -->
							<ToggleButton x:Name="tglDetectionOptions" IsChecked="True" 
							              Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" 
							              CornerRadius="12" Padding="12,3" Focusable="False" Cursor="Hand" ToolTip.Tip="Toggle Detection Tuning Sliders">
								<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
									<TextBlock Text="🎛️" FontSize="11" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource LblDetectionSensitivity}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
									<Border Background="{DynamicResource AppSubtleCardBrush}" CornerRadius="8" Width="16" Height="16" Margin="2,0,0,0">
										<Panel VerticalAlignment="Center" HorizontalAlignment="Center">
											<TextBlock Text="▴" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding #tglDetectionOptions.IsChecked}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
											<TextBlock Text="▾" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" IsVisible="{Binding !#tglDetectionOptions.IsChecked}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
										</Panel>
									</Border>
								</StackPanel>
							</ToggleButton>
						</StackPanel>

						<!-- Collapsible Sliders Card Content -->
						<Border IsVisible="{Binding #tglDetectionOptions.IsChecked}" Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="6,3" Margin="0,4,0,0">
								<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
									<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="4,2">
							<!-- Sensitivity -->
							<StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Grid.Column="0" Text="{DynamicResource LblDetectionSensitivity}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
									<TextBlock Grid.Column="1" Text="{Binding #sldSensitivity.Value, StringFormat='{}{0:0}%'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
								</Grid>
								<Slider x:Name="sldSensitivity" Minimum="0" Maximum="100" Value="50" Width="100" Margin="0,-4,0,-4"
										PropertyChanged="SldSensitivity_PropertyChanged" Focusable="False"/>
							</StackPanel>

							<Rectangle Width="1" Height="24" Fill="{DynamicResource AppSeparatorBrush}" Margin="2,0"/>

							<!-- Min Area -->
							<StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Grid.Column="0" Text="{DynamicResource LblMinPhotoSize}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
									<TextBlock Grid.Column="1" Text="{Binding #sldMinArea.Value, StringFormat='{}{0:0}%'}" FontSize="10" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
								</Grid>
								<Slider x:Name="sldMinArea" Minimum="5" Maximum="50" Value="25" Width="80" Margin="0,-4,0,-4"
										PropertyChanged="SldSensitivity_PropertyChanged" Focusable="False"/>
							</StackPanel>
							
							<!-- Max Area -->
							<StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Grid.Column="0" Text="{DynamicResource LblMaxPhotoSize}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
									<TextBlock Grid.Column="1" Text="{Binding #sldMaxArea.Value, StringFormat='{}{0:0}%'}" FontSize="10" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
								</Grid>
								<Slider x:Name="sldMaxArea" Minimum="20" Maximum="100" Value="90" Width="80" Margin="0,-4,0,-4"
										PropertyChanged="SldSensitivity_PropertyChanged" Focusable="False"/>
							</StackPanel>
							
							<!-- Edge -->
							<StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Grid.Column="0" Text="{DynamicResource LblEdgeThreshold}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
									<TextBlock Grid.Column="1" Text="{Binding #sldEdge.Value, StringFormat='{}{0:0}'}" FontSize="10" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
								</Grid>
								<Slider x:Name="sldEdge" Minimum="1" Maximum="100" Value="20" Width="80" Margin="0,-4,0,-4"
										PropertyChanged="SldSensitivity_PropertyChanged" Focusable="False"/>
							</StackPanel>

							<Rectangle Width="1" Height="24" Fill="{DynamicResource AppSeparatorBrush}" Margin="2,0"/>
							
							<StackPanel Orientation="Vertical" Spacing="4" VerticalAlignment="Center" Margin="4,0">
								<CheckBox x:Name="chkAutoTuneOnPass" Content="{DynamicResource LblAutoTuneOnPass}" ToolTip.Tip="{DynamicResource TipAutoTuneOnPass}" IsCheckedChanged="ChkAutoTuneOnPass_IsCheckedChanged" FontSize="9" Focusable="False" Margin="0,-3,0,-3"/>
								<CheckBox x:Name="chkAutoAdjustOnLowCoverage" Content="{DynamicResource LblAutoAdjustOnLowCoverage}" ToolTip.Tip="{DynamicResource TipAutoAdjustOnLowCoverage}" IsCheckedChanged="ChkAutoAdjustOnLowCoverage_IsCheckedChanged" FontSize="9" Focusable="False" Margin="0,-3,0,-3"/>
							</StackPanel>
									</StackPanel>
								</ScrollViewer>
						</Border>
					</StackPanel>
				</Grid>
			</Border>
			</Grid>

			<!-- Resizable Splitter without white bar artifact -->
			<GridSplitter Grid.Column="1" Width="8" Background="Transparent" ResizeDirection="Columns" Focusable="False">
				<GridSplitter.Template>
					<ControlTemplate>
						<Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<Border Width="2" 
									HorizontalAlignment="Center" 
									VerticalAlignment="Stretch" 
									Background="{DynamicResource AppBorderBrush}" 
									CornerRadius="1"/>
						</Border>
					</ControlTemplate>
				</GridSplitter.Template>
				<GridSplitter.Styles>
					<Style Selector="GridSplitter:pointerover /template/ Border > Border">
						<Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
					</Style>
					<Style Selector="GridSplitter:pressed /template/ Border > Border">
						<Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
					</Style>
				</GridSplitter.Styles>
			</GridSplitter>

			<!-- Right: Cropped Results -->
			<Grid Grid.Column="2" RowDefinitions="Auto, *">
			<DockPanel Grid.Row="0" Margin="10,0,10,5" VerticalAlignment="Center">
				<Button DockPanel.Dock="Left" x:Name="btnToggleRightPanel" Click="BtnToggleRightPanel_Click"
						Width="24" Height="24" Padding="0" CornerRadius="4" Focusable="False"
						Background="{DynamicResource AppSubtleCardBrush}"
						BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
						ToolTip.Tip="{DynamicResource TipToggleRightPanel}" Margin="0,0,8,0" VerticalAlignment="Center">
					<TextBlock x:Name="txtToggleRightPanelIcon" Text="&#x25C4;" FontSize="9" FontWeight="Bold"
							   HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Button>
				<TextBlock x:Name="txtGallerySelection" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="False"/>
				<StackPanel x:Name="pnlRightPanelHeader" DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
					<TextBlock Text="{DynamicResource HeaderDetected}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
					<TextBlock x:Name="lblPhotoInfo" Text="" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel>
			</DockPanel>
				<Border x:Name="brdRightPanelContent" Grid.Row="1" Margin="4,0,10,10" Background="{DynamicResource AppWorkspaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
					<Grid RowDefinitions="Auto, *, Auto">
						<!-- Header with View Toggle, Processing Filters, & Selection Status -->
						<Grid Grid.Row="0" Margin="10,5" ColumnDefinitions="Auto, *, Auto">
							<!-- Batch Selection Actions -->
							<StackPanel Grid.Column="0" x:Name="pnlBatchSelectionActions" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="False">
								<Button x:Name="btnSelectAll" Click="BtnSelectAll_Click" Padding="6,2" CornerRadius="4" 
										Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
										ToolTip.Tip="{DynamicResource TipSelectAll}" Focusable="False" FontSize="10">
									<TextBlock Text="{DynamicResource BtnSelectAll}"/>
								</Button>
								<Button x:Name="btnClearSelection" Click="BtnClearSelection_Click" Padding="6,2" CornerRadius="4" 
										Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
										ToolTip.Tip="{DynamicResource TipClearSelection}" Focusable="False" FontSize="10">
									<TextBlock Text="{DynamicResource BtnClearSelection}"/>
								</Button>
							</StackPanel>

							<!-- Processing Filters (Inline with View Mode) -->
							<ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,0">
								<StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center">
									<CheckBox x:Name="chkAutoOrient" Content="{DynamicResource LblAutoOrient}" ToolTip.Tip="{DynamicResource TipAutoOrient}" IsCheckedChanged="ChkAutoOrient_IsCheckedChanged" VerticalAlignment="Center" FontSize="10" Focusable="False"/>
									<CheckBox x:Name="chkRestoreColors" Content="{DynamicResource LblRestoreColors}" ToolTip.Tip="{DynamicResource TipRestoreColors}" IsCheckedChanged="ChkRestoreColors_IsCheckedChanged" VerticalAlignment="Center" FontSize="10" Focusable="False"/>
									<CheckBox x:Name="chkRemoveDust" Content="{DynamicResource LblRemoveDust}" ToolTip.Tip="{DynamicResource TipRemoveDust}" IsCheckedChanged="ChkRemoveDust_IsCheckedChanged" VerticalAlignment="Center" FontSize="10" Focusable="False"/>
								</StackPanel>
							</ScrollViewer>
						
						<!-- Toggle Mode: Single vs Grid -->
						<Border Grid.Column="2" Background="{DynamicResource AppToggleGroupBrush}" CornerRadius="6" Padding="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
							<StackPanel Orientation="Horizontal" Spacing="2">
								<RadioButton x:Name="rbViewCarousel" GroupName="grpResultView" IsChecked="True" 
											 IsCheckedChanged="RbViewMode_IsCheckedChanged" ToolTip.Tip="{DynamicResource TipViewCarousel}"
											 Focusable="False" Padding="8,3" CornerRadius="4" FontSize="11">
									<TextBlock Text="{DynamicResource ViewCarousel}"/>
								</RadioButton>
								<RadioButton x:Name="rbViewGrid" GroupName="grpResultView" 
											 IsCheckedChanged="RbViewMode_IsCheckedChanged" ToolTip.Tip="{DynamicResource TipViewGrid}"
											 Focusable="False" Padding="8,3" CornerRadius="4" FontSize="11">
									<TextBlock Text="{DynamicResource ViewGrid}"/>
								</RadioButton>
							</StackPanel>
						</Border>
					</Grid>
					
					<!-- Content Area: Single Carousel vs Gallery Grid -->
					<Panel Grid.Row="1">
						<!-- Empty State: No Detections -->
						<Border x:Name="pnlNoDetectionsState" Background="{DynamicResource AppEmptyStateBrush}" CornerRadius="6" Margin="10" IsVisible="False">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="20">
								<TextBlock Text="🔍" FontSize="44" HorizontalAlignment="Center" Opacity="0.8"/>
								<TextBlock Text="No Photos Detected" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
								<TextBlock Text="Try lowering the Minimum Size slider or clicking Auto-Tune to find photos." FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/>
							</StackPanel>
						</Border>
						<!-- 1. Single Photo Carousel View -->
						<Grid x:Name="pnlCarouselView" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
							<Button Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0"
									Click="BtnPreviousCroppedImage_Click" ToolTip.Tip="Previous Crop (Left Arrow / ←)"
									Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Width="40" Height="80" CornerRadius="4" Focusable="False" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
								<TextBlock Text="◀" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Button>

							<Carousel Grid.Column="1" x:Name="slides" SelectionChanged="Slides_SelectionChanged" Focusable="False" IsTabStop="False" MaxWidth="1000" MaxHeight="800">

								<Carousel.ItemTemplate>
									<DataTemplate>
										<Border Margin="10" CornerRadius="4" ClipToBounds="True" Background="Transparent">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem Header="{DynamicResource MenuRotateCw}" InputGesture="R" Click="ContextMenu_RotateCw_Click"/>
													<MenuItem Header="{DynamicResource MenuRotateCcw}" Click="ContextMenu_RotateCcw_Click"/>
													<Separator/>
													<MenuItem Header="{DynamicResource MenuRefineCrop}" Click="ContextMenu_Refine_Click"/>
													<MenuItem Header="{DynamicResource MenuExportSingle}" Click="ContextMenu_ExportSingle_Click"/>
													<Separator/>
													<MenuItem Header="{DynamicResource BtnDelete}" InputGesture="Delete" Click="ContextMenu_Delete_Click"/>
												</ContextMenu>
											</Border.ContextMenu>
											<Image Stretch="Uniform" Source="{Binding}" 
												   MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center"/>
										</Border>
									</DataTemplate>
								</Carousel.ItemTemplate>
							</Carousel>
							
							<Button Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0"
									Click="BtnNextCroppedImage_Click" ToolTip.Tip="Next Crop (Right Arrow / →)"
									Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Width="40" Height="80" CornerRadius="4" Focusable="False" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
								<TextBlock Text="▶" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Button>
						</Grid>

						<!-- 2. Gallery Grid View -->
						<ScrollViewer x:Name="scrollGalleryView" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="False" Margin="10">
							<ListBox x:Name="lstGallery" SelectionChanged="LstGallery_SelectionChanged" Background="Transparent" BorderThickness="0" Focusable="False" SelectionMode="Multiple">
								<ListBox.Styles>
									<Style Selector="ListBoxItem">
										<Setter Property="Padding" Value="0"/>
										<Setter Property="Margin" Value="4"/>
										<Setter Property="CornerRadius" Value="8"/>
										<Setter Property="Background" Value="Transparent"/>
									</Style>
									<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
										<Setter Property="Background" Value="Transparent"/>
									</Style>
									<Style Selector="ListBoxItem:selected Border.photoCard">
										<Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
										<Setter Property="BorderThickness" Value="2"/>
										<Setter Property="Background" Value="{DynamicResource AppCardBackgroundSelectedBrush}"/>
									</Style>
									<Style Selector="ListBoxItem:selected Border.selectionBadge">
										<Setter Property="IsVisible" Value="True"/>
									</Style>
								</ListBox.Styles>
								<ListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5"/>
									</ItemsPanelTemplate>
								</ListBox.ItemsPanel>
								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="gui:GalleryPhotoItem">
										<Border Classes="photoCard" Margin="2" Padding="4" Background="{DynamicResource AppPhotoCardBrush}" CornerRadius="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
												Width="200" Height="220">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem Header="{DynamicResource MenuRotateCw}" InputGesture="R" Click="ContextMenu_RotateCw_Click"/>
													<MenuItem Header="{DynamicResource MenuRotateCcw}" Click="ContextMenu_RotateCcw_Click"/>
													<Separator/>
													<MenuItem Header="{DynamicResource MenuRefineCrop}" Click="ContextMenu_Refine_Click"/>
													<MenuItem Header="{DynamicResource MenuExportSingle}" Click="ContextMenu_ExportSingle_Click"/>
													<Separator/>
													<MenuItem Header="{DynamicResource BtnDelete}" InputGesture="Delete" Click="ContextMenu_Delete_Click"/>
												</ContextMenu>
											</Border.ContextMenu>
											<Grid RowDefinitions="*, Auto">
												<Image Grid.Row="0" Stretch="Uniform" Source="{Binding Image}" Margin="4"/>
												<!-- Selection checkmark badge -->
												<Border Grid.Row="0" Classes="selectionBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" 
														Background="{DynamicResource AppAccentBrush}" CornerRadius="10" Width="20" Height="20" IsVisible="False">
													<TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White" 
															   HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
												<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,4,0,0">
													<TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
													<TextBlock Text="{Binding Dimensions}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</ScrollViewer>
					</Panel>

					<!-- Action Buttons (Bottom of Right Panel) -->
					<Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="12,6,12,10">
						<Button Grid.Column="0" x:Name="btnDelete" Click="BtnDelete_Click" Padding="12,8" CornerRadius="6" Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}" BorderThickness="0" Focusable="False" VerticalAlignment="Center" ToolTip.Tip="Delete crop (Del)">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="🗑️" FontSize="13" VerticalAlignment="Center"/>
								<TextBlock x:Name="txtBtnDelete" Text="{DynamicResource BtnDelete}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						
						<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
							<Button x:Name="btnRotate" Click="BtnRotate_Click" Padding="15,10" CornerRadius="20" Background="{DynamicResource AppButtonActionBrush}" Foreground="{DynamicResource AppButtonActionTextBrush}" Focusable="False" ToolTip.Tip="Rotate (R)">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="↻" FontSize="15" VerticalAlignment="Center"/>
									<TextBlock x:Name="txtBtnRotate" Text="{DynamicResource BtnRotate}" FontWeight="Bold" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<Button x:Name="btnReviewPhotos" Click="BtnReviewPhotos_Click" Padding="15,10" CornerRadius="20" Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Focusable="False" ToolTip.Tip="{DynamicResource TipReviewPhotos}">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource BtnReviewPhotos}" FontWeight="Bold" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<Button x:Name="btnRefine" Click="BtnRefine_Click" Padding="15,10" CornerRadius="20" Background="{DynamicResource AppButtonAccentBrush}" Foreground="{DynamicResource AppButtonAccentTextBrush}" ToolTip.Tip="{DynamicResource TipRefine}" Focusable="False">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="✨" FontSize="15" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource BtnRefine}" FontWeight="Bold" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Grid>
				</Grid>
			</Border>
			</Grid>
		</Grid>
		</DockPanel>

		<!-- Review & Fast-Rotate Overlay -->
		<Panel x:Name="pnlReviewOverlay" Background="{DynamicResource AppOverlayScrimBrush}" IsVisible="False" ZIndex="150" PointerWheelChanged="PnlReviewOverlay_PointerWheelChanged" DoubleTapped="PnlReviewOverlay_DoubleTapped">
			<Grid RowDefinitions="Auto, *, Auto" Margin="30,20">
				<!-- Header Bar -->
				<Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="10,0,10,10">
					<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
						<Border Background="{DynamicResource AppAccentBrush}" CornerRadius="6" Padding="8,4">
							<TextBlock Text="🔍" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
						</Border>
						<StackPanel VerticalAlignment="Center" Spacing="2">
							<TextBlock Text="{DynamicResource TitleReviewMode}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
							<TextBlock x:Name="txtReviewScanInfo" Text="" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
						</StackPanel>
					</StackPanel>

					<Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource AppCardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,4">
						<TextBlock x:Name="txtReviewCounter" Text="PHOTO 1 OF 1" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
					</Border>

					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
						<Button x:Name="btnReviewEdit" Click="BtnReviewClose_Click" Padding="12,6" Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Focusable="False" ToolTip.Tip="{DynamicResource TipReviewEdit}">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="&#x270F;&#xFE0F;" FontSize="12" VerticalAlignment="Center"/>
								<TextBlock Text="{DynamicResource BtnReviewEdit}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="btnReviewClose" Click="BtnReviewClose_Click" Padding="12,6" Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Focusable="False" ToolTip.Tip="Close Review (Esc)">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="✕" FontSize="12" VerticalAlignment="Center"/>
								<TextBlock Text="Close" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>

				<!-- Center Photo Preview with Nav Arrows -->
				<Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto">
					<Button Grid.Column="0" x:Name="btnReviewPrev" Click="BtnReviewPrev_Click" VerticalAlignment="Center" Margin="0,0,15,0"
							Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Width="48" Height="96" CornerRadius="8" Focusable="False" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ToolTip.Tip="Previous Photo (← / Left)">
						<TextBlock Text="◀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Button>

					<Panel Grid.Column="1">
						<!-- Normal photo view -->
						<Border x:Name="brdReviewPhoto" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource AppWorkspaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
							<Image x:Name="imgReview" Stretch="Uniform" Margin="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
						</Border>

						<!-- Sentinel: end-of-loop marker — shown when navigating past the last photo -->
						<Border x:Name="pnlReviewSentinel" IsVisible="False" CornerRadius="8"
								Background="{DynamicResource AppWorkspaceBrush}"
								BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2">
							<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
								<Border Background="{DynamicResource AppAccentBrush}" CornerRadius="60" Width="80" Height="80" HorizontalAlignment="Center">
									<TextBlock Text="&#x21BB;" FontSize="40" FontWeight="Bold" Foreground="White"
											   HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<TextBlock x:Name="txtSentinelTitle" Text="{DynamicResource ReviewSentinelTitle}"
										   FontSize="22" FontWeight="Bold"
										   Foreground="{DynamicResource AppTextPrimaryBrush}"
										   HorizontalAlignment="Center" TextAlignment="Center"/>
								<TextBlock x:Name="txtSentinelSubtitle" Text="{DynamicResource ReviewSentinelSubtitle}"
										   FontSize="14" Foreground="{DynamicResource AppTextSecondaryBrush}"
										   HorizontalAlignment="Center" TextAlignment="Center"/>
								<Border Background="{DynamicResource AppCardBackgroundBrush}"
										BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
										CornerRadius="20" Padding="18,8" HorizontalAlignment="Center">
									<TextBlock x:Name="txtSentinelStats" Text=""
											   FontSize="13" Foreground="{DynamicResource AppAccentBrush}"
											   FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
								</Border>
								<TextBlock Text="[&#x2190;] Last Photo  |  [&#x2192;] Back to First"
										   FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}"
										   HorizontalAlignment="Center" TextAlignment="Center"/>
							</StackPanel>
						</Border>
					</Panel>

					<Button Grid.Column="2" x:Name="btnReviewNext" Click="BtnReviewNext_Click" VerticalAlignment="Center" Margin="15,0,0,0"
							Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" Width="48" Height="96" CornerRadius="8" Focusable="False" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ToolTip.Tip="Next Photo (→ / Right / Space)">
						<TextBlock Text="▶" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Button>
				</Grid>

				<!-- Bottom Action Controls -->
				<Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="10,15,10,0">
					<Button Grid.Column="0" x:Name="btnReviewDelete" Click="BtnReviewDelete_Click" Padding="16,10" CornerRadius="8" Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}" Focusable="False" ToolTip.Tip="Delete Photo (Del / X)">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Text="🗑️" FontSize="15" VerticalAlignment="Center"/>
							<TextBlock Text="{DynamicResource BtnDelete}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<!-- Shortcut Tips -->
					<StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock Text="Shortcuts: [R] Rotate 90° CW | [L] Rotate 90° CCW | [←/→/Space] Navigate | [Del/X] Delete | [Esc] Exit" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
					</StackPanel>

					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
						<Button x:Name="btnReviewRotateCcw" Click="BtnReviewRotateCcw_Click" Padding="16,10" CornerRadius="8" Background="{DynamicResource AppSubtleCardBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Focusable="False" ToolTip.Tip="Rotate 90° Counter-Clockwise (L)">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="↺" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
								<TextBlock Text="90° CCW" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button x:Name="btnReviewRotateCw" Click="BtnReviewRotateCw_Click" Padding="18,10" CornerRadius="8" Background="{DynamicResource AppButtonActionBrush}" Foreground="{DynamicResource AppButtonActionTextBrush}" Focusable="False" ToolTip.Tip="Rotate 90° Clockwise (R)">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="↻" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
								<TextBlock Text="{DynamicResource BtnRotate}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Grid>
		</Panel>

		<!-- Refine Overlay -->
		<Panel x:Name="pnlRefineOverlay" Background="{DynamicResource AppOverlayScrimBrush}" IsVisible="False" ZIndex="100">
			<Grid RowDefinitions="*, Auto" Margin="50">
				<Border Grid.Row="0" Margin="20" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource AppWorkspaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
					<Panel x:Name="pnlRefineImage" Background="Transparent"
						   PointerPressed="PnlRefine_PointerPressed"
						   PointerMoved="PnlRefine_PointerMoved"
						   PointerReleased="PnlRefine_PointerReleased">
						<Image x:Name="imgRefine" Stretch="Uniform" Margin="20"
							   VerticalAlignment="Center" HorizontalAlignment="Center"/>
						<Canvas x:Name="cnvRefineCrop" Background="Transparent" IsHitTestVisible="False">
							<Rectangle x:Name="rectRefineCrop" Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="2" Fill="#333399ff" IsVisible="False"/>
						</Canvas>
					</Panel>
				</Border>
				<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30" Margin="20">
					<Button x:Name="btnAcceptRefine" Click="BtnAcceptRefine_Click" Padding="40,15" CornerRadius="8" Background="{DynamicResource AppButtonAccentBrush}" Foreground="{DynamicResource AppButtonAccentTextBrush}" Focusable="False">
						<TextBlock Text="{DynamicResource BtnAccept}" FontSize="18" FontWeight="Bold"/>
					</Button>
					<Button x:Name="btnRejectRefine" Click="BtnRejectRefine_Click" Padding="40,15" CornerRadius="8" Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}" Focusable="False">
						<TextBlock Text="{DynamicResource BtnReject}" FontSize="18" FontWeight="Bold"/>
					</Button>
				</StackPanel>
			</Grid>
		</Panel>
		<!-- Loading Overlay -->
		<Panel x:Name="pnlLoadingOverlay" Background="{DynamicResource AppOverlayScrimBrush}" IsVisible="False" ZIndex="200">
			<Border Background="{DynamicResource AppModalBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="30,25" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320">
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
					<ProgressBar IsIndeterminate="True" Width="240" Height="8" Foreground="{DynamicResource AppAccentBrush}"/>
					<TextBlock x:Name="txtLoadingText" Text="{DynamicResource ProcessingScan}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
					<Button x:Name="btnCancelLoading" Click="BtnCancelLoading_Click" IsVisible="False" Padding="16,6" Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}" CornerRadius="6" HorizontalAlignment="Center" Focusable="False">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Text="✖" FontSize="11"/>
							<TextBlock Text="{DynamicResource BtnCancel}" FontSize="12" FontWeight="SemiBold"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Border>
		</Panel>
		<!-- Error / Alert Modal Overlay -->
		<Panel x:Name="pnlErrorOverlay" Background="{DynamicResource AppOverlayScrimBrush}" IsVisible="False" ZIndex="400">
			<Border Background="{DynamicResource AppModalBackgroundBrush}" BorderBrush="#ff4444" BorderThickness="1" CornerRadius="12" Padding="25" 
					HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="20">
				<StackPanel Spacing="18">
					<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
						<Border Background="{DynamicResource AppDangerBackgroundBrush}" CornerRadius="20" Width="40" Height="40">
							<TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock x:Name="txtErrorTitle" Text="{DynamicResource TitleScannerError}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppDangerTextBrush}" VerticalAlignment="Center"/>
					</StackPanel>

					<TextBlock x:Name="txtErrorMessage" Text="An error occurred while communicating with the scanner." 
							   TextWrapping="Wrap" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13" LineHeight="20"/>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
						<Button x:Name="btnErrorRefresh" Click="BtnErrorRefresh_Click" Padding="16,8" Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" CornerRadius="6" Focusable="False">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="🔄"/>
								<TextBlock Text="{DynamicResource BtnRefreshScanners}"/>
							</StackPanel>
						</Button>
						<Button x:Name="btnCloseError" Click="BtnCloseError_Click" Padding="20,8" Background="{DynamicResource AppAccentBrush}" Foreground="White" CornerRadius="6" FontWeight="SemiBold" Focusable="False">
							<TextBlock Text="{DynamicResource BtnOk}"/>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Panel>

		<!-- Unsaved Changes Confirmation Modal Overlay -->
		<Panel x:Name="pnlUnsavedOverlay" Background="{DynamicResource AppOverlayScrimBrush}" IsVisible="False" ZIndex="500">
			<Border Background="{DynamicResource AppModalBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25" 
					HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" Margin="20">
				<StackPanel Spacing="16">
					<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
						<Border Background="{DynamicResource AppWarningBackgroundBrush}" CornerRadius="20" Width="40" Height="40">
							<TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock Text="{DynamicResource TitleUnsavedChanges}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
					</StackPanel>

					<TextBlock Text="{DynamicResource MsgUnsavedChanges}" 
							   TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" LineHeight="20"/>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
						<Button x:Name="btnCancelExit" Click="BtnCancelExit_Click" Padding="14,8" Background="{DynamicResource AppButtonDefaultBrush}" Foreground="{DynamicResource AppButtonDefaultTextBrush}" CornerRadius="6" Focusable="False">
							<TextBlock Text="{DynamicResource BtnCancel}"/>
						</Button>
						<Button x:Name="btnDiscardAndExit" Click="BtnDiscardAndExit_Click" Padding="14,8" Background="{DynamicResource AppButtonDangerBrush}" Foreground="{DynamicResource AppButtonDangerTextBrush}" CornerRadius="6" Focusable="False">
							<TextBlock Text="{DynamicResource BtnDiscardAndExit}"/>
						</Button>
						<Button x:Name="btnSaveAndExit" Click="BtnSaveAndExit_Click" Padding="18,8" Background="#28a745" Foreground="White" CornerRadius="6" FontWeight="SemiBold" Focusable="False">
							<TextBlock Text="{DynamicResource BtnSaveAndExit}"/>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>
		</Panel>

	</Grid>
</Window>

