<Project Sdk="Microsoft.NET.Sdk">

	<!-- Writes synthetic scans for manual testing and the release smoke tests. Not shipped. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Help.txt" LogicalName="PhotoCropper.SampleScans.Help.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\tests\PhotoCropper.TestHelpers\PhotoCropper.TestHelpers.csproj" />
	</ItemGroup>

</Project>
